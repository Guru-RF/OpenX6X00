#!/usr/bin/env python3
# Wavelog live upload for the GUI and the web server: the QSOs of the radio's logs (<dir>/logs/*.adi,
# the day's logs and the activation logs, every mode) go to the user's Wavelog (github.com/wavelog/wavelog)
# through its API, api/qso. Every command prints one line on stdout, exit 0/1:
#
#   x6100-wavelog sync       the new QSOs into the queue, then the queue to Wavelog:
#                            "off"                           not set up or not enabled
#                            "ok"                            nothing new
#                            "ok <n> <message>"              n QSOs sent (or already in Wavelog)
#                            "retry <n> <message>"           n QSOs wait: no network, server busy, an answer
#                                                            that is not Wavelog's (a WiFi login page)
#                            "error <message>"               refused (key, station profile): fix it on the web page
#   x6100-wavelog stations   "ok <json>": the station profiles of the key, [{"id", "name", "call", "grid", "active"}]
#   x6100-wavelog test       "ok <Wavelog version>"; a read-only key is an error
#
# <dir> is /mnt/field (env X6100_FIELD_DIR). Files there:
#   wavelog.conf    written by the web page: enabled=0|1, url=, key=, station_id=, station_name=, verify_tls=0|1,
#                   since=<unix time>: QSOs from then on are sent, the log from before is not.
#                   station_id=auto: each QSO goes to the station profile with its STATION_CALLSIGN (DF8MH,
#                   DF8MH/P...), the one Wavelog marks active when several have it
#   wavelog.state   JSON: the logs as last read (mtime, size), the QSOs sent (key -> QSO time, under old_key as
#                   well), the revisions sent of each (revs: key -> [rev]), the last result
#   wavelog.queue   JSON: the QSOs waiting, in the order they were logged, with the logs that hold them; it
#                   survives a restart
#   wavelog.failed.adi   QSOs Wavelog refused (a bad record): kept for the user, not sent again unless edited
# A QSO is its other station, date and time to the second, band, mode and own station callsign (qso_key); a QSO
# edited after it was sent is sent again (qso_rev), and when Wavelog keeps the copy it has, the line says so. A QSO
# with no MODE (logged by hand in a data mode the radio could not name) is not sent until it has one.
# stations and test take the URL and key from X6100_WAVELOG_URL / X6100_WAVELOG_KEY / X6100_WAVELOG_VERIFY
# when set (the web page, before Save), else from wavelog.conf. The saved key goes only to the Wavelog it was
# saved with: a URL of another server needs its own key in X6100_WAVELOG_KEY.

import calendar
import fcntl
import hashlib
import json
import os
import re
import signal
import ssl
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

FIELD_DIR = os.environ.get("X6100_FIELD_DIR", "/mnt/field")
LOGS_DIR = os.path.join(FIELD_DIR, "logs")
CONF = os.path.join(FIELD_DIR, "wavelog.conf")
STATE = os.path.join(FIELD_DIR, "wavelog.state")
QUEUE = os.path.join(FIELD_DIR, "wavelog.queue")
FAILED = os.path.join(FIELD_DIR, "wavelog.failed.adi")
LOCK = os.path.join(FIELD_DIR, ".wavelog.lock")
TIMEOUT = 20
RUN_LIMIT = 300      # the GUI waits for one run at a time
KEEP_SENT = 7 * 86400   # a QSO sent is remembered a week; older ones Wavelog itself finds as duplicates
# Wavelog 3.1 and later also make API tokens (wl2_..., API v2), which the API v1 used here refuses as an unknown key
# (401): before, the line said only "key refused" (#73). The web page refuses them at Save; this is for a token
# saved by v0.3.5 or v0.3.6
V2_TOKEN = "the key is an API v2 token (wl2_): make a legacy API key (API v1)"
user_agent = f"OpenX6X00/{os.environ.get('X6100_FW') or 'unknown'} (+https://github.com/Guru-RF/OpenX6X00)"


class Fail(Exception):
    pass


class Retry(Exception):
    pass


def one_line(text, n=80):
    return " ".join(str(text).split())[:n]


def read_conf():
    conf = {}
    try:
        with open(CONF, errors="replace") as f:
            for line in f:
                k, sep, v = line.strip().partition("=")
                if sep:
                    conf[k.strip()] = v.strip()
    except OSError:
        pass
    return conf


def load_json(path, default):
    try:
        with open(path, errors="replace") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
        f.flush()
        os.fsync(f.fileno())
    os.rename(tmp, path)


def api_url(url, path):
    url = url.strip().rstrip("/")
    if not url.endswith("/index.php"):
        url += "/index.php"
    return f"{url}/api/{path}"


def request(url, body, verify):
    """(HTTP code, parsed JSON or None, text); Retry when the server can't be reached"""
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method="POST" if data else "GET",
                                 headers={"User-Agent": user_agent, "Accept": "application/json",
                                          "Content-Type": "application/json"})
    ctx = None if verify else ssl._create_unverified_context()
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT, context=ctx) as r:
            code, text = r.status, r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        code, text = e.code, e.read().decode("utf-8", "replace")
    except (urllib.error.URLError, OSError) as e:   # urllib wraps a refused certificate in a URLError
        why = getattr(e, "reason", e)
        if isinstance(why, ssl.SSLCertVerificationError):
            raise Fail(f"certificate refused ({one_line(why.verify_message or why, 40)})")
        raise Retry(one_line(why or e, 50))
    try:
        parsed = json.loads(text)
    except ValueError:
        parsed = None
    return code, parsed, text


def origin(url):
    """Scheme, host and port of a URL: the server a key is sent to"""
    try:
        u = urllib.parse.urlsplit(url.strip())
        scheme = u.scheme.lower()
        return scheme, (u.hostname or "").lower(), u.port or {"http": 80, "https": 443}.get(scheme)
    except ValueError:   # a port that is not one: equal only to the same text
        return url.strip()


def target(conf):
    """URL, key, verify of the environment (the web page's form) or wavelog.conf. The saved key only with the
    saved URL's server: a URL typed on the page and an empty key sent it to whatever server was typed (audit C08)"""
    url = os.environ.get("X6100_WAVELOG_URL") or conf.get("url", "")
    key = os.environ.get("X6100_WAVELOG_KEY") or conf.get("key", "")
    if key and not os.environ.get("X6100_WAVELOG_KEY") and origin(url) != origin(conf.get("url", "")):
        raise Fail("the saved API key is for another server: type the key for this one")
    verify = os.environ.get("X6100_WAVELOG_VERIFY", conf.get("verify_tls", "1")) != "0"
    if not url or not key:
        raise Fail("URL and API key needed")
    if key.lower().startswith("wl2_"):
        raise Fail(V2_TOKEN)
    return url, key, verify


def key_rights(url, key, verify):
    """"rw" or "r", as api/auth (Cloudlog's and Wavelog's first call, in every version) says; "" when it can't tell"""
    try:
        code, _, text = request(api_url(url, "auth/" + urllib.parse.quote(key, safe="")), None, verify)
    except (Retry, Fail):
        return ""
    m = re.search(r"<rights>\s*(\w+)\s*</rights>", text) if code == 200 else None
    return m.group(1).lower() if m else ""


def cmd_test(conf):
    """Wavelog's version for the key, which api/version gives a read-only key too: one of those passed the test,
    and then every QSO was refused, "API key does not have write permissions" (#73)"""
    url, key, verify = target(conf)
    try:
        code, j, text = request(api_url(url, "version"), {"key": key}, verify)
    except Retry as e:
        raise Fail(f"no connection: {e}")
    if not (code == 200 and isinstance(j, dict) and j.get("status") == "ok"):
        raise Fail(refusal(code, j, text))
    version = one_line(j.get('version', '?'), 20)
    if key_rights(url, key, verify) == "r":
        raise Fail(f"the key is read-only (Wavelog {version}): the upload needs a read & write key")
    return f"ok {version}"


def stations(url, key, verify):
    """The station profiles of the key; Retry when Wavelog can't be reached"""
    code, j, text = request(api_url(url, "station_info/" + key), None, verify)
    if code != 200 or not isinstance(j, list):
        raise Fail(refusal(code, j, text))
    return [{"id": str(s.get("station_id", "")), "name": str(s.get("station_profile_name", "")),
             "call": str(s.get("station_callsign", "")), "grid": str(s.get("station_gridsquare", "")),
             "active": str(s.get("station_active") or "") == "1"} for s in j if isinstance(s, dict)]


def cmd_stations(conf):
    url, key, verify = target(conf)
    try:
        out = stations(url, key, verify)
    except Retry as e:
        raise Fail(f"no connection: {e}")
    return "ok " + json.dumps(out, separators=(",", ":"))


def profile_for(call, profiles):
    """The station profile of a callsign: the one Wavelog marks active when several have it"""
    found = [p for p in profiles if p["call"].strip().upper() == call]
    found.sort(key=lambda p: not p["active"])
    return found[0]["id"] if found else None


def refusal(code, j, text):
    msg = (j.get("message") or j.get("reason")) if isinstance(j, dict) else None
    if code in (401, 403):
        return f"key refused (HTTP {code})"
    return f"HTTP {code} {one_line(msg or text, 50)}".strip()


# The logs

FIELD_RE = re.compile(rb"<(\w+):(\d+)(?::\w)?>", re.I)


def adif_records(data):
    """The records of a log read as bytes: an ADIF length counts bytes (flog.c), "Jürgen" is 7"""
    m = re.search(rb"<eoh>", data, re.I)
    if m:
        data = data[m.end():]
    parts = re.split(rb"<eor>", data, flags=re.I)[:-1]   # what follows the last <eor> is not a record yet
    return [p.strip() for p in parts if re.search(rb"<call:\d+", p, re.I)]


def adif_fields(rec):
    """The fields of a record, bytes or text, counted in bytes"""
    b = rec.encode() if isinstance(rec, str) else rec
    out, i = {}, 0
    for m in FIELD_RE.finditer(b):
        if m.start() < i:
            continue
        n = int(m.group(2))
        out[m.group(1).decode().lower()] = b[m.end():m.end() + n].decode("utf-8", "replace")
        i = m.end() + n
    return out


def qso_time(f):
    d, t = f.get("qso_date", ""), (f.get("time_on", "") + "00")[:6]
    try:
        return calendar.timegm(time.strptime(d + t, "%Y%m%d%H%M%S"))
    except ValueError:
        return 0


def qso_key(f):
    """The same QSO in two reads of a log, or in two logs: the other station, the date and the time to the second,
    band, mode, and the own station callsign that also picks the profile with Automatic. Without the seconds and
    the station, a second QSO in the same minute, as ON6URE/P after one as ON6URE, was taken for the first and
    never sent (audit C11)"""
    mode = f.get("submode") or f.get("mode", "")
    me = f.get("station_callsign") or f.get("operator", "")
    return "|".join(x.strip().upper() for x in (f.get("call", ""), f.get("qso_date", ""),
                                                (f.get("time_on", "") + "00")[:6], f.get("band", ""), mode, me))


def qso_rev(f):
    """What the QSO holds, whatever the order and spacing of its fields: a report, name or reference corrected on
    the Logs page is a new revision of the same QSO, which was not sent again before (audit C11)"""
    return hashlib.sha1(json.dumps(sorted(f.items())).encode()).hexdigest()[:12]


def old_key(f):
    """The key the helper of v0.3.5 and v0.3.6 kept a QSO sent under, in "sent" as key -> QSO time. What it sent
    is not sent again here; and as it runs again on this state after Update > Roll back, each QSO sent here is in
    "sent" under its old key too (old_of), as a QSO time: that helper neither stops at the state (a TypeError at
    every run, "sent" never saved) nor sends again the QSOs this one sent. The revisions are in "revs", which it
    leaves as they are"""
    mode = f.get("submode") or f.get("mode", "")
    return "|".join(x.upper() for x in (f.get("call", ""), f.get("qso_date", ""), f.get("time_on", "")[:4],
                                        f.get("band", ""), mode))


def old_of(key):
    """The old_key of the QSO with this qso_key"""
    p = key.split("|")
    return "|".join(p[:2] + [p[2][:4]] + p[3:5])


def mark_sent(state, q):
    """q sent (or refused): not sent again as it stands, nor as any log holds it now (two copies of the QSO that
    differ, in two logs, went as one)"""
    state["sent"][q["key"]] = state["sent"][old_of(q["key"])] = q["t"]
    revs = state["revs"].setdefault(q["key"], [])
    revs.extend(r for r in dict.fromkeys([q["rev"], *q.get("logs", {}).values()]) if r not in revs)


def collect(state, queue, since):
    """The QSOs logged since `since` into the queue: a new one, or one changed since it was sent ("fix"). One that
    waits goes as it stands at the run, and not at all when no log holds it any more (deleted, or its call or time
    corrected meanwhile) or each log holds it as it was sent (an edit undone). The logs that did not change since
    the last run are not read again"""
    files = state.setdefault("files", {})
    sent = state.setdefault("sent", {})
    revs = state.setdefault("revs", {})
    ours = {old_of(k) for k in revs}   # the old keys written here: the others are of the helper before
    for q in queue:   # left waiting by the helper before the update
        if "rev" not in q:
            f = adif_fields(q["adif"])
            q["key"], q["rev"] = qso_key(f), qso_rev(f)
    waiting = {q["key"]: q for q in queue}
    now = time.time()
    try:
        names = sorted(n for n in os.listdir(LOGS_DIR) if n.endswith(".adi"))
    except OSError:
        return
    for name in names:
        path = os.path.join(LOGS_DIR, name)
        try:
            st = os.stat(path)
            stamp = [int(st.st_mtime), st.st_size]
            if files.get(name) == stamp or st.st_mtime < since:
                continue
            with open(path, "rb") as fh:
                data = fh.read()
        except OSError:
            continue
        found, held = [], set()
        for rec in adif_records(data):
            f = adif_fields(rec)
            t, key, rev = qso_time(f), qso_key(f), qso_rev(f)
            held.add(key)
            if t < since:
                continue
            # Logged without a mode (USB-D with no app open, away from FT8 and FT4: #92): it waits on the radio. Sent
            # so, it would be a QSO with no mode in Wavelog, and once the Logs page gives it one, a second QSO there
            if not (f.get("mode") or f.get("submode") or "").strip():
                continue
            adif = rec.decode("utf-8", "replace") + "<eor>"
            q = waiting.get(key)
            if q:   # as this log holds it now; what goes is a copy not sent yet
                q.setdefault("logs", {})[name] = rev
                if rev not in revs.get(key, ()):
                    q.update(adif=adif, rev=rev)
                continue
            old = old_key(f)
            if key not in revs and (key in sent or old in sent and old not in ours):
                revs[key], sent[key], sent[old_of(key)] = [rev], t, t   # sent by the helper before the update
                ours.add(old_of(key))                                  # (or after a roll back), as it stands
            done = revs.get(key)
            if done and rev in done:
                continue
            q = {"key": key, "rev": rev, "call": f.get("call", "").upper(), "t": t, "adif": adif, "logs": {name: rev}}
            if done:
                q["fix"] = True
            found.append((t, q))
            waiting[key] = q
        for q in queue:   # waiting, and this log holds it no more: deleted, or its call or time corrected
            if name in q.get("logs", ()) and q["key"] not in held:
                del q["logs"][name]
        queue.extend(q for _, q in sorted(found, key=lambda x: x[0]))
        # FAT keeps a file's time in 2 s steps: a log changed again within them to the same size (a report
        # corrected, 59 to 57) has the same stamp, so one this recent is read again at the next run
        if now - st.st_mtime >= 2:
            files[name] = stamp
        else:
            files.pop(name, None)
    for name in list(files):   # deleted logs
        if name not in names:
            del files[name]
    # A QSO waits while a log holds it in a form not sent yet: deleted, its call or time corrected (no log holds it
    # now), or edited back to what was sent, it does not go. One the helper before queued, in no log read since, goes
    queue[:] = [q for q in queue if "logs" not in q
                or any(r not in revs.get(q["key"], ()) for r in q["logs"].values())]


def send(conf, rec, station_id):
    """'ok', 'dupe', 'reject <why>'; Retry or Fail for what stops the whole run. Wavelog answers 201 "created"
    for a QSO it took and 400 "abort" for one it didn't, the reason in "messages" (a duplicate among them)"""
    body = {"key": conf["key"], "station_profile_id": station_id, "type": "adif", "string": rec}
    code, j, text = request(api_url(conf["url"], "qso"), body, conf.get("verify_tls", "1") != "0")
    if not isinstance(j, dict) or "status" not in j:   # not Wavelog: a WiFi login page, a proxy's page
        raise Retry(f"not Wavelog's answer (HTTP {code})")
    status = str(j["status"]).lower()
    msgs = j.get("messages") if isinstance(j.get("messages"), list) else []
    full = re.sub(r"<br\s*/?>", " ", " ".join(map(str, msgs))).strip() or str(j.get("reason") or j.get("message") or "")
    why = one_line(full, 60)
    if code == 201 and status == "created":
        return "ok"
    if code in (408, 429) or code >= 500:
        raise Retry(f"server HTTP {code}")
    if code in (401, 403):   # the key, or a station profile that is not the key's
        raise Fail(why or f"key refused (HTTP {code})")
    if code == 400 and status == "abort":
        return "dupe" if "duplicate" in full.lower() else f"reject {why}"
    raise Fail(f"HTTP {code} {why}".strip())   # anything else (a wrong URL): stop, the QSOs wait

def qsos(n):
    return f"{n} QSO{'' if n == 1 else 's'}"


def cmd_sync(conf):
    if conf.get("enabled") != "1" or not (conf.get("url") and conf.get("key") and conf.get("station_id")):
        return "off"
    os.makedirs(FIELD_DIR, exist_ok=True)
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)   # the GUI and the web page's Send now: one run at a time
        state = load_json(STATE, {})
        queue = load_json(QUEUE, [])
        since = int(conf.get("since") or 0) or int(time.time())
        collect(state, queue, since)
        save_json(QUEUE, queue)
        save_json(STATE, state)
        ok, dupe, bad, last, nobody, kept = 0, 0, [], "", [], []
        auto = conf["station_id"] == "auto"
        profiles = None   # auto: read from Wavelog once a run, when a QSO waits
        try:
            if conf["key"].lower().startswith("wl2_"):   # the QSOs wait for a key
                raise Fail(V2_TOKEN)
            i = 0
            while i < len(queue):
                q = queue[i]
                station_id = conf["station_id"]
                if auto:
                    f = adif_fields(q["adif"])
                    call = (f.get("station_callsign") or f.get("operator") or "").strip().upper()
                    if profiles is None and call:
                        profiles = stations(conf["url"], conf["key"], conf.get("verify_tls", "1") != "0")
                    station_id = profile_for(call, profiles) if call else None
                    if not station_id:   # it waits for a profile made in Wavelog; the others still go
                        nobody.append(call or f"{q['call']} (no station callsign)")
                        i += 1
                        continue
                res = send(conf, q["adif"], station_id)
                if res.startswith("reject"):
                    bad.append(f"{q['call']}: {res[7:]}")
                    with open(FAILED, "a") as fh:
                        fh.write(q["adif"] + "\n")
                else:
                    ok, dupe, last = ok + (res == "ok"), dupe + (res == "dupe"), q["call"]
                    if res == "dupe" and q.get("fix"):   # api/qso adds QSOs, it changes none Wavelog has
                        kept.append(q["call"])
                mark_sent(state, q)
                queue.pop(i)
                save_json(QUEUE, queue)
            n = ok + dupe
            said = ", ".join(([f"{qsos(ok)} uploaded"] if ok else []) + ([f"{qsos(dupe)} already there"] if dupe else []))
            result = ("ok " + (f"{n} Wavelog: {last} uploaded" if n == 1 and ok
                               else f"{n} Wavelog: {last} was already there" if n == 1
                               else f"{n} Wavelog: {said}") if n else "ok")
            if kept:
                result += ", edit it in Wavelog too" if n == 1 else \
                    f", edit {kept[0]} in Wavelog too" + (f" (+{len(kept) - 1} more)" if len(kept) > 1 else "")
            if bad:
                result = f"error Wavelog refused {bad[0]}" + (f" (+{len(bad) - 1} more)" if len(bad) > 1 else "")
            elif nobody:
                done = f"{last} uploaded, " if n == 1 and ok else f"{said}, " if n else ""
                result = f"error Wavelog: {done}no station profile for {nobody[0]}, {qsos(len(queue))} waiting"
        except Retry as e:   # the display says why in short; the web page has the last result
            why = str(e) if str(e).startswith(("server", "not Wavelog")) else "no connection"
            result = f"retry {len(queue)} Wavelog: {why}, {qsos(len(queue))} waiting"
        except Fail as e:
            result = f"error Wavelog: {e}, {qsos(len(queue))} waiting"
        now = time.time()
        state["sent"] = {k: t for k, t in state["sent"].items() if t > now - KEEP_SENT}
        state["revs"] = {k: r for k, r in state["revs"].items() if k in state["sent"]}
        state["last"] = {"time": int(now), "result": result, "queue": len(queue)}
        save_json(QUEUE, queue)
        save_json(STATE, state)
        return result


def main(argv):
    cmds = {"sync": cmd_sync, "stations": cmd_stations, "test": cmd_test}
    if len(argv) != 1 or argv[0] not in cmds:
        print("error usage: x6100-wavelog sync|stations|test")
        return 1
    try:
        signal.signal(signal.SIGALRM, lambda *_: (print("error timed out"), sys.exit(1)))
        signal.alarm(RUN_LIMIT)
        result = cmds[argv[0]](read_conf())
        print(result)
        return 0 if result.split()[0] in ("ok", "off") else 1
    except Fail as e:
        print(f"error {e}")
    except Exception as e:
        print(f"error {one_line(e) or type(e).__name__}")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
