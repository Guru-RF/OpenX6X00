#!/bin/sh
# Runs the GUI in a loop: a killed or crashed GUI comes back at once. Before each start the
# updater looks at a version installed and not yet confirmed (x6100-update boot-check): one
# that keeps dying is rolled back to the previous files.
#
# PulseAudio carries the radio's audio. The GUI exits with code 3 when it cannot reach it or it
# goes away (audio.c): that start is not the GUI's fault and is not counted against a pending
# update; PulseAudio is started again first, then the GUI.
PULSE_INIT=/etc/init.d/S50pulseaudio
PULSE_PID=/var/run/pulse/pid

pulse_up() {
    pidof pulseaudio > /dev/null
}

# PulseAudio running, or started again: a dead daemon's pid file is cleared first, or the new
# one refuses to start when that pid lives on in another process
pulse_ensure() {
    pulse_up && return 0
    logger -t x6100_daemon "PulseAudio is not running: starting it" 2> /dev/null
    rm -f "$PULSE_PID"
    "$PULSE_INIT" start > /dev/null 2>&1
    for _ in $(seq 1 20); do
        pulse_up && [ -S /var/run/pulse/native ] && return 0
        sleep 0.5
    done
    logger -t x6100_daemon "PulseAudio did not come up" 2> /dev/null
    return 1
}

mkdir -p /mnt/app_logs/
# The newest 50 run logs are kept (one per restart and, since v0.3.4, one per power-off)
ls -t /mnt/app_logs/x6100_log_*.txt 2>/dev/null | tail -n +51 | while read -r f; do rm -f "$f"; done
cp -R /usr/share/x6100/images /dev/shm/
code=0
while true; do
    pulse_ensure
    [ "$code" -eq 3 ] || /usr/sbin/x6100-update boot-check > /dev/null 2>&1
    /usr/sbin/x6100_gui > /tmp/x6100_log.txt 2>&1
    code=$?
    [ "$code" -eq 0 ] || sync
    mv /tmp/x6100_log.txt /mnt/app_logs/x6100_log_$(date +%Y-%m-%d_%H-%M-%S).txt
    [ "$code" -eq 3 ] && sleep 1    # PulseAudio gone: a breath before it is started again
done
