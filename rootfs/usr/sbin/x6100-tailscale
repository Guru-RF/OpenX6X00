#!/usr/bin/env python3
# OpenX6X00 - Tailscale: the radio on its owner's tailnet, so a laptop or a phone running Tailscale
# reaches its web pages, the browser Panel and Remote and the TCI server from anywhere, with no port
# opened on the router. Tailscale's own build for 32-bit ARM, the version pinned below with its SHA-256,
# is downloaded once (37 MB) when Tailscale is turned on. It runs in userspace mode: the kernel has no
# TUN device, and tailscaled hands each incoming connection to the radio's own port on 127.0.0.1. Its log
# upload to Tailscale is off (--no-logs-no-support), as is its DNS: the radio only answers.
#
#   x6100-tailscale            at boot (S97tailscale): start it when it is on
#   x6100-tailscale on         turn it on: download once, start, ask for a login
#   x6100-tailscale off        turn it off; the login is kept
#   x6100-tailscale logout     forget the login (while it is on, a new one is asked for)
#   x6100-tailscale hostname   give Tailscale the radio's network name (x6100-hostname calls it)
#   x6100-tailscale funnel on|off   the browser Panel on the internet through Tailscale Funnel, or not
#   x6100-tailscale funnel-clear [s]   Funnel off and out of tailscaled, waited for (x6100-update, before it goes
#                              back to a version without Funnel): "ok ..." when sure, an error when not
#   x6100-tailscale status     the state as key=value lines: state, text, url, name, ip, version, and
#                              funnel (off, starting, enable, on, error), funnel_text, funnel_url, public
#   x6100-tailscale run        the supervisor itself, started by the commands above
#
# The program lives on the DATA partition, which the web pages can write (Backup restore), so its SHA-256
# is checked before every start. The login (the node key) lives on the root filesystem, where the web
# pages cannot read it: a new card image asks for a new login. Files a tailnet peer sends with Taildrop
# land in a 1 MB tmpfs, so they never fill the root filesystem: the radio has no use for them.
#
# On and off only change the setting: the supervisor follows it within a poll, also during the download,
# and a supervisor that stops while the setting is back on starts the next one. SIGTERM (S97tailscale
# stop, at shutdown) stops it and keeps the setting.
#
# Funnel (#58) puts https://<name>.<tailnet>.ts.net/panel on the internet: the Panel and the Screen page,
# which the web server writes to FUNNEL_DIR at its start and when the name in STATUS changes, and tailscaled
# serves itself (no Python on the internet), and their two sockets, which take nothing over Funnel before
# the token of a browser paired at home. Nothing else: the web pages, TCI programs, Pat, SSH. It is set
# through tailscaled's local API, as Tailscale's own command does (that command is not installed), and kept
# in tailscaled's state while Tailscale runs: at every start, when the name or a port changes, and once a
# minute it is set again. Stopping tailscaled (off, the shutdown, a start that failed) takes it out first,
# so a stopped Tailscale keeps no funnel in its state for a version without Funnel to start with; the
# setting stays, and the next start sets it again.
# The radio owns Funnel: a funnel made by hand (tailscale funnel 50001, from a forum) is taken off the
# internet; serving to the tailnet alone stays. While Funnel is on, port 443 on the tailnet is its own: the
# Panel there has a real certificate, the configurator stays on http://<name>/.
#
# SPDX-License-Identifier: LGPL-2.1-or-later
# Copyright (c) 2026 Joeri Van Dooren ON6URE / Guru-RF
import base64
import fcntl
import hashlib
import http.client
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.parse
import urllib.request

VERSION = "1.104.2"
TGZ_URL = f"https://pkgs.tailscale.com/stable/tailscale_{VERSION}_arm.tgz"
TGZ_SHA256 = "b694ff9c67235da98798b9592a0cc900bc9d1613041f77722ec9bf4ce2d215cf"
BIN_SHA256 = "9404866023e64385091fe5e9faebe88f9051f035b26785b656c410f174e5eb25"    # tailscaled in it

CONF = "/mnt/tailscale.conf"          # enabled=0|1, funnel=0|1: on the DATA partition, it survives a new image
DIR = "/mnt/tailscale"                # the program (and the download while it runs)
BIN = os.path.join(DIR, "tailscaled")
STATE = "/var/lib/tailscale"          # the login: root filesystem only
STATE_FILE = os.path.join(STATE, "tailscaled.state")    # tailscaled's own (--statedir): the serve config too
DROP = os.path.join(STATE, "files")   # Taildrop's inbox: a tmpfs of TS_DROP_KB on it
RUN = "/run/tailscale"                # socket, status, lock, log
SOCK = os.path.join(RUN, "tailscaled.sock")
STATUS = os.path.join(RUN, "status")
LOCK = os.path.join(RUN, "lock")
LOG = os.path.join(RUN, "tailscaled.log")
LOG_MAX = 512 * 1024
PORT = 41641                          # WireGuard's UDP port: a fixed one helps a router keep the path open
POLL = 2                              # s between status reads
RETRY = 60                            # s before a failed download or start is tried again
UP_WAIT = 30                          # s for a new tailscaled to answer on its socket
DROP_KB = 1024

# Funnel (#58): the pages the web server writes (x6100_webserver funnel_render), served by tailscaled
FUNNEL_DIR = "/run/x6100-funnel"
FUNNEL_FILES = ("favicon.ico", "css/base.css", "css/siimple-icons.css", "js/jquery-3.7.1.min.js",
                "js/radio_link.js", "js/radio_session.js")
FUNNEL_PORT = 443                     # one origin for the tailnet and the internet; 443 gets through most networks
REMOTE_CONF = "/mnt/remote.conf"      # the browser remote's port= (src/remote_server.c), 50002
TCI_CONF = "/mnt/tci.conf"            # TCI's port= (src/tci_server.c), 50001
FUNNEL_CHECK = 60                     # s between looks at the serve config while nothing changed
FUNNEL_ASK = 300                      # s between asks for the link that enables Funnel on the tailnet
FUNNEL_CLEAR_WAIT = 30                # s funnel-clear waits at most to be sure no funnel is left


class Stopped(Exception):
    """Turned off, or SIGTERM: whatever runs gives up"""


_stop = []                            # SIGTERM seen (shutdown): stop, keep the setting


def stopping():
    return bool(_stop) or not enabled()


class Fail(Exception):
    pass


def conf_read():
    """The settings as key: value; lines of other keys are kept as they are when one is written"""
    conf = {}
    try:
        with open(CONF) as f:
            for line in f:
                k, sep, v = line.strip().partition("=")
                if sep:
                    conf[k] = v
    except OSError:
        pass
    return conf


def conf_write(**changes):
    conf = conf_read()
    conf.update({k: str(v) for k, v in changes.items()})
    tmp = f"{CONF}.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write("".join(f"{k}={v}\n" for k, v in conf.items()))
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, CONF)


def enabled():
    return conf_read().get("enabled") == "1"


def funnel_wanted():
    return conf_read().get("funnel") == "1"


def set_enabled(on):
    conf_write(enabled=1 if on else 0)


def network_name():
    try:
        return subprocess.run(["/usr/sbin/x6100-hostname", "get"], capture_output=True, text=True,
                              timeout=10).stdout.strip() or "x6100"
    except (OSError, subprocess.SubprocessError):
        return "x6100"


def say(state, text, **kw):
    """The status file the GUI and the web page read: written when it changes (the file, not a copy
    in memory: a command may have written it meanwhile)"""
    fields = {"state": state, "text": text, "version": VERSION, **kw}
    body = "".join(f"{k}={str(v).replace(chr(10), ' ')}\n" for k, v in fields.items() if v is not None)
    try:
        with open(STATUS) as f:
            if f.read() == body:
                return
    except OSError:
        pass
    os.makedirs(RUN, exist_ok=True)
    tmp = f"{STATUS}.{os.getpid()}"                # each writer its own: commands and the supervisor overlap
    with open(tmp, "w") as f:
        f.write(body)
    os.replace(tmp, STATUS)


# ---- the program -----------------------------------------------------------------------------

def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def have_program():
    try:
        return sha256(BIN) == BIN_SHA256
    except OSError:
        return False


def remove(path):
    try:
        os.remove(path)
    except FileNotFoundError:
        pass


def download():
    """Tailscale's tarball, checked against the pinned SHA-256, and tailscaled out of it"""
    os.makedirs(DIR, exist_ok=True)
    part = os.path.join(DIR, "download.part")
    tmp = os.path.join(DIR, "unpack")
    # What an interrupted try left (a lost link, the power gone) is not counted against the room needed
    remove(part)
    shutil.rmtree(tmp, ignore_errors=True)
    if shutil.disk_usage(DIR).free < 120 * 1024 * 1024:
        raise Fail("not enough room on the card (120 MB needed)")
    h = hashlib.sha256()
    got = 0
    req = urllib.request.Request(TGZ_URL, headers={"User-Agent": "OpenX6X00"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r, open(part, "wb") as f:
            total = int(r.headers.get("Content-Length") or 0)
            shown = -1
            while True:
                if stopping():
                    raise Stopped()
                chunk = r.read(65536)
                if not chunk:
                    break
                f.write(chunk)
                h.update(chunk)
                got += len(chunk)
                pct = got * 100 // total if total else 0
                if pct != shown:
                    say("download", f"Downloading Tailscale: {pct} %", pct=pct)
                    shown = pct
    except Stopped:
        os.remove(part)
        raise
    except OSError as e:
        remove(part)
        raise Fail(f"download failed: {getattr(e, 'reason', e)}")
    if h.hexdigest() != TGZ_SHA256:
        os.remove(part)
        raise Fail("the download does not match its checksum")
    # BusyBox: no tar -z, and this Python has no zlib
    os.makedirs(tmp)
    member = f"tailscale_{VERSION}_arm/tailscaled"
    r = subprocess.run(f"gunzip -c '{part}' | tar x -C '{tmp}' '{member}'", shell=True, capture_output=True,
                       text=True)
    os.remove(part)
    src = os.path.join(tmp, member)
    if r.returncode != 0 or not os.path.isfile(src) or sha256(src) != BIN_SHA256:
        shutil.rmtree(tmp, ignore_errors=True)
        raise Fail("tailscaled could not be unpacked")
    os.chmod(src, 0o755)
    os.replace(src, BIN)
    shutil.rmtree(tmp, ignore_errors=True)


# ---- tailscaled's local API ------------------------------------------------------------------

class _Conn(http.client.HTTPConnection):
    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.settimeout(self.timeout)
        self.sock.connect(SOCK)


class HttpFail(Fail):
    def __init__(self, text, status):
        super().__init__(text)
        self.status = status


def api_full(method, path, body=None, headers=None):
    """(answer, its headers): the answer's JSON, None when empty"""
    c = _Conn("local-tailscaled.sock", timeout=10)
    hdr = {"Sec-Tailscale": "localapi", **(headers or {})}
    data = None
    if body is not None:
        data = json.dumps(body)
        hdr["Content-Type"] = "application/json"
    try:
        c.request(method, "/localapi/v0/" + path, body=data, headers=hdr)
        r = c.getresponse()
        out = r.read()
    except http.client.HTTPException as e:   # neither OSError nor ValueError: an answer cut off (tailscaled stopping)
        raise Fail(f"tailscaled: {path.split('?')[0]}: its answer broke off ({type(e).__name__})")
    finally:
        c.close()
    if r.status >= 300:
        raise HttpFail(f"tailscaled: {path.split('?')[0]}: HTTP {r.status} {out[:160].decode(errors='replace').strip()}",
                       r.status)
    return (json.loads(out) if out else None), r.headers


def api(method, path, body=None):
    return api_full(method, path, body)[0]


def set_prefs(hostname=None):
    """Running, under the radio's name, no DNS and no routes of others: the radio only answers"""
    prefs = {"WantRunning": True, "WantRunningSet": True, "CorpDNS": False, "CorpDNSSet": True,
             "RouteAll": False, "RouteAllSet": True}
    if hostname:
        prefs.update({"Hostname": hostname, "HostnameSet": True})
    api("PATCH", "prefs", prefs)


# ---- Funnel (#58) ------------------------------------------------------------------------------

def conf_port(path, default):
    """port= of the browser remote's or TCI's settings file"""
    try:
        with open(path) as f:
            for line in f:
                k, sep, v = line.strip().partition("=")
                if sep and k == "port" and v.isdigit() and 0 < int(v) < 65536:
                    return int(v)
    except OSError:
        pass
    return default


def funnel_handlers(remote_port, tci_port):
    """What goes on the internet, path by path: the two pages and the files they load, served by tailscaled from
    FUNNEL_DIR, and their two sockets. Every other path walks up to "/" and is sent to the Panel: nothing reaches
    the web server, TCI's port for programs, Pat or SSH"""
    h = {"/": {"Redirect": "/panel"},
         "/panel": {"Path": f"{FUNNEL_DIR}/panel.html"},
         "/remote": {"Path": f"{FUNNEL_DIR}/remote.html"},
         "/ws/remote": {"Proxy": f"http://127.0.0.1:{remote_port}"},
         "/ws/tci": {"Proxy": f"http://127.0.0.1:{tci_port}"}}
    for name in FUNNEL_FILES:   # each file on its own: a folder would list its contents
        h["/static/" + name] = {"Path": f"{FUNNEL_DIR}/static/{name}"}
    return h


def ours(web):
    """A web server of the serve config is the radio's own (made by funnel_config, under any name and ports)"""
    h = (web or {}).get("Handlers") or {}
    return (h.get("/panel") or {}).get("Path") == f"{FUNNEL_DIR}/panel.html"


def funnel_config(cur, name, remote_port, tci_port, on):
    """The serve config to set, from the current one: the radio's own web server on <name>:443 while on, and
    no other funnel anywhere (AllowFunnel, a foreground session's too). What is served to the tailnet alone
    stays, but port 443 is the Panel's while Funnel is on. Returns (config, funnels made by hand removed)"""
    sc = json.loads(json.dumps(cur or {}))
    hp = f"{name}:{FUNNEL_PORT}"
    # the radio's own funnel, turned off or under an older name, was not made by hand
    mine = {k for k, v in (sc.get("Web") or {}).items() if ours(v)}
    theirs = [k for k, v in (sc.get("AllowFunnel") or {}).items() if v and k not in mine and not (on and k == hp)]
    for fg in (sc.get("Foreground") or {}).values():
        theirs += [k for k, v in (fg.get("AllowFunnel") or {}).items() if v]
        fg.pop("AllowFunnel", None)
    sc["AllowFunnel"] = {hp: True} if on else {}
    web = sc.get("Web") or {}
    for k in [k for k, v in web.items() if ours(v)]:
        del web[k]
    tcp = sc.get("TCP") or {}
    port = str(FUNNEL_PORT)
    if on:
        web[hp] = {"Handlers": funnel_handlers(remote_port, tci_port)}
        tcp[port] = {"HTTPS": True}
    elif tcp.get(port) == {"HTTPS": True} and not any(k.endswith(f":{port}") for k in web):
        del tcp[port]
    sc["Web"], sc["TCP"] = web, tcp
    for k in ("AllowFunnel", "Web", "TCP", "Foreground"):
        if not sc.get(k):
            sc.pop(k, None)
    return sc, theirs


def caps_ok(me):
    """The tailnet lets this machine funnel on FUNNEL_PORT: HTTPS certificates, the funnel attribute and the port in
    funnel-ports (ipn.CheckFunnelAccess)"""
    caps = me.get("CapMap") or {}
    if "https" not in caps or "funnel" not in caps:
        return False
    for attr in caps:
        if attr.startswith("https://tailscale.com/cap/funnel-ports?"):
            for part in urllib.parse.parse_qs(urllib.parse.urlsplit(attr).query).get("ports", [""])[0].split(","):
                first, _, last = part.partition("-")
                if first.isdigit() and int(first) <= FUNNEL_PORT <= int(last or first):
                    return True
    return False


class Funnel:
    """What the supervisor made of Funnel: set again when the wish, the name or a port changed, and every
    FUNNEL_CHECK s (a serve config changed by hand, or tailscaled's state lost)"""

    def __init__(self):
        self.key = None
        self.done = 0.0         # when the serve config was last looked at
        self.asked = 0.0        # when the enable link was last asked for
        self.url = ""
        self.text = ""
        self.status = {"funnel": "off"}


def funnels_off(cur, etag, name, remote_port, tci_port):
    """The radio's own config refused while Funnel is on (port 443 held by a "tailscale funnel" left running in the
    foreground over SSH, say): no funnel made by hand stays on the internet meanwhile. The radio's own goes with
    them until the next poll sets it again"""
    off, theirs = funnel_config(cur, name, remote_port, tci_port, False)
    if theirs:
        try:
            api_full("POST", "serve-config", off, {"If-Match": etag})
        except (Fail, OSError, ValueError):
            pass


def serve_set(name, remote_port, tci_port, on):
    """The serve config made right, at most two tries when someone else changed it in between (If-Match).
    Returns the funnels made by hand that were removed"""
    for _ in range(3):
        cur, hdr = api_full("GET", "serve-config")
        etag = hdr.get("Etag", "")
        new, theirs = funnel_config(cur, name, remote_port, tci_port, on)
        if new == (cur or {}):
            return theirs
        # A port's serve type cannot change in one step (tailscaled's validateServeConfigUpdate): a raw TCP
        # forward made by hand on 443 is dropped first
        old = ((cur or {}).get("TCP") or {}).get(str(FUNNEL_PORT))
        if on and old and old != {"HTTPS": True}:
            step = json.loads(json.dumps(cur))
            del step["TCP"][str(FUNNEL_PORT)]
            step.pop("AllowFunnel", None)
            try:
                api_full("POST", "serve-config", step, {"If-Match": etag})
            except HttpFail as e:
                if e.status == 412:
                    continue
                funnels_off(cur, etag, name, remote_port, tci_port)
                raise
            continue
        try:
            api_full("POST", "serve-config", new, {"If-Match": etag})
            return theirs
        except HttpFail as e:
            if e.status != 412:  # 412: changed meanwhile, read again
                if on:
                    funnels_off(cur, etag, name, remote_port, tci_port)
                raise
    raise Fail("the serve config kept changing")


def funnel_step(f, st):
    """Funnel while tailscaled runs: the status fields for the status file"""
    me = st.get("Self") or {}
    name = (me.get("DNSName") or "").rstrip(".").lower()
    want = funnel_wanted()
    remote_port, tci_port = conf_port(REMOTE_CONF, 50002), conf_port(TCI_CONF, 50001)
    key = (want, name, remote_port, tci_port, want and caps_ok(me))
    now = time.time()
    if key == f.key and now - f.done < FUNNEL_CHECK:
        return f.status
    f.key, f.done = key, now
    try:
        if not want:
            theirs = serve_set(name, remote_port, tci_port, False)
            f.status = {"funnel": "off"}
            if theirs:
                f.status["funnel_text"] = "Off; a funnel made by hand was taken off the internet: " + ", ".join(theirs)
            return f.status
        if not name:
            f.status = {"funnel": "error", "funnel_text": "Funnel needs MagicDNS: turn it on in Tailscale's admin console"}
            return f.status
        if not caps_ok(me):
            # The admin console's link that enables HTTPS and Funnel for this tailnet (what Tailscale's command
            # prints); asked again now and then, the caps are looked for at every poll
            if not f.url or now - f.asked > FUNNEL_ASK:
                f.asked = now
                info = api("POST", "query-feature?feature=funnel") or {}
                f.url, f.text = info.get("URL") or "", (info.get("Text") or "").strip()
            serve_set(name, remote_port, tci_port, False)   # meanwhile no funnel made by hand
            f.status = {"funnel": "enable", "funnel_url": f.url or None,
                        "funnel_text": "Turn on HTTPS and Funnel for your tailnet: open the link and allow it"
                                       if f.url else (f.text or "Funnel is not allowed on your tailnet: see "
                                                                 "Tailscale's admin console, Access controls")}
            return f.status
        if not all(os.path.isfile(os.path.join(FUNNEL_DIR, p)) for p in ("panel.html", "remote.html")):
            serve_set(name, remote_port, tci_port, False)       # meanwhile no funnel, the radio's or by hand
            f.status = {"funnel": "error", "funnel_text": "The Panel's Funnel pages are missing: restart the web server"}
            f.done = 0.0                                        # looked for again at the next poll
            return f.status
        was = f.status.get("funnel")
        serve_set(name, remote_port, tci_port, True)
        f.status = {"funnel": "on", "public": f"https://{name}/panel",
                    "funnel_text": "On: the Panel is on the internet" if was == "on" else
                    "On: the Panel is on the internet; its name can take up to 10 minutes to be found everywhere"}
    except (Fail, OSError, ValueError) as e:
        f.key = None                                            # tried again at the next poll
        f.status = {"funnel": "error", "funnel_text": f"Funnel: {e}"}
    return f.status


def funnel_idle():
    """Funnel's fields while tailscaled is not up (starting, a login wanted)"""
    return {"funnel": "starting", "funnel_text": "Funnel waits for Tailscale"} if funnel_wanted() else {"funnel": "off"}


def funnel_left(sc):
    """A serve config that still puts something on the internet: an AllowFunnel, a foreground session's too"""
    sc = sc or {}
    fgs = [fg for fg in (sc.get("Foreground") or {}).values() if isinstance(fg, dict)]
    return any(any((c.get("AllowFunnel") or {}).values()) for c in [sc] + fgs)


def tailscaled_pids():
    """The tailscaled processes on the radio's state: the supervisor's, one a killed supervisor left behind, one
    started by hand from the program on the DATA partition"""
    pids = []
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/cmdline", "rb") as f:
                args = f.read().split(b"\0")
        except OSError:
            continue
        if args[0] == BIN.encode() or f"--statedir={STATE}".encode() in args:
            pids.append(int(d))
    return pids


def state_funnel_off():
    """No funnel in tailscaled's state file, for its next start. Only while no tailscaled runs: one that runs writes
    its own copy over it. tailscaled keeps the serve config there as JSON in base64 (under _serve/<profile>); the
    radio's own entries go from it, and every AllowFunnel, as funnel_config does through the local API, and nothing
    else is touched. Returns whether a funnel was there; Fail when the file cannot be read: then nobody knows"""
    try:
        with open(STATE_FILE) as f:
            text = f.read()
    except FileNotFoundError:
        return False                               # Tailscale never started on this card
    except OSError as e:
        raise Fail(f"tailscaled's state cannot be read: {e}")
    try:
        state = json.loads(text) if text.strip() else {}
    except ValueError:
        state = None
    if not isinstance(state, dict):
        raise Fail("tailscaled's state is not what it should be")
    found = changed = False
    for key, value in state.items():
        try:
            sc = json.loads(base64.b64decode(value, validate=True))
        except (TypeError, ValueError):            # the keys, the login: no JSON in them
            continue
        if not isinstance(sc, dict) or not (key.startswith("_serve/") or "AllowFunnel" in sc or "Foreground" in sc):
            continue
        new, _ = funnel_config(sc, "", 0, 0, False)
        if new != sc:
            found = found or funnel_left(sc)
            state[key] = base64.b64encode(json.dumps(new).encode()).decode()
            changed = True
    if changed:
        tmp = f"{STATE_FILE}.{os.getpid()}"
        with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            json.dump(state, f, indent=2)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, STATE_FILE)
        fd = os.open(os.path.dirname(STATE_FILE), os.O_RDONLY)
        os.fsync(fd)
        os.close(fd)
    return found


# ---- the supervisor --------------------------------------------------------------------------

def drop_tmpfs():
    """Taildrop's inbox on a small tmpfs: what a peer sends never reaches the root filesystem"""
    os.makedirs(DROP, mode=0o700, exist_ok=True)
    if not os.path.ismount(DROP):
        r = subprocess.run(["mount", "-t", "tmpfs", "-o", f"size={DROP_KB}k,mode=0700", "tmpfs", DROP],
                           capture_output=True, text=True)
        if r.returncode != 0:
            raise Fail(f"no tmpfs for Taildrop files: {r.stderr.strip()}")


def start_daemon():
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    os.makedirs(RUN, exist_ok=True)
    drop_tmpfs()
    try:
        os.remove(SOCK)    # left by a tailscaled that crashed: the new one would seem up, and refuse
    except FileNotFoundError:
        pass
    env = dict(os.environ, TS_LOGS_DIR=RUN)    # its log settings in RAM, not on the root filesystem
    log = open(LOG, "ab")
    try:
        return subprocess.Popen([BIN, "--tun=userspace-networking", f"--statedir={STATE}", f"--socket={SOCK}",
                                 f"--port={PORT}", "--no-logs-no-support"],
                                stdin=subprocess.DEVNULL, stdout=log, stderr=log, env=env,
                                preexec_fn=lambda: os.nice(10))   # behind the GUI and the audio
    finally:
        log.close()


def wait_up(daemon):
    """The new tailscaled answers on its socket: its prefs are set. It is up only then"""
    name = network_name()
    end = time.time() + UP_WAIT
    while True:
        if stopping():
            raise Stopped()
        if daemon.poll() is not None:
            raise Fail(f"tailscaled stopped at once (code {daemon.returncode})")
        try:
            set_prefs(name)
            return
        except (Fail, OSError) as e:
            if time.time() > end:
                raise Fail(f"tailscaled does not answer ({e})")
        time.sleep(0.5)


def stop_daemon(p):
    if p and p.poll() is None:
        p.terminate()
        try:
            p.wait(10)
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()


def stop_tailscaled(p):
    """tailscaled stopped with no funnel kept (#58): a version without Funnel (gone back to by hand) would start it
    with the funnel of its state and never take it off. Out through the local API first, the radio's own and any made
    by hand, as while it runs; then out of the state file once it has stopped, for one it could not be told about (no
    login, not answering). The setting stays: the next start sets it again. Whatever comes of the two, tailscaled
    stops"""
    if p and p.poll() is None:
        try:
            serve_set("", 0, 0, False)
        except Exception:
            pass
    stop_daemon(p)
    if not tailscaled_pids():
        try:
            state_funnel_off()
        except Exception:
            pass


def nap(seconds):
    """A sleep that ends when Tailscale is turned off"""
    end = time.time() + seconds
    while time.time() < end and not stopping():
        time.sleep(min(0.5, end - time.time()))


def report(st, funnel):
    """BackendState and the rest, said in a line; funnel: Funnel's fields (funnel_step, funnel_idle)"""
    bs = st.get("BackendState", "")
    me = st.get("Self") or {}
    name = (me.get("DNSName") or "").rstrip(".") or None
    ips = me.get("TailscaleIPs") or []
    ip = next((a for a in ips if ":" not in a), ips[0] if ips else None)
    if bs == "Running":
        say("running", "Connected", name=name, ip=ip,
            tailnet=(st.get("CurrentTailnet") or {}).get("Name"), **funnel)
    elif bs == "NeedsLogin" and st.get("AuthURL"):
        say("login", "Waiting for your login", url=st["AuthURL"], **funnel)
    elif bs == "NeedsMachineAuth":
        say("approval", "Approve it in Tailscale's admin console", name=name, **funnel)
    else:
        say("starting", "Starting Tailscale...", **funnel)


def run():
    os.makedirs(RUN, exist_ok=True)
    lock = open(LOCK, "a+")                        # not "w": that would empty a running supervisor's pid
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0                                   # one supervisor already runs
    lock.truncate(0)
    lock.write(f"{os.getpid()}\n")
    lock.flush()
    signal.signal(signal.SIGTERM, lambda *_: _stop.append(1))
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    daemon = None
    asked = 0.0                                    # when a login link was last asked for
    fun = Funnel()
    try:
        while not stopping():
            if daemon is None:
                try:
                    if not have_program():
                        say("download", "Downloading Tailscale: 0 %", pct=0)
                        download()
                    say("starting", "Starting Tailscale...")
                    daemon = start_daemon()
                    wait_up(daemon)
                    asked = 0.0
                    fun = Funnel()                 # a new tailscaled: Funnel set again
                except Stopped:
                    break
                except (Fail, OSError, ValueError) as e:
                    stop_tailscaled(daemon)
                    daemon = None
                    say("error", f"Tailscale: {e}; trying again in a minute")
                    nap(RETRY)
                    continue
            if daemon.poll() is not None:
                say("error", f"tailscaled stopped (code {daemon.returncode}); starting it again")
                daemon = None
                nap(10)
                continue
            try:
                st = api("GET", "status?peers=false")
                bs = st.get("BackendState")
                if bs == "Stopped":
                    set_prefs()
                elif bs == "NeedsLogin" and not st.get("AuthURL") and time.time() - asked > 30:
                    api("POST", "login-interactive")
                    asked = time.time()
                report(st, funnel_step(fun, st) if bs == "Running" else funnel_idle())
            except (Fail, OSError, ValueError) as e:
                say("starting", f"Starting Tailscale... ({e})")
            try:
                if os.path.getsize(LOG) > LOG_MAX:
                    os.truncate(LOG, 0)            # opened for appending: tailscaled goes on from 0
            except OSError:
                pass
            nap(POLL)
    finally:
        if daemon and daemon.poll() is None:
            say("stopping", "Stopping Tailscale...")
        stop_tailscaled(daemon)
        say("off", "Off")
        lock.close()                               # released: the next supervisor may start
    # Turned on again while this one stopped (off, then on at once): the next one takes over. Not after
    # SIGTERM: that is the shutdown, the setting stays as it is
    if not _stop and enabled():
        spawn()
    return 0


# ---- the commands ----------------------------------------------------------------------------

def supervisor_pid():
    """The running supervisor's pid, 0 for none: whoever holds the lock, not a pid that may be another's now"""
    try:
        f = open(LOCK)
    except OSError:
        return 0
    with f:
        try:
            fcntl.flock(f, fcntl.LOCK_SH | fcntl.LOCK_NB)
            return 0                               # nobody holds it
        except OSError:
            pass
        try:
            return int(f.read().strip() or 0)
        except ValueError:
            return 0


def spawn():
    """A supervisor, unless one runs (two at once: the second finds the lock taken and leaves)"""
    if not supervisor_pid():
        subprocess.Popen([os.path.abspath(sys.argv[0]), "run"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def cmd_boot():
    if enabled():
        spawn()
    else:
        say("off", "Off")
    return 0


def cmd_on():
    set_enabled(True)
    if not supervisor_pid():                       # one that is stopping starts the next itself
        say("starting", "Starting Tailscale...")
        spawn()
    return 0


def cmd_off():
    """The setting off: the supervisor sees it within a poll (the download too) and stops tailscaled"""
    set_enabled(False)
    for _ in range(250):
        if not supervisor_pid():
            break
        time.sleep(0.1)
    else:
        return 0                                   # still stopping: its status says so, then Off
    say("off", "Off")                              # also when none ran: no stale state is left
    return 0


def cmd_logout():
    if not os.path.exists(SOCK):
        raise Fail("Tailscale is not running")
    api("POST", "logout")
    return 0


def cmd_hostname():
    if os.path.exists(SOCK):
        set_prefs(network_name())
    return 0


def cmd_funnel(arg=None):
    """Only the setting: the running supervisor sets tailscaled within a poll, and the next one at its start"""
    if arg not in ("on", "off"):
        raise Fail("funnel on or off")
    conf_write(funnel=1 if arg == "on" else 0)
    return 0


def status_field(key):
    """A field of the status file, "" when it has none"""
    try:
        with open(STATUS) as f:
            for line in f:
                k, sep, v = line.rstrip("\n").partition("=")
                if sep and k == key:
                    return v
    except OSError:
        pass
    return ""


def cmd_funnel_clear(wait=None):
    """Funnel off, and made sure of (#58): x6100-update runs it before it goes back to a version without Funnel, which
    never looks at a funnel kept in tailscaled's state, and whose TCI and browser remote would take connections from
    the internet without a key. The setting first, so that a supervisor of this version (one that runs on in memory
    after the step back too) keeps it off; then the funnel out of tailscaled, the radio's own and any made by hand:
    through its local API while it runs, out of its state file while it does not. Waits FUNNEL_CLEAR_WAIT s at most,
    or the seconds given: "ok ..." when it is sure, an error naming what kept it from being sure"""
    try:
        end = time.time() + (FUNNEL_CLEAR_WAIT if wait is None else float(wait))
    except ValueError:
        raise Fail("funnel-clear [seconds]")
    was = funnel_wanted()
    if was:
        conf_write(funnel=0)
    while True:
        running = tailscaled_pids()
        try:
            if running:
                cur = api("GET", "serve-config")
                if funnel_left(cur):
                    was = True
                    serve_set("", 0, 0, False)
                    cur = api("GET", "serve-config")
                if funnel_left(cur):
                    why = "tailscaled keeps a funnel"
                elif supervisor_pid() and status_field("funnel") == "on":
                    why = "Tailscale has not taken the setting yet"     # within a poll, or it sets the funnel again
                else:
                    break
            else:
                again = False
                if state_funnel_off():
                    was = True
                    again = state_funnel_off()     # read back: a tailscaled that came and went wrote its copy over it
                if tailscaled_pids():
                    why = "tailscaled is starting"  # it may have read the file before: through its local API then
                elif again:
                    why = "a funnel keeps coming back in tailscaled's state"
                else:
                    break
        except Fail as e:
            why = str(e)
        except (OSError, ValueError) as e:
            why = f"tailscaled does not answer ({e})" if running else f"tailscaled's state: {e}"
        if time.time() >= end:
            raise Fail(why)
        time.sleep(1)
    print("ok Funnel taken off" if was else "ok no funnel")
    return 0


def cmd_status():
    try:
        with open(STATUS) as f:
            sys.stdout.write(f.read())
    except OSError:
        sys.stdout.write(f"state=off\ntext=Off\nversion={VERSION}\n")
    return 0


def main(argv):
    cmds = {"on": cmd_on, "off": cmd_off, "logout": cmd_logout, "hostname": cmd_hostname,
            "funnel": cmd_funnel, "funnel-clear": cmd_funnel_clear, "status": cmd_status, "run": run}
    if argv and argv[0] not in cmds:
        print("usage: x6100-tailscale [" + "|".join(cmds) + "]", file=sys.stderr)
        return 1
    try:
        if argv and argv[0] in ("funnel", "funnel-clear"):
            return cmds[argv[0]](argv[1] if len(argv) > 1 else None)
        return cmds[argv[0]]() if argv else cmd_boot()
    except (Fail, OSError) as e:                   # OSError: tailscaled not answering on its socket
        print(f"error {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
