#!/bin/sh

# The DATA partition (settings, logs) is FAT: the radio is often switched off without a clean
# unmount, and the errors that pile up made the kernel set it read-only ("Read-only file
# system" saving settings). It is repaired at each start before anything opens it: fstab has
# it noauto, so nothing mounts it before this, and this runs first (S00bootanim reads
# /mnt/params.db). The result is in /tmp/data_fsck.log and /mnt/data_fsck.log.
#
# The partition is the one labelled DATA, else the card's third partition when that is FAT: cards
# written by older images or made by hand carry no label, and fstab mounted the third partition
# whatever it was called. Looked up by label only, such a card left /mnt unmounted and every
# setting went into the system partition's /mnt folder, lost at the next start and filling the
# system. A partition found that way gets the label; what was written into the system's /mnt
# folder in the meantime is moved onto DATA, in found_on_system.
LOG=/tmp/data_fsck.log
P3=/dev/mmcblk0p3

# A step into the start trace (x6100-starttrace; rcS writes this script's start and end): the check and
# the format are what can take long here, on a large or a failing card
trace() {
    [ -x /usr/sbin/x6100-starttrace ] && /usr/sbin/x6100-starttrace "S00adata: $*"
}

# dev: the DATA partition; relabel set when it has no label yet
find_data() {
    relabel=
    dev=$(blkid -L DATA 2>/dev/null) && return 0
    if [ -b $P3 ] && [ "$(blkid -o value -s TYPE $P3 2>/dev/null)" = vfat ]; then
        dev=$P3
        relabel=1
        return 0
    fi
    return 1
}

# Files written into the system's own /mnt folder while DATA was not mounted: onto DATA
rescue() {
    mkdir -p /tmp/sysroot && mount --bind / /tmp/sysroot || return
    if [ -n "$(ls -A /tmp/sysroot/mnt 2>/dev/null)" ]; then
        mkdir -p /mnt/found_on_system &&
            cp -a /tmp/sysroot/mnt/. /mnt/found_on_system/ &&
            rm -rf /tmp/sysroot/mnt/* /tmp/sysroot/mnt/.[!.]* &&
            echo "files found in the system's /mnt moved to found_on_system"
    fi
    umount /tmp/sysroot
}

check_data() {
    find_data || { echo "DATA partition not found" > $LOG; trace "DATA partition not found"; return; }
    if grep -q " /mnt " /proc/mounts; then umount /mnt; fi
    {
        echo "$(date '+%Y-%m-%d %H:%M:%S'), up $(cut -d' ' -f1 /proc/uptime) s"
        echo "$dev, label $(blkid -o value -s LABEL "$dev" 2>/dev/null || echo none)"
        grep -q " /mnt " /proc/mounts && echo "/mnt busy, not checked"
        if ! grep -q " /mnt " /proc/mounts; then
            trace "fsck.fat of $dev"
            fsck.fat -a -w "$dev"; rc=$?           # 0 clean, 1 errors fixed
            [ $rc -eq 1 ] && { trace "fsck.fat fixed errors, second pass"; fsck.fat -a -w "$dev"; rc=$?; }   # clean now?
            echo "fsck.fat exit $rc"
            trace "fsck.fat exit $rc"
            # a label only on a filesystem fsck left clean: not worth a write into a broken one
            [ -n "$relabel" ] && [ $rc -le 1 ] && { fatlabel "$dev" DATA && echo "label DATA set"; }
            if mount "$dev" /mnt; then
                rescue
            else
                echo "mount failed"
                trace "mount of $dev failed"
            fi
        fi
    } 2>&1 | grep -v -e "conversion" -e "CP850" > $LOG
    tail -n 40 $LOG > /mnt/data_fsck.log 2>/dev/null
}

start() {
    # A FAT32 partition: the DATA partition is there (checked and repaired, then mounted)
    if parted -m -s /dev/mmcblk0 print | grep -q fat32; then
        echo "Fat32 partition already exists"
        check_data
        return
    fi
    # None: the first start of a freshly written card, two partitions and the rest of the card
    # free. A card with a third partition of another kind (a reused card) is left alone: the old
    # script made a fourth and then formatted whatever was third.
    if parted -m -s /dev/mmcblk0 print | grep -q "^3:"; then
        echo "A third partition exists and is not FAT32: not touched"
        trace "A third partition exists and is not FAT32: not touched"
        return
    fi
    FREE_INFO=$(parted -sm /dev/mmcblk0 print free | tail -n1 | grep free)
    if [ $? -ne 0 ]; then
        echo "No free space available"
        trace "No free space available"
        return
    fi
    FREE_ARR=(${FREE_INFO//:/ })
    trace "no DATA partition: making it, ${FREE_ARR[1]} to ${FREE_ARR[2]}"
    # The partition, and the device it got (not assumed): a failed step stops here, no format
    if ! parted -m -s -a opt /dev/mmcblk0 mkpart primary fat32 ${FREE_ARR[1]} ${FREE_ARR[2]}; then
        echo "Creating the DATA partition failed"
        trace "making the partition failed"
        return
    fi
    partprobe /dev/mmcblk0
    NEW=$(parted -m -s /dev/mmcblk0 print | tail -n1 | cut -d: -f1)
    DEV=/dev/mmcblk0p$NEW
    if [ "$NEW" != "3" ] || [ ! -b "$DEV" ]; then
        echo "The new partition is not $DEV: not formatted"
        trace "The new partition is not $DEV: not formatted"
        return
    fi
    if [ -n "$(blkid "$DEV")" ]; then
        # A card image is smaller than the card: a new image leaves the old DATA filesystem
        # where it was, only its partition entry is gone. Made again, it is the same DATA:
        # settings and logs survive the new image (checked and mounted like any other start)
        if [ "$(blkid -s LABEL -o value "$DEV")" = "DATA" ]; then
            echo "The DATA filesystem of the previous image is still there: kept"
            check_data
            return
        fi
        echo "$DEV holds another filesystem: not formatted"
        trace "$DEV holds another filesystem: not formatted"
        return
    fi
    trace "formatting $DEV"
    mkfs -t vfat -n DATA "$DEV" || { echo "Formatting $DEV failed"; trace "formatting $DEV failed"; return; }
    mount "$DEV" /mnt || trace "mount of $DEV failed"
}

case "$1" in
    start)
        start;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start}"
    exit 1
esac
