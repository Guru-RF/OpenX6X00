#!/bin/sh
#
# Starts the gps daemon. It keeps running with no GPS attached (control socket), so a USB GPS
# plugged in later is picked up by the udev hotplug script and feeds ntpd (SHM 0) and the GUI.
#

NAME=gpsd
DAEMON=/usr/sbin/$NAME
PIDFILE=/var/run/$NAME.pid
STARTED=/var/run/$NAME.started
[ -r /etc/default/gpsd ] && . /etc/default/gpsd

# The WR12 receiver on an X6200's HOST port is a USB serial port too (0483:5740, /dev/ttyACM0 when it is the only
# one), not a GPS: the GUI drives it (#134). Plugged in at boot it was handed to gpsd here, which then read its
# answers. A GPS plugged in later comes through udev (25-gpsd.rules), which lists GPS receivers only
is_wr12() {
        n=$(readlink -f $1)
        n=/sys/class/tty/${n##*/}/device/..
        grep -q "xiegu,x6200" /proc/device-tree/compatible 2>/dev/null &&
                [ "$(cat $n/idVendor 2>/dev/null):$(cat $n/idProduct 2>/dev/null)" = "0483:5740" ]
}

# SmartCW, RF.Guru's keyer (1209:ff42 or 1209:ff43, 72-smartcw.rules), is a USB serial port too, on either radio: its
# command port, which keys in CW the text it is sent. Handed to gpsd as ttyACM0, the probes gpsd writes to learn what
# GPS it has went out in CW after every start, until a paddle stopped them
is_smartcw() {
        n=$(readlink -f $1)
        n=/sys/class/tty/${n##*/}/device/..
        case "$(cat $n/idVendor 2>/dev/null):$(cat $n/idProduct 2>/dev/null)" in
                1209:ff42 | 1209:ff43) return 0 ;;
        esac
        return 1
}

# The ports gpsd starts with: ttyACM0 and those udev knows as GPS receivers (/dev/gps*, 25-gpsd.rules), each once and
# by its own name. /dev/gps0 is a link to the port of a GPS udev knows, ttyACM0 for most: both were handed over, and
# gpsd opened the port twice, two readers each getting part of what the GPS sent. The hotplug script (gpsdctl) names
# the port as the kernel does, and so finds it already there (#237)
devices() {
        DEVICES=""
        for d in /dev/ttyACM0 /dev/gps*; do
                [ -e "$d" ] || continue
                d=$(readlink -f "$d")
                is_wr12 $d && continue
                is_smartcw $d && continue
                case " $DEVICES " in
                        *" $d "*) ;;
                        *) DEVICES="$DEVICES $d" ;;
                esac
        done
}

start() {
        printf "Starting $NAME: "
        # One gpsd. At boot, for a GPS udev knows, the hotplug script started one before this script (gpsdctl, no pid
        # file); this one then took its control socket over, found port 2947 taken and left, and from then on the
        # hotplug script, the WR12's let-go and stop here reached nobody (#237). The hotplug script waits for this
        # one now (STARTED, /etc/default/gpsd); one running all the same stays
        touch $STARTED
        if pidof $NAME >/dev/null; then
                echo "OK (running)"
                return 0
        fi
        devices
        start-stop-daemon -S -q -p $PIDFILE --exec $DAEMON -- -P $PIDFILE -F $GPSD_SOCKET $GPSD_OPTIONS $DEVICES && echo "OK" || echo "Failed"
}
stop() {
        printf "Stopping $NAME: "
        # Every gpsd, one the hotplug script started too, and gone before the next one starts: one on its way out
        # removes the control socket's name, the next one's by then (#237)
        start-stop-daemon -K -q -x $DAEMON
        n=0
        while pidof $NAME >/dev/null && [ $n -lt 30 ]; do
                sleep 0.1
                n=$((n + 1))
        done
        pidof $NAME >/dev/null && start-stop-daemon -K -q -s KILL -x $DAEMON && sleep 0.2
        rm -f $PIDFILE $STARTED
        pidof $NAME >/dev/null && echo "Failed" || echo "OK"
}
restart() {
        stop
        start
}

case "$1" in
  start)
        start
        ;;
  stop)
        stop
        ;;
  restart|reload)
        restart
        ;;
  *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?
