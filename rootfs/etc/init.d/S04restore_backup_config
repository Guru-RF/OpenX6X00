#!/bin/sh
#
# The network profiles, SSH host keys and root's SSH files are kept on the DATA partition and put
# back at boot (a rewritten card keeps its WiFi and its SSH identity). Only those files are taken
# from the archive: it lies on the user-visible DATA partition, and the script this replaces
# extracted whatever it held over / as root.
#

BACKUP_PATH="/mnt/backups/backup.tgz"
BACKUP_DIR=$(dirname ${BACKUP_PATH})

# BusyBox tar has no -z (no FEATURE_SEAMLESS_GZ): the archive goes through gzip and gunzip. gdyuldin's stock
# image writes a plain tar under the same name, which is read as it is
unpack() {
    if gzip -t "${BACKUP_PATH}" 2>/dev/null; then
        gunzip -c "${BACKUP_PATH}"
    else
        cat "${BACKUP_PATH}"
    fi
}

backup() {
    local list=/tmp/backup-config.list f
    [ -d "${BACKUP_DIR}" ] || mkdir -p "${BACKUP_DIR}"
    for f in /etc/NetworkManager/system-connections/* /etc/ssh/*_key* /root/.ssh/*; do
        [ -f "$f" ] && echo "${f#/}"
    done > $list
    # into a temporary file first: a power cut during the write leaves the previous backup
    set -o pipefail
    if [ -s $list ] && tar cf - -C / -T $list 2>/dev/null | gzip > "${BACKUP_PATH}.tmp"; then
        mv -f "${BACKUP_PATH}.tmp" "${BACKUP_PATH}"
    else
        rm -f "${BACKUP_PATH}.tmp"
    fi
    set +o pipefail
    rm -f $list
}

# What may come back, as the archive names them (no leading /): what backup() writes, the files right in the
# three folders, and in etc/ssh the keys only. A name further down, which no backup holds, made folders below them:
# root/.ssh/authorized_keys/x left authorized_keys a folder, and the SSH page could write no key
allowed() {
    case "$1" in
        *..*|/*) return 1 ;;
        etc/NetworkManager/system-connections/*/*|etc/ssh/*/*|root/.ssh/*/*) return 1 ;;
        etc/NetworkManager/system-connections/?*|root/.ssh/?*|etc/ssh/*_key*) return 0 ;;
    esac
    return 1
}

# The folder of a name allowed() took: one of the three, made by this script when the card has none
folder() {
    case "$1" in
        root/.ssh/*) echo /root/.ssh ;;
        etc/ssh/*) echo /etc/ssh ;;
        *) echo /etc/NetworkManager/system-connections ;;
    esac
}

# $1 is the name of exactly one member of the listing $2 (tar tv), and no member lies below it. A link's name
# comes with " -> " and its target, a hard link's too (BusyBox lists one with a regular file's '-')
only() {
    local n=0 mode owner size date time name
    while read -r mode owner size date time name; do
        case "${name%% -> *}" in
            "$1") n=$((n + 1)) ;;
            "$1"/*) return 1 ;;
        esac
    done < "$2"
    [ $n = 1 ]
}

restore() {
    local list=/tmp/backup-config.list members=/tmp/backup-config.members mode owner size date time name dir
    [ -f "${BACKUP_PATH}" ] || return 0
    # A freshly written card only: the images carry no SSH host keys (S50sshd makes them at the first start), so
    # keys present mean this card has run before, and a file missing now was deleted on purpose (a WiFi network
    # forgotten, an SSH key revoked); taking it back from the archive would undo that at every start
    ls /etc/ssh/ssh_host_*_key > /dev/null 2>&1 && return 0
    # Regular files only (the '-' type, not a hard link), under the allowed folders, not on the card yet (nor a
    # link there), and the archive's only member of that name with none below it; the name is the rest of the
    # line (a WiFi profile is named after its network, spaces and all)
    unpack | tar tvf - > $members 2>/dev/null
    while read -r mode owner size date time name; do
        case "$mode" in
            -*) ;;
            *) continue ;;
        esac
        case "$name" in
            *" -> "*) continue ;;
        esac
        allowed "$name" && [ ! -e "/$name" ] && [ ! -L "/$name" ] && only "$name" $members && echo "$size $name"
    done < $members > $list
    # Each one's bytes (-O), written by this script under its own name, as S39btpairings does. Unpacked onto /
    # with that list, tar took each name as a pattern (fnmatch) for every member of the name and below it, so a
    # FIFO or a link of a listed file's name came out in its place (audit C14). The pattern's wildcards are
    # escaped: a WiFi network "Cafe [5G]" is its file's name. Kept only when it is the member's size
    umask 077    # folders 700, files 600
    while read -r size name; do
        dir=$(folder "$name")
        [ -d "$dir" ] || mkdir -p "$dir" || continue
        unpack | tar xOf - "$(printf '%s\n' "$name" | sed 's/[][*?\\]/\\&/g')" > "/$name.restore" 2>/dev/null
        if [ "$(($(wc -c < "/$name.restore")))" = "$size" ]; then
            mv -f "/$name.restore" "/$name"
        else
            rm -f "/$name.restore"
        fi
    done < $list
    rm -f $list $members
    chmod 600 /etc/ssh/*_key /root/.ssh/* /etc/NetworkManager/system-connections/* 2>/dev/null
}

case "$1" in
    start)
        restore
        ;;
    stop)
        backup
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
esac

exit 0
