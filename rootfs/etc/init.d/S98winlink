#!/bin/sh
#
# OpenX6X00: Winlink, when it was turned on (/mnt/winlink.conf): x6100-winlink starts its supervisor in
# the background, which keeps Pat and the modem (ardopcf, or Mercury) running. After the GUI (S95), which owns
# the radio's audio.
#

case "$1" in
  start)
    printf "Winlink: "
    /usr/sbin/x6100-winlink && echo "OK"
    ;;
  stop)
    # The supervisor stops Pat (a connection in progress ends first) and the modem; the setting stays on
    /usr/sbin/x6100-winlink stop
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
esac

exit 0
