msgstr " (ARCHIVO DESCONOCIDO)"

#: src/dialog_base_update.c
msgid " (--recover)"
msgstr ""

#: src/dialog_base_update.c
msgid "--- written. The base starts the new firmware (its stream on ttyS1), but the GUI's I2C to it stays locked, and about three minutes on the base switches the radio off. Then switch it on again. The base stays lent until then; this log goes on to the card."
msgstr "--- grabado. La banda base arranca el firmware nuevo (su flujo por ttyS1), pero el I2C de la interfaz hacia ella queda bloqueado, y unos tres minutos después la banda base apaga la radio. Entonces vuelva a encenderla. La banda base sigue prestada hasta entonces; este registro se sigue guardando en la tarjeta."

#: src/dialog_base_update.c
msgid "--- refused: nothing was sent to the base. It is the GUI's again."
msgstr "--- rechazado: no se envió nada a la banda base. Vuelve a estar en manos de la interfaz."

#: src/dialog_base_update.c
msgid "--- failed before the erase: nothing was erased. Switch the radio off and on."
msgstr "--- falló antes del borrado: no se borró nada. Apague y encienda la radio."

#: src/dialog_base_update.c
msgid "--- failed at or after the erase: the base has no firmware now. Do not switch the radio off: Recover writes it again (its bootloader is not erased)."
msgstr "--- falló durante o después del borrado: la banda base no tiene firmware ahora. No apague la radio: Recuperar lo graba de nuevo (su bootloader no se borra)."

#: src/dialog_base_update.c
#, c-format
msgid "--- the writer ended with %d. Switch the radio off and on."
msgstr "--- el programa de grabación terminó con %d. Apague y encienda la radio."

