+/* OpenX6X00: the pilot search's correlations with FFTs. For each of the 40 search frequencies rade_c sums 160
+   products at each of the 2 x 960 times: 12 million complex multiplications for a 120 ms modem frame, about 175 ms of
+   the X6100's and X6200's Cortex-A7 (1 GHz). As correlations through the FFT (one forward, then one product and one
+   inverse for each frequency, of RADE_ACQ_NFFT points) the same grid takes a fraction of it; the search over it is
+   rade_c's own. The grid differs from the sums' in the last bits of a float only. rade_c's kiss_fft (Mark Borgerding,
+   BSD-3-Clause), built in here under names of its own: other code in a program may have a kiss_fft too. */
+#define kiss_fft_alloc          rade_acq_kiss_fft_alloc
+#define kiss_fft                rade_acq_kiss_fft
+#define kiss_fft_stride         rade_acq_kiss_fft_stride
+#define kiss_fft_cleanup        rade_acq_kiss_fft_cleanup
+#define kiss_fft_next_fast_size rade_acq_kiss_fft_next_fast_size
+#include "kiss_fft.c"
+
+_Static_assert(sizeof(RADE_COMP) == sizeof(kiss_fft_cpx), "RADE_COMP and kiss_fft_cpx: the same two floats");
+
+/* The plans and the pilot's spectrum, when every search frequency is a whole bin; else fft_ok stays 0 */
+static void acq_fft_init(rade_acq *acq) {
+    const int N = RADE_ACQ_NFFT;
+    size_t len;
+
+    acq->fft_ok = 0;
+    if (2 * acq->nmf + acq->m > N)
+        return;
+    len = sizeof(acq->fft_fwd_mem);
+    acq->fft_fwd = kiss_fft_alloc(N, 0, acq->fft_fwd_mem, &len);
+    len = sizeof(acq->fft_inv_mem);
+    acq->fft_inv = kiss_fft_alloc(N, 1, acq->fft_inv_mem, &len);
+    if (!acq->fft_fwd || !acq->fft_inv)
+        return;
+    for (int f_idx = 0; f_idx < acq->n_fcoarse; f_idx++) {
+        float b = acq->fcoarse_range[f_idx] * (float)N / (float)acq->fs;
+        int s = (int)lrintf(b);
+        if (fabsf(b - (float)s) > 1e-3f)
+            return;
+        acq->fft_shift[f_idx] = ((s % N) + N) % N;
+    }
+    memset(acq->fft_x, 0, sizeof(acq->fft_x));
+    memcpy(acq->fft_x, acq->p, sizeof(RADE_COMP) * acq->m);
+    kiss_fft(acq->fft_fwd, (const kiss_fft_cpx *)acq->fft_x, (kiss_fft_cpx *)acq->fft_y);
+    for (int m = 0; m < N; m++) {
+        acq->fft_pc[m].real = acq->fft_y[m].real / (float)N;
+        acq->fft_pc[m].imag = -acq->fft_y[m].imag / (float)N;
+    }
+    acq->fft_ok = 1;
+}
+
+/* Dt1[t][f] = sum(conj(rx[t:t+M]) * p_w[f]) and Dt2[t][f] the same at t + Nmf, for all t < Nmf and all f. With
+   p_w[f][n] = p[n] exp(j 2 pi s n / N), s the frequency in bins, the spectrum of p_w[f] is P[m - s]; the circular
+   correlation r = IFFT(X conj(P[m - s])) / N is sum(rx[t+n] conj(p_w[f][n])), wrapping nowhere: t + n < 2*Nmf + M
+   <= N. Dt is its conjugate. */
+static void acq_fft_grid(rade_acq *acq, const RADE_COMP *rx) {
+    const int N = RADE_ACQ_NFFT, Nmf = acq->nmf, L = 2 * acq->nmf + acq->m;
+    RADE_COMP *X = acq->fft_x, *Y = acq->fft_y, *r = acq->fft_r;
+
+    memcpy(Y, rx, sizeof(RADE_COMP) * L);
+    memset(Y + L, 0, sizeof(RADE_COMP) * (N - L));
+    kiss_fft(acq->fft_fwd, (const kiss_fft_cpx *)Y, (kiss_fft_cpx *)X);
+    for (int f_idx = 0; f_idx < acq->n_fcoarse; f_idx++) {
+        int s = acq->fft_shift[f_idx];
+        for (int m = 0; m < s; m++)
+            Y[m] = rade_cmul(X[m], acq->fft_pc[m - s + N]);
+        for (int m = s; m < N; m++)
+            Y[m] = rade_cmul(X[m], acq->fft_pc[m - s]);
+        kiss_fft(acq->fft_inv, (const kiss_fft_cpx *)Y, (kiss_fft_cpx *)r);
+        for (int t = 0; t < Nmf; t++) {
+            acq->Dt1[t][f_idx] = rade_cconj(r[t]);
+            acq->Dt2[t][f_idx] = rade_cconj(r[t + Nmf]);
+        }
+    }
+}
+
