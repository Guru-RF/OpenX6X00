+/* --cert-status: the certificate as the connection will see it, one line of
+ * key=value for a program to read (a web page that shows the enrolment): its
+ * status (pki_cert_status_str, spaces as '_'), its end and when the reflector
+ * renews it in seconds since 1970 (0 without one), the days left, and whether
+ * a request is waiting for the sysop (a CSR on disk with no usable
+ * certificate). Exit 0 when a certificate can log in, 1 when not. */
+static int run_cert_status(const svx_config *cfg) {
+    time_t     now = time(NULL);
+    cert_state cs;
+    char       st[32];
+
+    cert_assess(cfg, now, &cs, 0);
+    int usable  = enroll_have_usable_cert(cfg, now);
+    int pending = !usable && pki_file_exists(cs.csr_path);
+    snprintf(st, sizeof(st), "%s", pki_cert_status_str(cs.status));
+    for (char *p = st; *p; p++) if (*p == ' ') *p = '_';
+    printf("status=%s usable=%d request=%d not_after=%lld renew_at=%lld days=%d\n", st, usable, pending,
+           cs.status == PKI_CERT_MISSING ? 0LL : (long long)cs.info.not_after,
+           cs.status == PKI_CERT_MISSING ? 0LL : (long long)cs.info.renew_at,
+           cs.status == PKI_CERT_MISSING ? 0 : pki_days_until(cs.info.not_after, now));
+    return usable ? 0 : 1;
+}
