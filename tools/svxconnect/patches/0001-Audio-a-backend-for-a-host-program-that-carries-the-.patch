From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joeri Van Dooren <ure@on6ure.be>
Date: Mon, 16 Nov 2026 15:28:56 +0100
Subject: [PATCH 1/4] Audio: a backend for a host program that carries the
 audio, make AUDIO=pipe

A program that runs svxconnect as its helper and has its own audio path (a
radio's GUI that mixes the reflector into its speaker and records the
microphone itself) gets the audio over its socket instead of a sound card:
src/audio/dev_pipe.c, built in place of miniaudio with make AUDIO=pipe.
Playback is paced by a thread at 20 ms, as a sound card's callback would
take it, and sent only while the jitter buffer plays; the microphone comes
in through svx_audio_host_feed(). The sound-card backend answers no to the
attach and keeps its devices.
---
 Makefile                  |  11 ++
 src/audio/dev.h           |  18 ++-
 src/audio/dev_miniaudio.c |   5 +
 src/audio/dev_pipe.c      | 237 ++++++++++++++++++++++++++++++++++++++
 tests/dev_fake.c          |   3 +
 5 files changed, 271 insertions(+), 3 deletions(-)
 create mode 100644 src/audio/dev_pipe.c

diff --git a/Makefile b/Makefile
index b89d950..31aea9d 100644
--- a/Makefile
+++ b/Makefile
@@ -6,6 +6,7 @@
 #   make                 build build/svxconnect
 #   make install         install to $(PREFIX)/bin      (PREFIX=/usr/local)
 #   make asan            build with AddressSanitizer + UBSan
+#   make AUDIO=pipe      the audio through a host program (--stdio), no sound card
 #   make clean
 
 CC       ?= cc
@@ -103,6 +104,16 @@ else
     MSRC :=
 endif
 
+# The audio backend: miniaudio (the sound card) by default, or pipe for a host
+# program that carries the audio itself over the --stdio socket
+# (src/audio/dev_pipe.c): `make AUDIO=pipe`.
+AUDIO ?= miniaudio
+ifeq ($(AUDIO),pipe)
+    CSRC := $(filter-out src/audio/dev_miniaudio.c,$(CSRC))
+else
+    CSRC := $(filter-out src/audio/dev_pipe.c,$(CSRC))
+endif
+
 OBJ := $(patsubst %.c,$(BUILD)/%.o,$(CSRC)) $(patsubst %.m,$(BUILD)/%.o,$(MSRC))
 DEP := $(OBJ:.o=.d)
 
