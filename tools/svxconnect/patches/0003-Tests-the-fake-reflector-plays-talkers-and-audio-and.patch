 README.md             |   1 +
 tests/fakerefl.c      | 201 +++++++++++++++++++++++++++++++++++++++++-
 tests/fakerefl.h      |  23 ++++-
 tests/fakerefl_main.c |  67 ++++++++++++++
 5 files changed, 305 insertions(+), 5 deletions(-)
 create mode 100644 tests/fakerefl_main.c

