diff --git a/tests/fakerefl.c b/tests/fakerefl.c
index 81b74f0..3f4d71d 100644
--- a/tests/fakerefl.c
+++ b/tests/fakerefl.c
@@ -3,10 +3,14 @@
  */
 #include "fakerefl.h"
 
+#include "audio/codec.h"
+#include "audio/dev.h"
 #include "common/crypto.h"
 #include "common/proto.h"
 #include "common/util.h"
 
+#include <math.h>
+#include <stdarg.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -180,6 +184,190 @@ static void heartbeats(fakerefl *f, int fd, SSL *ssl, const uint8_t iv4[4],
     }
 }
 
+/* ------------------------------------------------------------- a script */
+
+static void report(fakerefl *f, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+static void report(fakerefl *f, const char *fmt, ...) {
+    char    line[512];
+    va_list ap;
+    if (!f->report) return;
+    va_start(ap, fmt);
+    vsnprintf(line, sizeof(line), fmt, ap);
+    va_end(ap);
+    f->report(f->report_user, line);
+}
+
+static int send_msg(SSL *ssl, uint16_t type, const uint8_t *body, size_t blen) {
+    uint8_t buf[600];
+    if (blen > sizeof(buf) - 2) return -1;
+    be_put_u16(buf, type);
+    memcpy(buf + 2, body, blen);
+    return ssl_send_frame(ssl, buf, 2 + blen);
+}
+
+static int send_talker(SSL *ssl, uint16_t type, uint32_t tg, const char *call) {
+    uint8_t body[300];
+    size_t  cl = strlen(call);
+    if (cl > 200) cl = 200;
+    be_put_u32(body, tg);
+    be_put_u16(body + 4, (uint16_t)cl);
+    memcpy(body + 6, call, cl);
+    return send_msg(ssl, type, body, 6 + cl);
+}
+
+static void send_udp(fakerefl *f, crypto_ctx_t *cx, const struct sockaddr_in *peer,
+                     uint16_t type, const uint8_t *body, size_t blen) {
+    uint8_t pt[600], wire[700];
+    size_t  ptlen;
+    if (proto_build_udp_plaintext(pt, sizeof(pt), &ptlen, type, body, blen) != 0) return;
+    ssize_t wn = crypto_encrypt_wire(cx, pt, ptlen, wire, sizeof(wire));
+    if (wn > 0 && sendto(f->ufd, wire, (size_t)wn, 0, (const struct sockaddr *)peer, sizeof(*peer)) == wn)
+        atomic_fetch_add(&f->udp_sent, 1);
+}
+
+/* What the client sent over TCP: the talkgroup it selects, the set it monitors */
+static void client_frames(fakerefl *f, uint8_t *in, size_t *n) {
+    while (*n >= 6) {
+        uint32_t len = be_get_u32(in);
+        if (len < 2 || len > 65536) { *n = 0; return; }
+        if (*n < 4 + (size_t)len) return;
+        uint16_t type = be_get_u16(in + 4);
+        if (type == MSG_SELECT_TG && len >= 6) {
+            report(f, "select %u", (unsigned)be_get_u32(in + 6));
+        } else if (type == MSG_TG_MONITOR && len >= 4) {
+            char     line[400];
+            size_t   k  = (size_t)snprintf(line, sizeof(line), "monitor");
+            uint16_t cnt = be_get_u16(in + 6);
+            for (uint16_t i = 0; i < cnt && 8 + 4 * (size_t)i + 4 <= 4 + (size_t)len && k < sizeof(line) - 12; i++)
+                k += (size_t)snprintf(line + k, sizeof(line) - k, " %u", (unsigned)be_get_u32(in + 8 + 4 * i));
+            report(f, "%s", line);
+        }
+        memmove(in, in + 4 + len, *n - 4 - len);
+        *n -= 4 + len;
+    }
+}
+
+/* TCP and UDP heartbeats as above, and the commands from fr_send() */
+static void script(fakerefl *f, int fd, SSL *ssl, const uint8_t iv4[4], const uint8_t key[16]) {
+    crypto_ctx_t cx;
+    crypto_init(&cx);
+    memcpy(cx.tx_iv_rand, iv4, 4);
+    memcpy(cx.tx_key, key, 16);
+    cx.client_id    = 0;
+    cx.sent_initial = 1;
+
+    svx_codec         *codec = codec_open();
+    struct sockaddr_in peer;
+    socklen_t          pl    = sizeof(peer);
+    int                have  = 0, audio_left = 0, hz = 440, heard = 0;
+    double             phase = 0.0;
+    uint64_t           start = now_ms(), next_tcp = start, next_udp = start, next_audio = 0, heard_ms = 0;
+    uint8_t            in[8192], junk[4096];
+    size_t             in_n  = 0;
+    char               cmd[1024];
+    size_t             cmd_n = 0;
+
+    while (!atomic_load(&f->stop)) {
+        uint64_t now = now_ms();
+        if (now >= next_tcp) {
+            uint8_t hb[2];
+            be_put_u16(hb, MSG_HEARTBEAT);
+            if (ssl_send_frame(ssl, hb, sizeof(hb)) != 0) break;
+            next_tcp = now + 200;
+        }
+        if (have && now >= next_udp) {
+            send_udp(f, &cx, &peer, UDP_MSG_HEARTBEAT, NULL, 0);
+            next_udp = now + 100;
+        }
+        while (audio_left > 0 && have && codec && now >= next_audio) {
+            int16_t pcm[SVX_FRAME];
+            uint8_t opus[SVX_MAX_OPUS];
+            for (int i = 0; i < SVX_FRAME; i++) {
+                pcm[i] = (int16_t)(8000.0 * sin(phase));
+                phase += 2.0 * M_PI * hz / SVX_RATE;
+            }
+            int on = codec_encode(codec, pcm, SVX_FRAME, opus, sizeof(opus));
+            if (on > 0) send_udp(f, &cx, &peer, UDP_MSG_AUDIO, opus, (size_t)on);
+            next_audio = next_audio + 20 < now ? now + 20 : next_audio + 20;
+            if (--audio_left == 0) send_udp(f, &cx, &peer, UDP_MSG_FLUSH_SAMPLES, NULL, 0);
+        }
+        /* The client's over: datagrams bigger than a heartbeat's, until they stop */
+        if (heard && now - heard_ms > 300) {
+            report(f, "audio %d", heard);
+            heard = 0;
+        }
+
+        struct pollfd p[3] = { { .fd = fd, .events = POLLIN }, { .fd = f->ufd, .events = POLLIN },
+                               { .fd = f->cmd[0], .events = POLLIN } };
+        if (poll(p, 3, 10) <= 0) continue;
+        if (p[0].revents) {
+            int r;
+            do {
+                r = SSL_read(ssl, in + in_n, (int)(sizeof(in) - in_n));
+                if (r > 0) in_n += (size_t)r;
+            } while (r > 0 && SSL_pending(ssl) > 0 && in_n < sizeof(in));
+            if (r <= 0 && SSL_get_error(ssl, r) != SSL_ERROR_WANT_READ) {
+                atomic_store(&f->client_gone_at, now_ms());
+                report(f, "gone");
+                break;
+            }
+            client_frames(f, in, &in_n);
+        }
+        if (f->ufd >= 0 && p[1].revents) {
+            pl = sizeof(peer);
+            ssize_t un = recvfrom(f->ufd, junk, sizeof(junk), 0, (struct sockaddr *)&peer, &pl);
+            if (un > 0) have = 1;
+            /* AAD 4 (6) + tag 8 + a 2-byte heartbeat or flush: audio is more */
+            if (un >= 18) { heard++; heard_ms = now_ms(); }
+        }
+        if (p[2].revents) {
+            ssize_t r = read(f->cmd[0], cmd + cmd_n, sizeof(cmd) - 1 - cmd_n);
+            if (r > 0) cmd_n += (size_t)r;
+            char *nl;
+            int   end = 0;
+            while ((nl = memchr(cmd, '\n', cmd_n)) != NULL) {
+                *nl = '\0';
+                unsigned tg = 0;
+                char     who[64] = "", text[400] = "";
+                int      frames = 0, h = 0;
+                if (sscanf(cmd, "talker start %u %63s", &tg, who) == 2) {
+                    send_talker(ssl, MSG_TALKER_START, tg, who);
+                } else if (sscanf(cmd, "talker stop %u %63s", &tg, who) == 2) {
+                    send_talker(ssl, MSG_TALKER_STOP, tg, who);
+                } else if (sscanf(cmd, "audio %d %d", &frames, &h) >= 1) {
+                    audio_left = frames;
+                    hz         = h > 0 ? h : 440;
+                    next_audio = now_ms();
+                } else if (sscanf(cmd, "error %399[^\n]", text) == 1) {
+                    uint8_t body[404];
+                    size_t  tl = strlen(text);
+                    be_put_u16(body, (uint16_t)tl);
+                    memcpy(body + 2, text, tl);
+                    send_msg(ssl, MSG_ERROR, body, 2 + tl);
+                } else if (strcmp(cmd, "close") == 0) {
+                    end = 1;
+                }
+                size_t used = (size_t)(nl - cmd) + 1;
+                memmove(cmd, cmd + used, cmd_n - used);
+                cmd_n -= used;
+            }
+            if (cmd_n == sizeof(cmd) - 1) cmd_n = 0;
+            if (end) {
+                report(f, "closed");
+                break;
+            }
+        }
+    }
+    codec_close(codec);
+}
+
+void fr_send(fakerefl *f, const char *line) {
+    char   buf[1100];
+    size_t n = (size_t)snprintf(buf, sizeof(buf) - 1, "%s", line);
+    buf[n++] = '\n';
+    if (write(f->cmd[1], buf, n) < 0) { /* the fake has stopped */ }
+}
+
 /* ------------------------------------------------------------- the part */
 
 static void login_and_act(fakerefl *f, int fd) {
@@ -197,7 +385,7 @@ static void login_and_act(fakerefl *f, int fd) {
     /* StartUdpEncryption. Empty means "use your key both ways"; when we are
      * going to send UDP ourselves, it carries our own key. */
     int     udp = f->after == FR_UDP_STEADY || f->after == FR_UDP_THEN_QUIET ||
-                  f->after == FR_TCP_ONLY;
+                  f->after == FR_TCP_ONLY || f->after == FR_SCRIPT;
     uint8_t su[2 + 4 + 16], iv4[4] = { 1, 2, 3, 4 }, key[16];
     for (int i = 0; i < 16; i++) key[i] = (uint8_t)(0xa0 + i);
     be_put_u16(su, MSG_START_UDP_ENCRYPTION);
@@ -206,6 +394,7 @@ static void login_and_act(fakerefl *f, int fd) {
     if (ssl_send_frame(ssl, si, sizeof(si)) != 0 ||
         ssl_send_frame(ssl, su, udp ? sizeof(su) : 2) != 0) { SSL_free(ssl); return; }
     atomic_fetch_add(&f->logged_in, 1);
+    report(f, "login");
 
     /* Let the client adopt the connection and settle. */
     uint64_t until = now_ms() + 300;
@@ -239,6 +428,7 @@ static void login_and_act(fakerefl *f, int fd) {
     case FR_UDP_STEADY:     heartbeats(f, fd, ssl, iv4, key, -1);  break;
     case FR_UDP_THEN_QUIET: heartbeats(f, fd, ssl, iv4, key, 500); break;
     case FR_TCP_ONLY:       heartbeats(f, fd, ssl, iv4, key, 0);   break;
+    case FR_SCRIPT:         script(f, fd, ssl, iv4, key);         break;
     }
     SSL_free(ssl);
 }
@@ -299,8 +489,13 @@ static void *accept_main(void *arg) {
 int fr_start(fakerefl *f, fr_mode mode, fr_after after, const char *pki_dir,
              const char *callsign) {
     const char *text = f->error_text;
+    void (*rep)(void *, const char *) = f->report;
+    void *rep_user = f->report_user;
     memset(f, 0, sizeof(*f));
-    f->ufd        = -1;
+    f->ufd         = -1;
+    f->report      = rep;
+    f->report_user = rep_user;
+    if (pipe(f->cmd) != 0) return -1;
     f->mode       = mode;
     f->after      = after;
     f->error_text = text;
@@ -345,5 +540,7 @@ void fr_stop(fakerefl *f) {
     pthread_mutex_unlock(&g_mu);
     close(f->lfd);
     if (f->ufd >= 0) close(f->ufd);
+    close(f->cmd[0]);
+    close(f->cmd[1]);
     SSL_CTX_free(f->ctx);
 }
