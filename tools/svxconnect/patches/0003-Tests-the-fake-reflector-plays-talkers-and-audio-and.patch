+# The fake reflector as a program (tests/fakerefl_main.c): a reflector on
+# loopback that a front end's own tests drive, with svxconnect --stdio as the
+# front end's helper.
+FAKEREFL_OBJ := $(BUILD)/tests/fakerefl_main.o $(BUILD)/tests/fakerefl.o \
+                $(BUILD)/src/audio/codec.o \
+                $(BUILD)/src/common/crypto.o \
+                $(BUILD)/src/common/proto.o \
+                $(BUILD)/src/common/log.o \
+                $(BUILD)/src/common/util.o
+
+$(BUILD)/fakerefl: $(FAKEREFL_OBJ)
+	@mkdir -p $(@D)
+	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^ -lssl -lcrypto $(OPUS_LIBS) -lpthread -lm
+
+fakerefl: $(BUILD)/fakerefl
+
 check: test $(BUILD)/connecttest
 	@$(BUILD)/connecttest
 
