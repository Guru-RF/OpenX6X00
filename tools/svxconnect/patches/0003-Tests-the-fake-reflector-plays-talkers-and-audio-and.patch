diff --git a/tests/fakerefl_main.c b/tests/fakerefl_main.c
new file mode 100644
index 0000000..d94e6f7
--- /dev/null
+++ b/tests/fakerefl_main.c
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: MIT
+ * SVXConnect-CLI — Copyright (c) 2026 Joeri Van Dooren
+ *
+ * The fake reflector as a program, for the tests of a front end that runs
+ * svxconnect as its helper (svxconnect --stdio): a reflector on 127.0.0.1
+ * that logs a client in and plays what it is told on stdin.
+ *
+ *   build/fakerefl <pki dir> <callsign>
+ *
+ * The client's configuration names the same pki dir and callsign: a throwaway
+ * key and self-signed certificate are made there when there is none, and the
+ * fake presents the same one. It prints "port <n>" first, then a line for each
+ * thing the client does (fakerefl.h: login, select, monitor, audio, gone).
+ * Each line on stdin is one of fr_send()'s commands; "quit" or the end of
+ * stdin stops it.
+ */
+#include "fakerefl.h"
+
+#include "common/log.h"
+
+#include <signal.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+static pthread_mutex_t g_out = PTHREAD_MUTEX_INITIALIZER;
+
+static void out(void *user, const char *line) {
+    (void)user;
+    pthread_mutex_lock(&g_out);
+    printf("%s\n", line);
+    fflush(stdout);
+    pthread_mutex_unlock(&g_out);
+}
+
+int main(int argc, char **argv) {
+    if (argc != 3) {
+        fprintf(stderr, "usage: fakerefl <pki dir> <callsign>\n");
+        return 2;
+    }
+    signal(SIGPIPE, SIG_IGN);
+    log_set_level(LOG_WARN);
+
+    char crt[1024];
+    snprintf(crt, sizeof(crt), "%s/%s.crt", argv[1], argv[2]);
+    if (access(crt, R_OK) != 0 && fr_make_pki(argv[1], argv[2]) != 0) {
+        fprintf(stderr, "fakerefl: cannot make a key and certificate in %s\n", argv[1]);
+        return 1;
+    }
+
+    fakerefl f = { .report = out };
+    if (fr_start(&f, FR_LOGIN, FR_SCRIPT, argv[1], argv[2]) != 0) {
+        fprintf(stderr, "fakerefl: cannot listen\n");
+        return 1;
+    }
+    char line[1024];
+    snprintf(line, sizeof(line), "port %d", f.port);
+    out(NULL, line);
+
+    while (fgets(line, sizeof(line), stdin)) {
+        line[strcspn(line, "\r\n")] = '\0';
+        if (strcmp(line, "quit") == 0) break;
+        if (line[0]) fr_send(&f, line);
+    }
+    fr_stop(&f);
+    return 0;
+}
