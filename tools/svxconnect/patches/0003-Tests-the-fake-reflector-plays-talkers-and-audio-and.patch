 } fr_after;
 
 typedef struct {
@@ -47,6 +52,13 @@ typedef struct {
     atomic_int   logged_in;           /* logins completed                      */
     atomic_int   udp_sent;            /* datagrams sent to the client          */
     _Atomic uint64_t client_gone_at;  /* now_ms() when the client's socket closed */
+
+    /* FR_SCRIPT: a line for each thing the client did ("login", "select 8",
+     * "monitor 1745 8000", "audio 50" when an over of 50 datagrams has ended,
+     * "gone"), from the connection's thread. Set before fr_start(). */
+    void       (*report)(void *user, const char *line);
+    void        *report_user;
+    int          cmd[2];              /* fr_send()'s pipe to the connection   */
 } fakerefl;
 
 /* Write a throwaway key + self-signed certificate for `callsign` into `dir`,
@@ -59,4 +71,11 @@ int  fr_start(fakerefl *f, fr_mode mode, fr_after after, const char *pki_dir,
               const char *callsign);
 void fr_stop(fakerefl *f);
 
+/* FR_SCRIPT: one command for the connection, played at once:
+ *   talker start <tg> <call> | talker stop <tg> <call>
+ *   audio <frames> [<hz>]      a tone, 20 ms Opus frames, then a flush
+ *   error <text>               MsgError
+ *   close                      end the connection (the client comes back) */
+void fr_send(fakerefl *f, const char *line);
+
