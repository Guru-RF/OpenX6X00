-// Expects the file to never get renamed/truncated or deleted
+// Expects the file to never get renamed or deleted. OpenX6X00: a file cut shorter than what was
+// read (the radio's supervisor trims the log) is read again from its start.
 func tailFile(path string) (<-chan []byte, chan<- struct{}, error) {
 	lines := make(chan []byte)
 	done := make(chan struct{})
@@ -254,6 +255,11 @@ func tailFile(path string) (<-chan []byte, chan<- struct{}, error) {
 		for {
 			data, _, err := rd.ReadLine()
 			if errors.Is(err, io.EOF) {
+				if truncated(file) {
+					file.Seek(0, io.SeekStart)
+					rd.Reset(file)
+					continue
+				}
 				time.Sleep(time.Millisecond * 100)
 				continue
 			}
@@ -270,6 +276,17 @@ func tailFile(path string) (<-chan []byte, chan<- struct{}, error) {
 	return lines, done, nil
 }
 
+// truncated tells whether a file read to its end is now shorter than where it was read to
+// (OpenX6X00).
+func truncated(file *os.File) bool {
+	pos, err := file.Seek(0, io.SeekCurrent)
+	if err != nil {
+		return false
+	}
+	fi, err := file.Stat()
+	return err == nil && fi.Size() < pos
+}
+
 func (w *WSHub) handleWSMessage(v map[string]json.RawMessage) {
 	raw, ok := v["prompt_response"]
