+		log.Printf("ARDOP bandwidth %s, the widest set on the radio (Operating > Winlink), not the %s asked",
+			url.Params.Get("bw"), asked)
+	}
+
 	// Init TNCs
 	switch url.Scheme {
 	case MethodAX25AGWPE:
