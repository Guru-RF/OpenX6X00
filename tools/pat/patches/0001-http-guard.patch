--- /dev/null
+++ b/api/guard.go
@@ -0,0 +1,274 @@
+// Copyright (c) 2026 Joeri Van Dooren ON6URE / Guru-RF (OpenX6X00).
+// Use of this source code is governed by the MIT-license that can be
+// found in the LICENSE file.
+
+package api
+
+import (
+	"bytes"
+	"io"
+	"net"
+	"net/http"
+	"net/netip"
+	"net/url"
+	"os"
+	"path"
+	"slices"
+	"strings"
+)
+
+// guard refuses the requests that a web page on another site can make a browser send to
+// Pat (OpenX6X00 patch). Pat has no login, and a plain GET of /api/connect keys the
+// transmitter.
+//
+//   - Nothing that came through Tailscale Funnel, from the internet: tailscaled's serve
+//     proxy marks such a request with a Tailscale-Funnel-Request header. Pat is for the
+//     radio's network and the tailnet only, whatever is funneled by mistake.
+//   - The Host header must name this machine: an IP address, localhost, the hostname,
+//     <hostname>.local, <hostname>.<domain> for a domain the radio's network gives it, a name
+//     its owner added on the web configurator's Network page, a Tailscale name (*.ts.net) or
+//     the short name MagicDNS gives the radio (the first part of its tailnet name, from
+//     x6100-tailscale's status file: x6200-1 when the tailnet still has an earlier card
+//     image's machine as x6200). Any other name is one that somebody's DNS points at us (DNS
+//     rebinding).
+//   - For /api/ and /ws: an Origin header, when present, must name the same host:port as
+//     Host, and Sec-Fetch-Site, when present, must be same-origin or none.
+//   - What changes something (/api/connect and /api/disconnect, which take a GET, and any
+//     API request that is not a GET) must also show it comes from Pat's own page: an
+//     Origin header (checked above), or jQuery's X-Requested-With, which Pat's page sends.
+//     A browser sends neither Origin nor Sec-Fetch-Site with an <img> or a link to a plain
+//     http:// address on the LAN, and a page on another site cannot add X-Requested-With
+//     without a CORS preflight, which carries its Origin.
+//
+// Anything else gets 403. Pages on other sites may not frame Pat's pages either.
+func guard(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("Tailscale-Funnel-Request") != "" {
+			http.Error(w, "Forbidden: not over Tailscale Funnel", http.StatusForbidden)
+			return
+		}
+		if !hostAllowed(r.Host) {
+			http.Error(w, "Forbidden: unknown host name", http.StatusForbidden)
+			return
+		}
+		if guardedPath(r.URL.Path) && !sameOrigin(r) {
+			http.Error(w, "Forbidden: cross-origin request", http.StatusForbidden)
+			return
+		}
+		if guardedPath(r.URL.Path) && changes(r) && !fromOwnPage(r) {
+			http.Error(w, "Forbidden: not from Pat's own page", http.StatusForbidden)
+			return
+		}
+		w.Header().Set("X-Frame-Options", "SAMEORIGIN")
+		next.ServeHTTP(w, r)
+	})
+}
+
+// hostAllowed tells whether a Host header (host or host:port) names this machine.
+func hostAllowed(hostport string) bool {
+	host := hostport
+	if h, _, err := net.SplitHostPort(hostport); err == nil {
+		host = h
+	}
+	host = strings.TrimSuffix(strings.TrimPrefix(host, "["), "]")
+	host = strings.TrimSuffix(strings.ToLower(host), ".")
+	if host == "" {
+		return false
+	}
+	if _, err := netip.ParseAddr(host); err == nil {
+		return true
+	}
+	if host == "localhost" || strings.HasSuffix(host, ".ts.net") {
+		return true
+	}
+	if short := tailnetName(); short != "" && host == short {
+		return true
+	}
+	name, err := os.Hostname()
+	name = strings.TrimSuffix(strings.ToLower(name), ".")
+	if err == nil && name != "" {
+		if host == name || host == name+".local" {
+			return true
+		}
+		if d, ok := strings.CutPrefix(host, name+"."); ok && slices.Contains(networkDomains(), d) {
+			return true
+		}
+	}
+	return slices.Contains(listedNames(), host)
+}
+
+// The files the radio's own names come from beyond its hostname (OpenX6X00 #105), read at
+// each request (a few hundred bytes). resolvConf is NetworkManager's resolv.conf (the radio's
+// /etc/resolv.conf is a link to /run/NetworkManager/resolv.conf): its search and domain lines
+// are the domains the radio's network gives it, for the connections that are up. ownNames is
+// the list its owner keeps on the web configurator's Network page, a name on each line. The web
+// configurator (local_host_ok) and the radio's sockets (src/tci_ws.c) take the same names.
+var (
+	resolvConf = "/etc/resolv.conf"
+	ownNames   = "/mnt/own_names.conf"
+)
+
+// namesFileMax is the most read of either file, in whole lines.
+const namesFileMax = 4096
+
+// fileLines returns the whole lines of a small file, nil without it. A line cut at
+// namesFileMax is left out, so that no word of it is taken cut short.
+func fileLines(path string) []string {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil
+	}
+	defer f.Close()
+	b := make([]byte, namesFileMax+1)
+	n, _ := io.ReadFull(f, b)
+	b = b[:n]
+	if n > namesFileMax {
+		b = b[:bytes.LastIndexByte(b[:namesFileMax], '\n')+1]
+	}
+	return strings.Split(string(b), "\n")
+}
+
+// privateDomains are the single names routers give their networks that stay out of the
+// public DNS (lan, home and the others are never delegated, internal is ICANN's for private
+// networks). Any other single name has a top-level domain's shape (nl, box), and x6100.<it>
+// could be anyone's.
+var privateDomains = []string{"lan", "home", "localdomain", "internal", "intranet", "corp", "private"}
+
+// registryLabels are a country's second level, where anyone registers names (co.uk, com.au,
+// or.jp): <one of these>.<two letters> is a public suffix alone.
+var registryLabels = []string{"ac", "co", "com", "edu", "go", "gob", "gouv", "gov", "gv", "ltd", "mil", "ne",
+	"net", "nom", "or", "org", "plc", "sch"}
+
+// dnsName tells whether d is a DNS name in lower case: labels of letters, digits and '-' (not
+// first or last), the last one with a letter.
+func dnsName(d string) bool {
+	if d == "" || len(d) > 253 {
+		return false
+	}
+	labels := strings.Split(d, ".")
+	for i, l := range labels {
+		if l == "" || len(l) > 63 || l[0] == '-' || l[len(l)-1] == '-' {
+			return false
+		}
+		letter := false
+		for _, c := range l {
+			switch {
+			case c >= 'a' && c <= 'z':
+				letter = true
+			case c >= '0' && c <= '9', c == '-':
+			default:
+				return false
+			}
+		}
+		if i == len(labels)-1 && !letter {
+			return false
+		}
+	}
+	return true
+}
+
+// domainPrivate tells whether a domain of the radio's network names it: no public suffix on
+// its own, under which anyone may register a name. A single name only when it is one of
+// privateDomains; no country's second level (co.uk).
+func domainPrivate(d string) bool {
+	first, rest, ok := strings.Cut(d, ".")
+	if !ok {
+		return slices.Contains(privateDomains, d)
+	}
+	return dnsName(d) && (strings.Contains(rest, ".") || len(rest) != 2 || !slices.Contains(registryLabels, first))
+}
+
+// lowerWord is a domain or a name as resolv.conf and the list have it: in lower case, without
+// a trailing dot.
+func lowerWord(w string) string {
+	return strings.TrimSuffix(strings.ToLower(w), ".")
+}
+
+// networkDomains are the domains of the radio's network that name it, from resolv.conf's
+// search and domain lines.
+func networkDomains() []string {
+	var found []string
+	for _, line := range fileLines(resolvConf) {
+		f := strings.Fields(line)
+		if len(f) == 0 || (f[0] != "search" && f[0] != "domain") {
+			continue
+		}
+		for _, w := range f[1:] {
+			if d := lowerWord(w); domainPrivate(d) {
+				found = append(found, d)
+			}
+		}
+	}
+	return found
+}
+
+// listedNames are the names the owner added on the Network page: the first word of each line.
+func listedNames() []string {
+	var names []string
+	for _, line := range fileLines(ownNames) {
+		if f := strings.Fields(line); len(f) > 0 && !strings.HasPrefix(f[0], "#") {
+			names = append(names, lowerWord(f[0]))
+		}
+	}
+	return names
+}
+
+// tailscaleStatus is the status file x6100-tailscale keeps; its name= line is the radio's
+// MagicDNS name (x6200-1.tail1234.ts.net) while it is on a tailnet.
+var tailscaleStatus = "/run/tailscale/status"
+
+// tailnetName is the first part of the radio's MagicDNS name, the short name a tailnet peer
+// opens it by; "" when it is on no tailnet. The web configurator takes the same name
+// (local_host_ok), and its Winlink page links to the mailbox by the name it was opened by.
+func tailnetName() string {
+	b, err := os.ReadFile(tailscaleStatus)
+	if err != nil {
+		return ""
+	}
+	for _, line := range strings.Split(string(b), "\n") {
+		if v, ok := strings.CutPrefix(line, "name="); ok {
+			short, _, _ := strings.Cut(strings.ToLower(strings.TrimSpace(v)), ".")
+			return short
+		}
+	}
+	return ""
+}
+
+// guardedPath tells whether a path is the API's: /api, /api/... or /ws.
+func guardedPath(p string) bool {
+	p = path.Clean("/" + p)
+	return p == "/api" || strings.HasPrefix(p, "/api/") || p == "/ws"
+}
+
+// sameOrigin tells whether a request comes from Pat's own pages or from no page at all
+// (curl, an address typed in): Origin, when sent, is http(s)://<the Host header>, and
+// Sec-Fetch-Site, when sent, is same-origin or none.
+func sameOrigin(r *http.Request) bool {
+	if o := r.Header.Get("Origin"); o != "" {
+		u, err := url.Parse(o)
+		if err != nil || (u.Scheme != "http" && u.Scheme != "https") || !strings.EqualFold(u.Host, r.Host) {
+			return false
+		}
+	}
+	switch r.Header.Get("Sec-Fetch-Site") {
+	case "", "same-origin", "none":
+		return true
+	}
+	return false
+}
+
+// changes tells whether an API request changes something: connect and disconnect, which
+// Pat answers on any method, and every request that is not a GET or HEAD.
+func changes(r *http.Request) bool {
+	p := path.Clean("/" + r.URL.Path)
+	if p == "/api/connect" || p == "/api/disconnect" {
+		return true
+	}
+	return r.Method != http.MethodGet && r.Method != http.MethodHead
+}
+
+// fromOwnPage tells whether a request shows it comes from Pat's own page: it carries an
+// Origin header (sameOrigin has checked that it is ours) or jQuery's X-Requested-With.
+func fromOwnPage(r *http.Request) bool {
+	return r.Header.Get("Origin") != "" || r.Header.Get("X-Requested-With") == "XMLHttpRequest"
+}
diff --git a/api/guard_test.go b/api/guard_test.go
new file mode 100644
index 0000000..c7acaa6
--- /dev/null
+++ b/api/guard_test.go
@@ -0,0 +1,211 @@
+package api
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// guardFiles points the guard's files into a new folder, none of them there yet: on no
+// tailnet, no domain from the network, no name listed.
+func guardFiles(t *testing.T) {
+	dir := t.TempDir()
+	tailscaleStatus = filepath.Join(dir, "status")
+	resolvConf = filepath.Join(dir, "resolv.conf")
+	ownNames = filepath.Join(dir, "own_names.conf")
+}
+
+func TestGuard(t *testing.T) {
+	guardFiles(t)
+	hostname, _ := os.Hostname()
+	ok := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	tests := []struct {
+		path, host, origin, site string
+		want                     int
+		method, xrw              string // GET and none when empty
+	}{
+		{"/ui", "192.168.1.20:8080", "", "", 200, "", ""},
+		{"/api/status", "[fe80::1]:8080", "", "", 200, "", ""},
+		{"/api/status", "localhost:8080", "", "", 200, "", ""},
+		{"/api/status", hostname + ":8080", "", "", 200, "", ""},
+		{"/api/status", hostname + ".local:8080", "", "", 200, "", ""},
+		{"/api/status", "radio.tail1234.ts.net", "", "", 200, "", ""},
+		{"/api/status", "evil.example", "", "", 403, "", ""},
+		{"/ui", "evil.example:8080", "", "", 403, "", ""},
+		{"/api/status", "", "", "", 403, "", ""},
+		{"/api/status", "10.0.0.5:8080", "http://10.0.0.5:8080", "same-origin", 200, "", ""},
+		{"/ui", "10.0.0.5:8080", "", "none", 200, "", ""},
+		{"/ui", "10.0.0.5:8080", "", "cross-site", 200, "", ""},
+		{"/api/connect", "10.0.0.5:8080", "http://evil.example", "", 403, "", ""},
+		{"/api/connect", "10.0.0.5:8080", "http://10.0.0.5", "", 403, "", ""},
+		{"/api/connect", "10.0.0.5:8080", "null", "", 403, "", ""},
+		{"/api/connect", "10.0.0.5:8080", "", "cross-site", 403, "", ""},
+		{"/api/connect", "10.0.0.5:8080", "", "same-site", 403, "", ""},
+		{"//api/connect", "10.0.0.5:8080", "", "cross-site", 403, "", ""},
+		{"/ws", "10.0.0.5:8080", "http://evil.example", "", 403, "", ""},
+		// what an <img> or a link on another site sends to a LAN address over http: no Origin,
+		// no Sec-Fetch-*
+		{"/api/connect", "10.0.0.5:8080", "", "", 403, "", ""},
+		{"/api/disconnect", "x6100.local:8080", "", "", 403, "", ""},
+		{"/api/connect", "10.0.0.5:8080", "", "", 403, "POST", ""},
+		{"/api/config", "10.0.0.5:8080", "", "", 403, "PUT", ""},
+		{"/api/mailbox/in/X", "10.0.0.5:8080", "", "", 403, "DELETE", ""},
+		// Pat's own page: jQuery's header, or the Origin of a POST
+		{"/api/connect", "10.0.0.5:8080", "", "", 200, "", "XMLHttpRequest"},
+		{"/api/disconnect", "10.0.0.5:8080", "http://10.0.0.5:8080", "same-origin", 200, "POST", "XMLHttpRequest"},
+		{"/api/form", "10.0.0.5:8080", "http://10.0.0.5:8080", "same-origin", 200, "POST", ""},
+		{"/api/connect", "10.0.0.5:8080", "http://evil.example", "", 403, "", "XMLHttpRequest"},
+		// reads need no proof: another site cannot see the answer
+		{"/api/status", "10.0.0.5:8080", "", "", 200, "", ""},
+	}
+	for _, tt := range tests {
+		method := tt.method
+		if method == "" {
+			method = "GET"
+		}
+		r := httptest.NewRequest(method, "http://x"+tt.path, nil)
+		if tt.xrw != "" {
+			r.Header.Set("X-Requested-With", tt.xrw)
+		}
+		r.Host = tt.host
+		if tt.origin != "" {
+			r.Header.Set("Origin", tt.origin)
+		}
+		if tt.site != "" {
+			r.Header.Set("Sec-Fetch-Site", tt.site)
+		}
+		w := httptest.NewRecorder()
+		guard(ok).ServeHTTP(w, r)
+		if w.Code != tt.want {
+			t.Errorf("%s Host=%q Origin=%q Sec-Fetch-Site=%q: got %d, want %d", tt.path, tt.host, tt.origin, tt.site, w.Code, tt.want)
+		}
+	}
+}
+
+// Nothing through Tailscale Funnel: its serve proxy adds Tailscale-Funnel-Request ("?1") to a
+// request from the internet, which comes with the radio's .ts.net name as Host.
+func TestGuardFunnel(t *testing.T) {
+	guardFiles(t)
+	ok := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	for _, tt := range []struct {
+		method, path, xrw, funnel string
+		want                      int
+	}{
+		{"GET", "/ui", "", "?1", 403},
+		{"GET", "/api/status", "", "?1", 403},
+		{"GET", "/api/connect", "XMLHttpRequest", "?1", 403},
+		{"POST", "/api/mailbox/out", "XMLHttpRequest", "?1", 403},
+		{"GET", "/ws", "", "1", 403},
+		// the same from the tailnet, without the header
+		{"GET", "/ui", "", "", 200},
+		{"GET", "/api/status", "", "", 200},
+		{"GET", "/api/connect", "XMLHttpRequest", "", 200},
+	} {
+		r := httptest.NewRequest(tt.method, "http://x"+tt.path, nil)
+		r.Host = "x6200.tail1234.ts.net"
+		if tt.xrw != "" {
+			r.Header.Set("X-Requested-With", tt.xrw)
+		}
+		if tt.funnel != "" {
+			r.Header.Set("Tailscale-Funnel-Request", tt.funnel)
+		}
+		w := httptest.NewRecorder()
+		guard(ok).ServeHTTP(w, r)
+		if w.Code != tt.want {
+			t.Errorf("%s %s Tailscale-Funnel-Request=%q: got %d, want %d", tt.method, tt.path, tt.funnel, w.Code, tt.want)
+		}
+	}
+}
+
+// The short name MagicDNS gives the radio, while x6100-tailscale's status file names it.
+func TestGuardTailnetName(t *testing.T) {
+	guardFiles(t)
+	ok := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	code := func(host string) int {
+		r := httptest.NewRequest("GET", "http://x/api/status", nil)
+		r.Host = host
+		w := httptest.NewRecorder()
+		guard(ok).ServeHTTP(w, r)
+		return w.Code
+	}
+	if got := code("x6200-1:8080"); got != 403 {
+		t.Errorf("x6200-1 on no tailnet: got %d, want 403", got)
+	}
+	status := "state=running\ntext=Connected\nname=X6200-1.tail1234.ts.net\nip=100.101.102.103\n"
+	if err := os.WriteFile(tailscaleStatus, []byte(status), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	for host, want := range map[string]int{"x6200-1:8080": 200, "X6200-1.:8080": 200, "x6200-1": 200,
+		"x6200-2:8080": 403, "tail1234:8080": 403, "x6200-1.evil.example:8080": 403} {
+		if got := code(host); got != want {
+			t.Errorf("Host=%q with the tailnet name x6200-1: got %d, want %d", host, got, want)
+		}
+	}
+}
+
+// The radio's own names beyond its hostname (OpenX6X00 #105): <hostname>.<domain> for the
+// domains in resolv.conf's search and domain lines, never a public suffix alone (x6100.nl
+// could be anyone's) nor a domain cut short where the file is read no further, and the names
+// listed on the web configurator's Network page. A site's own name stays refused.
+func TestGuardOwnNames(t *testing.T) {
+	guardFiles(t)
+	hostname, _ := os.Hostname()
+	hostname = strings.ToLower(hostname)
+	ok := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	code := func(host string) int {
+		r := httptest.NewRequest("GET", "http://x/api/status", nil)
+		r.Host = host
+		w := httptest.NewRecorder()
+		guard(ok).ServeHTTP(w, r)
+		return w.Code
+	}
+	write := func(path, text string) {
+		if err := os.WriteFile(path, []byte(text), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write(resolvConf, "# Generated by NetworkManager\nsearch Home.LAN. nl co.uk lan box\n"+
+		"domain tri-angle.nl\nnameserver 192.168.1.1\n")
+	for host, want := range map[string]int{
+		hostname + ".home.lan:8080": 200, hostname + ".lan": 200, hostname + ".tri-angle.nl:8080": 200,
+		hostname + ".nl:8080": 403, hostname + ".co.uk:8080": 403, hostname + ".box:8080": 403,
+		"not-" + hostname + ".home.lan:8080": 403, "home.lan:8080": 403, "x6100.tri-angle.nl:8080": 403,
+	} {
+		if got := code(host); got != want {
+			t.Errorf("Host=%q with the network's domains: got %d, want %d", host, got, want)
+		}
+	}
+	// a search line cut where the file is read no further: example.co of example.co.uk not taken
+	head := strings.Repeat("#", 32) + "\n"
+	line := "search " + strings.Repeat("f.lan ", 600)
+	line += strings.Repeat(" ", namesFileMax-len(head)-len("example.co")-len(line))
+	write(resolvConf, head+line+"example.co.uk\n")
+	if got := code(hostname + ".example.co:8080"); got != 403 {
+		t.Errorf("a domain cut short: got %d, want 403", got)
+	}
+	os.Remove(resolvConf)
+	write(ownNames, "x6100.tri-angle.nl\n# a note\nShack.Example.LAN.\n")
+	for host, want := range map[string]int{
+		"x6100.tri-angle.nl:8080": 200, "X6100.Tri-Angle.NL.": 200, "shack.example.lan:8080": 200,
+		"tri-angle.nl:8080": 403, "x6100.tri-angle.nl.evil.example:8080": 403, "evil.example:8080": 403,
+		"#:8080": 403, "a:8080": 403,
+	} {
+		if got := code(host); got != want {
+			t.Errorf("Host=%q with the names listed: got %d, want %d", host, got, want)
+		}
+	}
+	os.Remove(ownNames)
+	if got := code("x6100.tri-angle.nl:8080"); got != 403 {
+		t.Errorf("x6100.tri-angle.nl taken off the list: got %d, want 403", got)
+	}
+	for d, want := range map[string]bool{"lan": true, "home.arpa": true, "fritz.box": true, "example.co.uk": true,
+		"example.co": true, "nl": false, "box": false, "co.uk": false, "com.au": false, "or.jp": false,
+		"a_b.lan": false, "10.1": false, "-a.lan": false, "": false} {
+		if got := domainPrivate(d); got != want {
+			t.Errorf("domainPrivate(%q) = %v, want %v", d, got, want)
+		}
+	}
+}
