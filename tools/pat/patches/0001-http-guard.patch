From e18338b2984e08ec7c28aa91b3fd8a2dac97bd3a Mon Sep 17 00:00:00 2001
From: Joeri Van Dooren <ure@on6ure.be>
Date: Mon, 26 Oct 2026 12:19:12 +0100
Subject: [PATCH] api: refuse requests other sites can make a browser send
 (OpenX6X00)

Pat has no login, and a plain GET of /api/connect keys the transmitter.
The HTTP server's handler is wrapped in a guard:

- the Host header must be an IP address, localhost, the hostname,
  <hostname>.local, end in .ts.net, or be the radio's MagicDNS short
  name (the first part of name= in /run/tailscale/status, x6200-1 when
  the tailnet still has an earlier card's machine as x6200), the names
  the web configurator takes (no DNS rebinding);
- for /api/ and /ws, an Origin header, when present, must name the same
  host:port as Host, and Sec-Fetch-Site, when present, must be
  same-origin or none;
- what changes something (/api/connect and /api/disconnect on any
  method, every API request that is not a GET or HEAD) must also come
  with an Origin or jQuery's X-Requested-With, which Pat's page sends:
  an <img> or a link on another site reaches a plain http:// LAN address
  with neither Origin nor Sec-Fetch-Site, and cannot add that header
  without a CORS preflight that carries its Origin;
- 403 otherwise. Pages are sent with X-Frame-Options: SAMEORIGIN.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 api/api.go        |   2 +-
 api/guard.go      | 138 ++++++++++++++++++++++++++++++++++++++++++++++
 api/guard_test.go | 102 ++++++++++++++++++++++++++++++++++
 3 files changed, 241 insertions(+), 1 deletion(-)
 create mode 100644 api/guard.go
 create mode 100644 api/guard_test.go

diff --git a/api/api.go b/api/api.go
index 7f39760..a1c9308 100644
--- a/api/api.go
+++ b/api/api.go
@@ -56,7 +56,7 @@ func ListenAndServe(ctx context.Context, a *app.App, addr string) error {
 
 	srv := http.Server{
 		Addr:    addr,
-		Handler: handler,
+		Handler: guard(handler), // OpenX6X00: see guard.go
 	}
 	errs := make(chan error, 1)
 	go func() {
diff --git a/api/guard.go b/api/guard.go
new file mode 100644
index 0000000..9fa7b86
--- /dev/null
+++ b/api/guard.go
@@ -0,0 +1,138 @@
+// Copyright (c) 2026 Joeri Van Dooren ON6URE / Guru-RF (OpenX6X00).
+// Use of this source code is governed by the MIT-license that can be
+// found in the LICENSE file.
+
+package api
+
+import (
+	"net"
+	"net/http"
+	"net/netip"
+	"net/url"
+	"os"
+	"path"
+	"strings"
+)
+
+// guard refuses the requests that a web page on another site can make a browser send to
+// Pat (OpenX6X00 patch). Pat has no login, and a plain GET of /api/connect keys the
+// transmitter.
+//
+//   - The Host header must name this machine: an IP address, localhost, the hostname,
+//     <hostname>.local, a Tailscale name (*.ts.net) or the short name MagicDNS gives the
+//     radio (the first part of its tailnet name, from x6100-tailscale's status file: x6200-1
+//     when the tailnet still has an earlier card image's machine as x6200). Any other name is
+//     one that somebody's DNS points at us (DNS rebinding).
+//   - For /api/ and /ws: an Origin header, when present, must name the same host:port as
+//     Host, and Sec-Fetch-Site, when present, must be same-origin or none.
+//   - What changes something (/api/connect and /api/disconnect, which take a GET, and any
+//     API request that is not a GET) must also show it comes from Pat's own page: an
+//     Origin header (checked above), or jQuery's X-Requested-With, which Pat's page sends.
+//     A browser sends neither Origin nor Sec-Fetch-Site with an <img> or a link to a plain
+//     http:// address on the LAN, and a page on another site cannot add X-Requested-With
+//     without a CORS preflight, which carries its Origin.
+//
+// Anything else gets 403. Pages on other sites may not frame Pat's pages either.
+func guard(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if !hostAllowed(r.Host) {
+			http.Error(w, "Forbidden: unknown host name", http.StatusForbidden)
+			return
+		}
+		if guardedPath(r.URL.Path) && !sameOrigin(r) {
+			http.Error(w, "Forbidden: cross-origin request", http.StatusForbidden)
+			return
+		}
+		if guardedPath(r.URL.Path) && changes(r) && !fromOwnPage(r) {
+			http.Error(w, "Forbidden: not from Pat's own page", http.StatusForbidden)
+			return
+		}
+		w.Header().Set("X-Frame-Options", "SAMEORIGIN")
+		next.ServeHTTP(w, r)
+	})
+}
+
+// hostAllowed tells whether a Host header (host or host:port) names this machine.
+func hostAllowed(hostport string) bool {
+	host := hostport
+	if h, _, err := net.SplitHostPort(hostport); err == nil {
+		host = h
+	}
+	host = strings.TrimSuffix(strings.TrimPrefix(host, "["), "]")
+	host = strings.TrimSuffix(strings.ToLower(host), ".")
+	if host == "" {
+		return false
+	}
+	if _, err := netip.ParseAddr(host); err == nil {
+		return true
+	}
+	if host == "localhost" || strings.HasSuffix(host, ".ts.net") {
+		return true
+	}
+	if short := tailnetName(); short != "" && host == short {
+		return true
+	}
+	name, err := os.Hostname()
+	name = strings.TrimSuffix(strings.ToLower(name), ".")
+	return err == nil && name != "" && (host == name || host == name+".local")
+}
+
+// tailscaleStatus is the status file x6100-tailscale keeps; its name= line is the radio's
+// MagicDNS name (x6200-1.tail1234.ts.net) while it is on a tailnet.
+var tailscaleStatus = "/run/tailscale/status"
+
+// tailnetName is the first part of the radio's MagicDNS name, the short name a tailnet peer
+// opens it by; "" when it is on no tailnet. The web configurator takes the same name
+// (local_host_ok), and its Winlink page links to the mailbox by the name it was opened by.
+func tailnetName() string {
+	b, err := os.ReadFile(tailscaleStatus)
+	if err != nil {
+		return ""
+	}
+	for _, line := range strings.Split(string(b), "\n") {
+		if v, ok := strings.CutPrefix(line, "name="); ok {
+			short, _, _ := strings.Cut(strings.ToLower(strings.TrimSpace(v)), ".")
+			return short
+		}
+	}
+	return ""
+}
+
+// guardedPath tells whether a path is the API's: /api, /api/... or /ws.
+func guardedPath(p string) bool {
+	p = path.Clean("/" + p)
+	return p == "/api" || strings.HasPrefix(p, "/api/") || p == "/ws"
+}
+
+// sameOrigin tells whether a request comes from Pat's own pages or from no page at all
+// (curl, an address typed in): Origin, when sent, is http(s)://<the Host header>, and
+// Sec-Fetch-Site, when sent, is same-origin or none.
+func sameOrigin(r *http.Request) bool {
+	if o := r.Header.Get("Origin"); o != "" {
+		u, err := url.Parse(o)
+		if err != nil || (u.Scheme != "http" && u.Scheme != "https") || !strings.EqualFold(u.Host, r.Host) {
+			return false
+		}
+	}
+	switch r.Header.Get("Sec-Fetch-Site") {
+	case "", "same-origin", "none":
+		return true
+	}
+	return false
+}
+
+// changes tells whether an API request changes something: connect and disconnect, which
+// Pat answers on any method, and every request that is not a GET or HEAD.
+func changes(r *http.Request) bool {
+	p := path.Clean("/" + r.URL.Path)
+	if p == "/api/connect" || p == "/api/disconnect" {
+		return true
+	}
+	return r.Method != http.MethodGet && r.Method != http.MethodHead
+}
+
+// fromOwnPage tells whether a request shows it comes from Pat's own page: it carries an
+// Origin header (sameOrigin has checked that it is ours) or jQuery's X-Requested-With.
+func fromOwnPage(r *http.Request) bool {
+	return r.Header.Get("Origin") != "" || r.Header.Get("X-Requested-With") == "XMLHttpRequest"
+}
diff --git a/api/guard_test.go b/api/guard_test.go
new file mode 100644
index 0000000..0a6261b
--- /dev/null
+++ b/api/guard_test.go
@@ -0,0 +1,102 @@
+package api
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestGuard(t *testing.T) {
+	tailscaleStatus = filepath.Join(t.TempDir(), "status") // on no tailnet
+	hostname, _ := os.Hostname()
+	ok := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	tests := []struct {
+		path, host, origin, site string
+		want                     int
+		method, xrw              string // GET and none when empty
+	}{
+		{"/ui", "192.168.1.20:8080", "", "", 200, "", ""},
+		{"/api/status", "[fe80::1]:8080", "", "", 200, "", ""},
+		{"/api/status", "localhost:8080", "", "", 200, "", ""},
+		{"/api/status", hostname + ":8080", "", "", 200, "", ""},
+		{"/api/status", hostname + ".local:8080", "", "", 200, "", ""},
+		{"/api/status", "radio.tail1234.ts.net", "", "", 200, "", ""},
+		{"/api/status", "evil.example", "", "", 403, "", ""},
+		{"/ui", "evil.example:8080", "", "", 403, "", ""},
+		{"/api/status", "", "", "", 403, "", ""},
+		{"/api/status", "10.0.0.5:8080", "http://10.0.0.5:8080", "same-origin", 200, "", ""},
+		{"/ui", "10.0.0.5:8080", "", "none", 200, "", ""},
+		{"/ui", "10.0.0.5:8080", "", "cross-site", 200, "", ""},
+		{"/api/connect", "10.0.0.5:8080", "http://evil.example", "", 403, "", ""},
+		{"/api/connect", "10.0.0.5:8080", "http://10.0.0.5", "", 403, "", ""},
+		{"/api/connect", "10.0.0.5:8080", "null", "", 403, "", ""},
+		{"/api/connect", "10.0.0.5:8080", "", "cross-site", 403, "", ""},
+		{"/api/connect", "10.0.0.5:8080", "", "same-site", 403, "", ""},
+		{"//api/connect", "10.0.0.5:8080", "", "cross-site", 403, "", ""},
+		{"/ws", "10.0.0.5:8080", "http://evil.example", "", 403, "", ""},
+		// what an <img> or a link on another site sends to a LAN address over http: no Origin,
+		// no Sec-Fetch-*
+		{"/api/connect", "10.0.0.5:8080", "", "", 403, "", ""},
+		{"/api/disconnect", "x6100.local:8080", "", "", 403, "", ""},
+		{"/api/connect", "10.0.0.5:8080", "", "", 403, "POST", ""},
+		{"/api/config", "10.0.0.5:8080", "", "", 403, "PUT", ""},
+		{"/api/mailbox/in/X", "10.0.0.5:8080", "", "", 403, "DELETE", ""},
+		// Pat's own page: jQuery's header, or the Origin of a POST
+		{"/api/connect", "10.0.0.5:8080", "", "", 200, "", "XMLHttpRequest"},
+		{"/api/disconnect", "10.0.0.5:8080", "http://10.0.0.5:8080", "same-origin", 200, "POST", "XMLHttpRequest"},
+		{"/api/form", "10.0.0.5:8080", "http://10.0.0.5:8080", "same-origin", 200, "POST", ""},
+		{"/api/connect", "10.0.0.5:8080", "http://evil.example", "", 403, "", "XMLHttpRequest"},
+		// reads need no proof: another site cannot see the answer
+		{"/api/status", "10.0.0.5:8080", "", "", 200, "", ""},
+	}
+	for _, tt := range tests {
+		method := tt.method
+		if method == "" {
+			method = "GET"
+		}
+		r := httptest.NewRequest(method, "http://x"+tt.path, nil)
+		if tt.xrw != "" {
+			r.Header.Set("X-Requested-With", tt.xrw)
+		}
+		r.Host = tt.host
+		if tt.origin != "" {
+			r.Header.Set("Origin", tt.origin)
+		}
+		if tt.site != "" {
+			r.Header.Set("Sec-Fetch-Site", tt.site)
+		}
+		w := httptest.NewRecorder()
+		guard(ok).ServeHTTP(w, r)
+		if w.Code != tt.want {
+			t.Errorf("%s Host=%q Origin=%q Sec-Fetch-Site=%q: got %d, want %d", tt.path, tt.host, tt.origin, tt.site, w.Code, tt.want)
+		}
+	}
+}
+
+// The short name MagicDNS gives the radio, while x6100-tailscale's status file names it.
+func TestGuardTailnetName(t *testing.T) {
+	tailscaleStatus = filepath.Join(t.TempDir(), "status")
+	ok := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	code := func(host string) int {
+		r := httptest.NewRequest("GET", "http://x/api/status", nil)
+		r.Host = host
+		w := httptest.NewRecorder()
+		guard(ok).ServeHTTP(w, r)
+		return w.Code
+	}
+	if got := code("x6200-1:8080"); got != 403 {
+		t.Errorf("x6200-1 on no tailnet: got %d, want 403", got)
+	}
+	status := "state=running\ntext=Connected\nname=X6200-1.tail1234.ts.net\nip=100.101.102.103\n"
+	if err := os.WriteFile(tailscaleStatus, []byte(status), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	for host, want := range map[string]int{"x6200-1:8080": 200, "X6200-1.:8080": 200, "x6200-1": 200,
+		"x6200-2:8080": 403, "tail1234:8080": 403, "x6200-1.evil.example:8080": 403} {
+		if got := code(host); got != want {
+			t.Errorf("Host=%q with the tailnet name x6200-1: got %d, want %d", host, got, want)
+		}
+	}
+}
