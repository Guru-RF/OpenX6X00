+package forms
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/la5nta/wl2k-go/fbb"
+	"github.com/la5nta/wl2k-go/mailbox"
+)
+
+// A text-only template opened as a reply (the composer's Reply, then a template from the forms'
+// catalog: /api/forms with in-reply-to) gets the message replied to from the mailbox, not from
+// Pat's working directory (OpenX6X00 patch).
+func TestTemplateEditorReply(t *testing.T) {
+	defer func(f func() bool) { isInternetAvailable = f }(isInternetAvailable)
+	isInternetAvailable = func() bool { return false } // no HEAD request to www.google.com
+	dir := t.TempDir()
+	formsDir, mboxDir := filepath.Join(dir, "forms"), filepath.Join(dir, "mailbox")
+	if err := os.MkdirAll(filepath.Join(mboxDir, "in"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	var editor string
+	m := NewManager(Config{FormsPath: formsDir, SequencePath: filepath.Join(dir, "sequence"), MyCall: "N0CALL",
+		SequenceFormat: "%03d", RenderTemplateEditor: func(w http.ResponseWriter, text string) error {
+			editor = text
+			return nil
+		}})
+	defer m.Close()
+	const tmpl = "Subj: Re: <MsgOriginalSubject>\nMsg:\n<MsgOriginalBody>\n"
+	if err := os.WriteFile(filepath.Join(formsDir, "Reply.txt"), []byte(tmpl), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	msg := fbb.NewMessage(fbb.Private, "LA5NTA")
+	msg.SetFrom("LA5NTA")
+	msg.AddTo("N0CALL")
+	msg.SetSubject("Water at the school")
+	if err := msg.SetBody("Need 40 l of water."); err != nil {
+		t.Fatal(err)
+	}
+	b, err := msg.Bytes()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(mboxDir, "in", msg.MID()+mailbox.Ext), b, 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	q := url.Values{"template": {"Reply.txt"}, "in-reply-to": {"in/" + msg.MID()}}
+	rec := httptest.NewRecorder()
+	m.GetFormTemplateHandler(mboxDir)(rec, httptest.NewRequest("GET", "/api/forms?"+q.Encode(), nil))
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status %d: %s", rec.Code, rec.Body.String())
+	}
+	for _, want := range []string{"Subj: Re: Water at the school", "Need 40 l of water."} {
+		if !strings.Contains(editor, want) {
+			t.Errorf("the template editor has no %q: %q", want, editor)
+		}
+	}
+
+	q.Set("in-reply-to", "../../"+msg.MID()) // and nothing outside the mailbox
+	rec = httptest.NewRecorder()
+	m.GetFormTemplateHandler(mboxDir)(rec, httptest.NewRequest("GET", "/api/forms?"+q.Encode(), nil))
+	if rec.Code == http.StatusOK {
+		t.Errorf("an in-reply-to outside the mailbox: status %d", rec.Code)
+	}
+}
