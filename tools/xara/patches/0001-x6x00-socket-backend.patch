diff --git a/crates/xara/src/audio/x6x00.rs b/crates/xara/src/audio/x6x00.rs
new file mode 100644
index 0000000..c15ebe7
--- /dev/null
+++ b/crates/xara/src/audio/x6x00.rs
@@ -0,0 +1,710 @@
+//! OpenX6X00: the radio's own software (the GUI) as the sound card and the PTT, on the X6100 and the X6200
+//! (`--audio x6x00 --ptt x6x00`). A patch of OpenX6X00's, under XARA's MIT licence.
+//!
+//! The GUI owns the radio's audio and its keying. Its Winlink modem socket (`src/winlink.c` in OpenX6X00, the
+//! one ardopcf and Mercury use) is a UNIX SOCK_SEQPACKET socket, `--capture` and `--playback` both (on the radio
+//! /run/ardop.sock), one message a packet: a 4-byte header {type, arg, n} in host byte order, then n samples,
+//! mono, signed 16 bits, at the session's rate. On each connect XARA says hello in protocol 2 (H: 12000 Hz, keys
+//! of KEY_S at most); the GUI sends the receiver in 20 ms blocks (R, none while the radio is on the air); XARA
+//! sends P 1 to key, its audio as T and P 0, after which the GUI plays out every T it has and unkeys. The GUI
+//! keys the radio with the checks it has for its own digital modes: the bands, simplex, the power caps, the SWR
+//! hold.
+//!
+//! The receiver goes up from 12 kHz to XARA's 48 kHz, and read() is paced by it: zeros at the wall clock's pace
+//! while the radio transmits or the GUI is away. XARA's audio goes down to 12 kHz and out as T only between a P 1
+//! and its P 0, sent under one lock with them; what XARA writes in the moment before its PTT thread keys is held
+//! and sent right after the P 1. A thread connects, and again every second while the GUI is not there; XARA runs
+//! on meanwhile and a key goes nowhere (the GUI cuts a transmission whose client goes).
+
+use std::collections::VecDeque;
+use std::io;
+use std::mem::size_of;
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Condvar, Mutex, PoisonError};
+use std::thread::{self, JoinHandle};
+use std::time::{Duration, Instant};
+
+use super::ratematch::Queue;
+use super::{Audio, DeviceList, Path, RATE, capture_only, quantize, sample};
+use crate::lock;
+use crate::ptt::Ptt;
+use crate::resample::Resampler;
+
+pub const SOCKET: &str = "/run/ardop.sock";
+const PROTO: u8 = 2;
+const GUI_RATE: u32 = 12000;
+// The longest key the GUI is asked to allow: XARA's own watchdog (--ptt-max-s) defaults to as much
+const KEY_S: i16 = 30;
+const T_MAX: usize = 1200;
+const HDR: usize = 4;
+const RETRY: Duration = Duration::from_secs(1);
+const LOOK: Duration = Duration::from_millis(100);
+const SEND_WAIT: Duration = Duration::from_millis(500);
+const KEEP: usize = 2 * RATE as usize;
+const KEEP_AFTER_DROP: usize = RATE as usize / 10;
+const JITTER: Duration = Duration::from_millis(60);
+const STREAMING: Duration = Duration::from_millis(300);
+const HELD_MAX: usize = GUI_RATE as usize / 2;
+// What XARA times its replies by, until measured on the radios (--x6x00-path-ms): the GUI's capture in 20 ms
+// fragments and the resamplers; the GUI's key (its checks, the base keying); its low-latency playback stream
+// (prebuf 60 ms, tlength 100 ms)
+pub const PATH_MS: [usize; 3] = [25, 50, 80];
+static PATH: Mutex<[usize; 3]> = Mutex::new(PATH_MS);
+
+/// capture, keying and out of path(), in ms: `--x6x00-path-ms`
+pub fn set_path_ms(ms: [usize; 3]) {
+    *lock(&PATH) = ms;
+}
+
+fn message(kind: u8, arg: u8, s: &[i16]) -> Vec<u8> {
+    let mut m = Vec::with_capacity(HDR + 2 * s.len());
+    m.extend_from_slice(&[kind, arg]);
+    m.extend_from_slice(&(s.len() as u16).to_ne_bytes());
+    s.iter().for_each(|v| m.extend_from_slice(&v.to_ne_bytes()));
+    m
+}
+
+fn connect(path: &str) -> io::Result<OwnedFd> {
+    // SAFETY: a sockaddr_un is plain data, all zeros a valid one.
+    let mut a: libc::sockaddr_un = unsafe { std::mem::zeroed() };
+    a.sun_family = libc::AF_UNIX as libc::sa_family_t;
+    if path.len() >= a.sun_path.len() {
+        return Err(io::Error::other(format!("{path}: too long for a socket")));
+    }
+    a.sun_path.iter_mut().zip(path.bytes()).for_each(|(d, s)| *d = s as libc::c_char);
+    // SAFETY: socket() returns a new fd or -1.
+    let fd = unsafe { libc::socket(libc::AF_UNIX, libc::SOCK_SEQPACKET | libc::SOCK_CLOEXEC, 0) };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: fd is open and ours alone.
+    let fd = unsafe { OwnedFd::from_raw_fd(fd) };
+    let len = size_of::<libc::sockaddr_un>() as libc::socklen_t;
+    // SAFETY: a is a filled sockaddr_un of len bytes.
+    if unsafe { libc::connect(fd.as_raw_fd(), (&raw const a).cast(), len) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let tv = libc::timeval { tv_sec: 0, tv_usec: SEND_WAIT.as_micros() as libc::suseconds_t };
+    let n = size_of::<libc::timeval>() as libc::socklen_t;
+    // SAFETY: tv is a timeval of n bytes. A send the GUI takes nothing of for this long fails
+    unsafe { libc::setsockopt(fd.as_raw_fd(), libc::SOL_SOCKET, libc::SO_SNDTIMEO, (&raw const tv).cast(), n) };
+    Ok(fd)
+}
+
+fn send(fd: &OwnedFd, m: &[u8]) -> io::Result<()> {
+    // SAFETY: m is m.len() readable bytes. A packet goes whole or not at all
+    match unsafe { libc::send(fd.as_raw_fd(), m.as_ptr().cast(), m.len(), libc::MSG_NOSIGNAL) } {
+        n if n < 0 => Err(io::Error::last_os_error()),
+        _ => Ok(()),
+    }
+}
+
+struct Tx {
+    fd: Option<Arc<OwnedFd>>,
+    on: bool,
+    held: Vec<i16>,
+    closed: bool,
+}
+
+struct Rx {
+    pcm: VecDeque<i16>,
+    up: Resampler,
+    heard: Option<Instant>,
+}
+
+struct Link {
+    path: String,
+    tx: Mutex<Tx>,
+    rx: Mutex<Rx>,
+    ready: Condvar,
+    keyed: AtomicBool,
+    stop: AtomicBool,
+}
+
+impl Link {
+    fn new(path: &str) -> Self {
+        let up = Resampler::new(f64::from(GUI_RATE), f64::from(RATE)).expect("the GUI's rate");
+        Self {
+            path: path.into(),
+            tx: Mutex::new(Tx { fd: None, on: false, held: Vec::new(), closed: false }),
+            rx: Mutex::new(Rx { pcm: VecDeque::new(), up, heard: None }),
+            ready: Condvar::new(),
+            keyed: AtomicBool::new(false),
+            stop: AtomicBool::new(false),
+        }
+    }
+
+    fn gone(&self, t: &mut Tx, why: &str) {
+        if let Some(fd) = t.fd.take() {
+            // SAFETY: fd is open; the reader's poll and recv on it end
+            unsafe { libc::shutdown(fd.as_raw_fd(), libc::SHUT_RDWR) };
+            say!("the GUI's socket closed: {why}");
+        }
+        (t.on, t.held) = (false, Vec::new());
+        self.keyed.store(false, Ordering::SeqCst);
+    }
+
+    fn send(&self, t: &mut Tx, m: &[u8]) -> bool {
+        let Some(fd) = &t.fd else { return false };
+        match send(fd, m) {
+            Ok(()) => true,
+            Err(e) => {
+                let why = match e.kind() {
+                    io::ErrorKind::WouldBlock => "the GUI took nothing for 0.5 s".to_string(),
+                    _ => e.to_string(),
+                };
+                self.gone(t, &why);
+                false
+            }
+        }
+    }
+
+    fn audio(&self, t: &mut Tx, s: &[i16]) {
+        for c in s.chunks(T_MAX) {
+            if !self.send(t, &message(b'T', 0, c)) {
+                return;
+            }
+        }
+    }
+
+    fn key(&self, on: bool) {
+        let t = &mut *lock(&self.tx);
+        if on && !t.on && !t.closed && self.send(t, &message(b'P', 1, &[])) {
+            t.on = true;
+            self.keyed.store(true, Ordering::SeqCst);
+            let held = std::mem::take(&mut t.held);
+            self.audio(t, &held);
+        } else if !on {
+            if t.on {
+                self.send(t, &message(b'P', 0, &[]));
+            }
+            (t.on, t.held) = (false, Vec::new());
+            self.keyed.store(false, Ordering::SeqCst);
+        }
+    }
+
+    fn receive(&self, m: &[u8]) {
+        let n = match m {
+            [b'R', _, a, b, ..] => usize::from(u16::from_ne_bytes([*a, *b])),
+            _ => return,
+        };
+        if m.len() != HDR + 2 * n {
+            return;
+        }
+        let x: Vec<f64> = m[HDR..].chunks_exact(2).map(|c| sample(i16::from_ne_bytes([c[0], c[1]]))).collect();
+        let mut rx = lock(&self.rx);
+        let up = rx.up.process(&x);
+        rx.pcm.extend(up.into_iter().map(quantize));
+        rx.heard = Some(Instant::now());
+        if rx.pcm.len() > KEEP {
+            let n = rx.pcm.len() - KEEP_AFTER_DROP;
+            rx.pcm.drain(..n);
+        }
+        self.ready.notify_all();
+    }
+
+    fn nap(&self, d: Duration) {
+        let until = Instant::now() + d;
+        while !self.stop.load(Ordering::SeqCst) && Instant::now() < until {
+            thread::sleep(LOOK.min(until.saturating_duration_since(Instant::now())));
+        }
+    }
+
+    fn hello(&self, fd: OwnedFd) -> bool {
+        let t = &mut *lock(&self.tx);
+        if t.closed {
+            return false;
+        }
+        t.fd = Some(Arc::new(fd));
+        self.send(t, &message(b'H', PROTO, &[GUI_RATE as i16, KEY_S]))
+    }
+
+    fn run(&self) {
+        let (mut said, mut buf, mut next) = (false, vec![0u8; HDR + 2 * T_MAX], Instant::now());
+        while !self.stop.load(Ordering::SeqCst) {
+            let fd = lock(&self.tx).fd.clone();
+            let Some(fd) = fd else {
+                // Once a second at most, also after a GUI that closed at once or another modem that took the socket
+                self.nap(next.saturating_duration_since(Instant::now()));
+                if self.stop.load(Ordering::SeqCst) {
+                    break;
+                }
+                next = Instant::now() + RETRY;
+                match connect(&self.path).map(|fd| self.hello(fd)) {
+                    Ok(true) => {
+                        say!("connected to the GUI's socket {}", self.path);
+                        said = false;
+                    }
+                    Ok(false) => {}
+                    Err(e) => {
+                        if !said {
+                            say!("the GUI's socket {} is not there yet ({e}), trying again every second", self.path);
+                        }
+                        said = true;
+                    }
+                }
+                continue;
+            };
+            let mut p = libc::pollfd { fd: fd.as_raw_fd(), events: libc::POLLIN, revents: 0 };
+            // SAFETY: p is one valid pollfd.
+            if unsafe { libc::poll(&mut p, 1, LOOK.as_millis() as libc::c_int) } <= 0 {
+                continue;
+            }
+            for _ in 0..64 {
+                // SAFETY: buf is buf.len() writable bytes.
+                let n = unsafe { libc::recv(fd.as_raw_fd(), buf.as_mut_ptr().cast(), buf.len(), libc::MSG_DONTWAIT) };
+                let why = match n {
+                    0 => "the GUI went away".to_string(),
+                    n if n > 0 => {
+                        self.receive(&buf[..n as usize]);
+                        continue;
+                    }
+                    _ => match io::Error::last_os_error() {
+                        e if e.kind() == io::ErrorKind::Interrupted => continue,
+                        e if e.kind() == io::ErrorKind::WouldBlock => break,
+                        e => e.to_string(),
+                    },
+                };
+                let t = &mut *lock(&self.tx);
+                if t.fd.as_ref().is_some_and(|f| Arc::ptr_eq(f, &fd)) {
+                    self.gone(t, &why);
+                }
+                break;
+            }
+        }
+    }
+}
+
+struct X6x00Ptt(Arc<Link>);
+
+impl Ptt for X6x00Ptt {
+    fn set(&mut self, on: bool) -> io::Result<()> {
+        self.0.key(on);
+        Ok(())
+    }
+
+    fn describe(&self) -> String {
+        format!("the GUI's modem socket {}", self.0.path)
+    }
+}
+
+fn check_path(path: &str) -> io::Result<()> {
+    if path.starts_with('/') {
+        Ok(())
+    } else {
+        Err(io::Error::other(format!("--audio x6x00: {path:?} is not a socket path (the GUI's: {SOCKET})")))
+    }
+}
+
+pub fn check(playback: &str) -> io::Result<()> {
+    check_path(playback)
+}
+
+pub fn list() -> io::Result<(DeviceList, DeviceList)> {
+    let s = vec![(SOCKET.to_string(), "the GUI's modem socket".to_string())];
+    Ok((s.clone(), s))
+}
+
+pub struct X6x00Io {
+    link: Arc<Link>,
+    playback: bool,
+    radio: bool,
+    reader: Option<JoinHandle<()>>,
+    down: Resampler,
+    last: Option<Instant>,
+    x: Vec<f64>,
+}
+
+impl X6x00Io {
+    pub fn open(capture: &str, playback: &str, radio: bool) -> io::Result<Self> {
+        if capture != playback {
+            return Err(io::Error::other("--audio x6x00: --capture and --playback must be the same socket"));
+        }
+        Self::start(capture, true, radio)
+    }
+
+    pub fn open_capture(capture: &str) -> io::Result<Self> {
+        Self::start(capture, false, false)
+    }
+
+    fn start(path: &str, playback: bool, radio: bool) -> io::Result<Self> {
+        check_path(path)?;
+        let link = Arc::new(Link::new(path));
+        let l = link.clone();
+        let reader = Some(thread::Builder::new().name("x6x00".into()).spawn(move || l.run())?);
+        let down = Resampler::new(f64::from(RATE), f64::from(GUI_RATE)).expect("the GUI's rate");
+        Ok(Self { link, playback, radio, reader, down, last: None, x: Vec::new() })
+    }
+}
+
+impl Audio for X6x00Io {
+    fn read(&mut self, x: &mut [i16]) -> io::Result<()> {
+        let block = Duration::from_secs_f64(x.len() as f64 / f64::from(RATE));
+        let due = self.last.map_or_else(Instant::now, |t| t + block);
+        let idle = !self.link.keyed.load(Ordering::SeqCst);
+        let mut rx = lock(&self.link.rx);
+        loop {
+            if rx.pcm.len() >= x.len() {
+                break;
+            }
+            let now = Instant::now();
+            let streaming = idle && rx.heard.is_some_and(|t| now.duration_since(t) < STREAMING);
+            let until = if streaming { due + JITTER } else { due };
+            let Some(left) = until.checked_duration_since(now).filter(|d| !d.is_zero()) else { break };
+            rx = self.link.ready.wait_timeout(rx, left).unwrap_or_else(PoisonError::into_inner).0;
+        }
+        let n = rx.pcm.len().min(x.len());
+        for (o, s) in x.iter_mut().zip(rx.pcm.drain(..n).chain(std::iter::repeat(0))) {
+            *o = s;
+        }
+        drop(rx);
+        let now = Instant::now();
+        self.last = Some(if n == x.len() || now > due + STREAMING { now } else { due });
+        Ok(())
+    }
+
+    fn write(&mut self, x: &[i16]) -> io::Result<()> {
+        if !self.playback {
+            return Err(capture_only());
+        }
+        if !self.radio {
+            return Ok(());
+        }
+        self.x.clear();
+        self.x.extend(x.iter().map(|&v| sample(v)));
+        let s: Vec<i16> = self.down.process(&self.x).into_iter().map(quantize).collect();
+        let l = &self.link;
+        let t = &mut *lock(&l.tx);
+        if t.on {
+            l.audio(t, &s);
+        } else if !t.closed && (!t.held.is_empty() || s.iter().any(|&v| v != 0)) {
+            t.held.extend_from_slice(&s);
+            let over = t.held.len().saturating_sub(HELD_MAX);
+            t.held.drain(..over);
+        }
+        Ok(())
+    }
+
+    fn queued(&mut self) -> io::Result<Option<Queue>> {
+        if !self.playback {
+            return Err(capture_only());
+        }
+        Ok(None)
+    }
+
+    fn backlog(&mut self) -> io::Result<Option<usize>> {
+        Ok(Some(lock(&self.link.rx).pcm.len()))
+    }
+
+    fn path(&mut self) -> io::Result<Path> {
+        let [capture, keying, out] = *lock(&PATH);
+        let ms = |n: usize| n * (RATE / 1000) as usize;
+        let tx = |n: usize| if self.radio { ms(n) } else { 0 };
+        Ok(Path { capture: Some(ms(capture)), keying: tx(keying), out: tx(out), queue: false })
+    }
+
+    fn ptt(&self) -> Option<Box<dyn Ptt>> {
+        self.radio.then(|| Box::new(X6x00Ptt(self.link.clone())) as Box<dyn Ptt>)
+    }
+}
+
+impl Drop for X6x00Io {
+    fn drop(&mut self) {
+        self.link.key(false);
+        {
+            let t = &mut *lock(&self.link.tx);
+            t.closed = true;
+            if let Some(fd) = t.fd.take() {
+                // SAFETY: fd is open; the GUI sees XARA go now, not when the PTT's copy of the link goes
+                unsafe { libc::shutdown(fd.as_raw_fd(), libc::SHUT_RDWR) };
+            }
+        }
+        self.link.stop.store(true, Ordering::SeqCst);
+        if let Some(r) = self.reader.take() {
+            let _ = r.join();
+        }
+    }
+}
