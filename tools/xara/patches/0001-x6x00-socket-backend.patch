+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::audio::BLOCK;
+
+    // The GUI's side of the socket: it listens, takes one modem, and reads and sends whole messages
+    struct Gui {
+        path: String,
+        listen: OwnedFd,
+        conn: Option<OwnedFd>,
+    }
+
+    fn sockaddr(path: &str) -> libc::sockaddr_un {
+        // SAFETY: plain data, zeros a valid value.
+        let mut a: libc::sockaddr_un = unsafe { std::mem::zeroed() };
+        a.sun_family = libc::AF_UNIX as libc::sa_family_t;
+        a.sun_path.iter_mut().zip(path.bytes()).for_each(|(d, s)| *d = s as libc::c_char);
+        a
+    }
+
+    fn ready(fd: &OwnedFd, d: Duration) -> bool {
+        let mut p = libc::pollfd { fd: fd.as_raw_fd(), events: libc::POLLIN, revents: 0 };
+        // SAFETY: one valid pollfd.
+        unsafe { libc::poll(&mut p, 1, d.as_millis() as libc::c_int) > 0 }
+    }
+
+    impl Gui {
+        fn new(name: &str) -> Self {
+            let path = std::env::temp_dir().join(format!("xara-x6x00-{name}-{}.sock", std::process::id()));
+            let path = path.to_string_lossy().into_owned();
+            let _ = std::fs::remove_file(&path);
+            let a = sockaddr(&path);
+            // SAFETY: a new socket bound to a and listening, or a test failure.
+            let listen = unsafe {
+                let fd = libc::socket(libc::AF_UNIX, libc::SOCK_SEQPACKET | libc::SOCK_CLOEXEC, 0);
+                assert!(fd >= 0);
+                let n = size_of::<libc::sockaddr_un>() as libc::socklen_t;
+                assert_eq!(libc::bind(fd, (&raw const a).cast(), n), 0);
+                assert_eq!(libc::listen(fd, 2), 0);
+                OwnedFd::from_raw_fd(fd)
+            };
+            Self { path, listen, conn: None }
+        }
+
+        fn accept(&mut self, d: Duration) -> bool {
+            if !ready(&self.listen, d) {
+                return false;
+            }
+            // SAFETY: listen is a listening socket; the result a new fd or -1.
+            let fd = unsafe { libc::accept4(self.listen.as_raw_fd(), std::ptr::null_mut(), std::ptr::null_mut(), 0) };
+            assert!(fd >= 0);
+            // SAFETY: a new fd, ours.
+            self.conn = Some(unsafe { OwnedFd::from_raw_fd(fd) });
+            true
+        }
+
+        fn take(&self, d: Duration) -> Option<(u8, u8, Vec<i16>)> {
+            let c = self.conn.as_ref()?;
+            if !ready(c, d) {
+                return None;
+            }
+            let mut buf = [0u8; HDR + 2 * T_MAX];
+            // SAFETY: buf is buf.len() writable bytes.
+            let n = unsafe { libc::recv(c.as_raw_fd(), buf.as_mut_ptr().cast(), buf.len(), 0) };
+            if n < HDR as isize {
+                return None;
+            }
+            let k = usize::from(u16::from_ne_bytes([buf[2], buf[3]]));
+            assert_eq!(n as usize, HDR + 2 * k, "a message of its length");
+            let s = buf[HDR..n as usize].chunks_exact(2).map(|c| i16::from_ne_bytes([c[0], c[1]])).collect();
+            Some((buf[0], buf[1], s))
+        }
+
+        fn all(&self, d: Duration) -> Vec<(u8, u8, Vec<i16>)> {
+            std::iter::from_fn(|| self.take(d)).collect()
+        }
+
+        fn rx(&self, s: &[i16]) {
+            send(self.conn.as_ref().unwrap(), &message(b'R', 0, s)).unwrap();
+        }
+    }
+
+    impl Drop for Gui {
+        fn drop(&mut self) {
+            let _ = std::fs::remove_file(&self.path);
+        }
+    }
+
+    const SOON: Duration = Duration::from_millis(50);
+    const WAIT: Duration = Duration::from_secs(2);
+
+    fn tone(n: usize, hz: f64, rate: f64, at: usize) -> Vec<i16> {
+        (at..at + n).map(|i| (8000.0 * (2.0 * std::f64::consts::PI * hz * i as f64 / rate).sin()) as i16).collect()
+    }
+
+    fn connected(name: &str) -> (Gui, X6x00Io, Box<dyn Ptt>) {
+        let mut gui = Gui::new(name);
+        let io = X6x00Io::open(&gui.path, &gui.path, true).unwrap();
+        assert!(gui.accept(WAIT), "XARA connects");
+        let ptt = io.ptt().unwrap();
+        (gui, io, ptt)
+    }
+
+    #[test]
+    fn each_connection_says_hello_in_protocol_2() {
+        let (gui, _io, _ptt) = connected("hello");
+        assert_eq!(gui.take(WAIT), Some((b'H', 2, vec![12000, 30])), "12000 Hz, keys of 30 s at most");
+        assert_eq!(gui.take(SOON), None);
+    }
+
+    #[test]
+    fn the_receiver_comes_up_to_48_khz_and_paces_the_reads() {
+        let (gui, mut io, _ptt) = connected("rx");
+        gui.take(WAIT);
+        let mut x = [0i16; BLOCK];
+        let (mut got, t) = (Vec::new(), Instant::now());
+        for k in 0..25 {
+            gui.rx(&tone(240, 1000.0, 12000.0, 240 * k));
+            thread::sleep(Duration::from_millis(20));
+            while io.backlog().unwrap().unwrap() >= BLOCK {
+                io.read(&mut x).unwrap();
+                got.extend_from_slice(&x);
+            }
+        }
+        assert!(t.elapsed() < Duration::from_millis(900), "{:?}", t.elapsed());
+        assert_eq!(got.len(), 25 * 960 / BLOCK * BLOCK - BLOCK, "960 samples for each 20 ms R, one block left");
+        let at = |i: usize| f64::from(got[i]) / 8000.0;
+        // 1 kHz at 48 kHz: 48 samples a cycle, the level kept
+        let peak = got[2000..].iter().map(|&s| s.unsigned_abs()).max().unwrap();
+        assert!((7600..=8400).contains(&peak), "{peak}");
+        let crossings = (2000..got.len() - 1).filter(|&i| at(i) < 0.0 && at(i + 1) >= 0.0).count();
+        let cycles = (got.len() - 2001) as f64 / 48.0;
+        assert!((crossings as f64 - cycles).abs() <= 2.0, "{crossings} for {cycles:.0}");
+        // a read with nothing come waits for the next R: streaming, the GUI is a little late now and then
+        let t = Instant::now();
+        let late = thread::spawn(move || {
+            thread::sleep(Duration::from_millis(40));
+            gui.rx(&tone(240, 1000.0, 12000.0, 0));
+            gui
+        });
+        io.read(&mut x).unwrap();
+        io.read(&mut x).unwrap();
+        assert!(t.elapsed() >= Duration::from_millis(35) && x.iter().any(|&s| s != 0), "{:?}", t.elapsed());
+        drop(late.join().unwrap());
+    }
+
+    #[test]
+    fn without_the_gui_the_reads_keep_the_wall_clock() {
+        let gui = Gui::new("none");
+        let path = gui.path.clone();
+        drop(gui);
+        let mut io = X6x00Io::open(&path, &path, true).unwrap();
+        let mut x = [1i16; BLOCK];
+        let t = Instant::now();
+        for _ in 0..20 {
+            io.read(&mut x).unwrap();
+        }
+        let took = t.elapsed();
+        assert!(x.iter().all(|&s| s == 0));
+        assert!(took >= Duration::from_millis(190) && took < Duration::from_millis(300), "{took:?}");
+        let mut ptt = io.ptt().unwrap();
+        ptt.set(true).unwrap();
+        io.write(&tone(BLOCK, 1500.0, 48000.0, 0)).unwrap();
+        ptt.set(false).unwrap();
+    }
+
+    #[test]
+    fn audio_goes_out_only_between_p1_and_p0() {
+        let (gui, mut io, mut ptt) = connected("tx");
+        gui.take(WAIT);
+        let (quiet, loud) = ([0i16; BLOCK], tone(BLOCK, 1500.0, 48000.0, 0));
+        io.write(&quiet).unwrap();
+        assert_eq!(gui.take(SOON), None, "nothing unkeyed");
+        // XARA's pump writes the first block of a key before its PTT thread keys: held, then sent after P 1
+        io.write(&loud).unwrap();
+        assert_eq!(gui.take(SOON), None);
+        ptt.set(true).unwrap();
+        let m = gui.all(SOON);
+        assert_eq!((m[0].0, m[0].1, m[0].2.len()), (b'P', 1, 0));
+        assert!(m[1..].iter().all(|(k, _, _)| *k == b'T'));
+        let held: usize = m[1..].iter().map(|(_, _, s)| s.len()).sum();
+        assert!((100..=BLOCK / 4).contains(&held), "the block before the key, at 12 kHz: {held}");
+        for _ in 0..10 {
+            io.write(&loud).unwrap();
+        }
+        let m = gui.all(SOON);
+        assert!(m.iter().all(|(k, _, s)| *k == b'T' && s.len() <= T_MAX));
+        let sent: Vec<i16> = m.into_iter().flat_map(|(_, _, s)| s).collect();
+        assert!((1150..=1200).contains(&sent.len()), "100 ms at 12 kHz: {}", sent.len());
+        let peak = sent[200..].iter().map(|&s| s.unsigned_abs()).max().unwrap();
+        assert!((7600..=8400).contains(&peak), "{peak}");
+        io.write(&quiet).unwrap();
+        assert!(gui.all(SOON).iter().all(|(k, _, _)| *k == b'T'), "silence while keyed goes too");
+        ptt.set(false).unwrap();
+        assert_eq!(gui.all(SOON), vec![(b'P', 0, vec![])]);
+        io.write(&quiet).unwrap();
+        assert_eq!(gui.take(SOON), None, "nothing after P 0");
+        // a key whose PTT never came: its audio is not sent with the next one
+        io.write(&loud).unwrap();
+        ptt.set(false).unwrap();
+        ptt.set(true).unwrap();
+        assert_eq!(gui.all(SOON), vec![(b'P', 1, vec![])]);
+        ptt.release().unwrap();
+        assert_eq!(gui.all(SOON), vec![(b'P', 0, vec![])]);
+    }
+
+    #[test]
+    fn the_receiver_stops_counting_as_a_stream_while_keyed() {
+        let (gui, mut io, mut ptt) = connected("keyed");
+        gui.take(WAIT);
+        gui.rx(&tone(240, 1000.0, 12000.0, 0));
+        thread::sleep(SOON);
+        let mut x = [0i16; BLOCK];
+        io.read(&mut x).unwrap();
+        io.read(&mut x).unwrap();
+        ptt.set(true).unwrap();
+        // no R comes while the radio transmits: zeros at the wall clock's pace, no wait for R
+        let t = Instant::now();
+        for _ in 0..10 {
+            io.read(&mut x).unwrap();
+        }
+        assert!(x.iter().all(|&s| s == 0));
+        assert!(t.elapsed() < Duration::from_millis(160), "{:?}", t.elapsed());
+        ptt.set(false).unwrap();
+    }
+
+    #[test]
+    fn a_gui_that_goes_is_connected_again_and_a_key_goes_nowhere() {
+        let (mut gui, mut io, mut ptt) = connected("again");
+        gui.take(WAIT);
+        ptt.set(true).unwrap();
+        assert_eq!(gui.take(WAIT).map(|m| m.0), Some(b'P'));
+        gui.conn = None;
+        thread::sleep(Duration::from_millis(200));
+        io.write(&tone(BLOCK, 1500.0, 48000.0, 0)).unwrap();
+        assert!(gui.accept(Duration::from_millis(1500)), "connected again within a second or so");
+        assert_eq!(gui.take(WAIT), Some((b'H', 2, vec![12000, 30])));
+        io.write(&tone(BLOCK, 1500.0, 48000.0, 0)).unwrap();
+        assert_eq!(gui.take(SOON), None, "the rest of a key cut by the GUI is not sent to the next connection");
+        ptt.set(false).unwrap();
+        assert_eq!(gui.take(SOON), None, "and no P 0 without its P 1");
+        ptt.set(true).unwrap();
+        assert_eq!(gui.take(WAIT), Some((b'P', 1, vec![])), "the next key goes out");
+        drop(ptt);
+        drop(io);
+        assert_eq!(gui.take(WAIT), Some((b'P', 0, vec![])), "XARA stopping unkeys");
+        assert_eq!(gui.take(SOON), None);
+        let c = gui.conn.as_ref().unwrap();
+        let mut b = [0u8; 8];
+        // SAFETY: b is 8 writable bytes.
+        assert_eq!(unsafe { libc::recv(c.as_raw_fd(), b.as_mut_ptr().cast(), 8, libc::MSG_DONTWAIT) }, 0, "and closes");
+    }
+
+    #[test]
+    fn a_gui_that_closes_at_once_is_tried_once_a_second() {
+        let mut gui = Gui::new("closes");
+        let _io = X6x00Io::open(&gui.path, &gui.path, true).unwrap();
+        let (t, mut tries) = (Instant::now(), 0);
+        while t.elapsed() < Duration::from_millis(2500) {
+            if gui.accept(Duration::from_millis(50)) {
+                tries += 1;
+                gui.conn = None;
+            }
+        }
+        assert!((2..=4).contains(&tries), "{tries} connections in 2.5 s");
+    }
+
+    #[test]
+    fn a_path_takes_the_constants_and_x6x00_needs_one_socket() {
+        let gui = Gui::new("path");
+        let mut io = X6x00Io::open(&gui.path, &gui.path, true).unwrap();
+        let p = io.path().unwrap();
+        let ms = |n: usize| n * 48;
+        assert_eq!(p, Path { capture: Some(ms(25)), keying: ms(50), out: ms(80), queue: false });
+        let mut rx = X6x00Io::open_capture(&gui.path).unwrap();
+        assert_eq!(rx.path().unwrap(), Path { capture: Some(ms(25)), keying: 0, out: 0, queue: false });
+        assert!(rx.write(&[0; BLOCK]).is_err() && rx.ptt().is_none());
+        assert!(X6x00Io::open(&gui.path, "/run/other.sock", true).is_err());
+        assert!(X6x00Io::open("ardop.sock", "ardop.sock", true).is_err());
+    }
+}
