+        // SAFETY: b is 8 writable bytes.
+        assert_eq!(unsafe { libc::recv(c.as_raw_fd(), b.as_mut_ptr().cast(), 8, libc::MSG_DONTWAIT) }, 0, "and closes");
+    }
+
+    #[test]
+    fn a_gui_that_closes_at_once_is_tried_once_a_second() {
+        let mut gui = Gui::new("closes");
+        let _io = X6x00Io::open(&gui.path, &gui.path, true).unwrap();
+        let (t, mut tries) = (Instant::now(), 0);
+        while t.elapsed() < Duration::from_millis(2500) {
+            if gui.accept(Duration::from_millis(50)) {
+                tries += 1;
+                gui.conn = None;
+            }
+        }
+        assert!((2..=4).contains(&tries), "{tries} connections in 2.5 s");
+    }
+
+    #[test]
+    fn the_latency_takes_the_constants_and_x6x00_needs_one_socket() {
+        let gui = Gui::new("path");
+        let io = X6x00Io::open(&gui.path, &gui.path, true).unwrap();
+        assert_eq!((io.latency(), io.capture_latency()), (155 * 48, 25 * 48), "25 + 50 + 80 ms, the capture's 25");
+        let mut rx = X6x00Io::open_capture(&gui.path).unwrap();
+        assert_eq!((rx.latency(), rx.capture_latency()), (25 * 48, 25 * 48));
+        assert!(rx.write(&[0; BLOCK]).is_err() && rx.ptt().is_none());
+        assert!(X6x00Io::open(&gui.path, "/run/other.sock", true).is_err());
+        assert!(X6x00Io::open("ardop.sock", "ardop.sock", true).is_err());
+    }
+
+    fn reports(ms: &[usize]) -> Vec<usize> {
+        let (mut b, k) = (Behind::new(), RATE as usize / 1000);
+        ms.iter().filter_map(|&m| b.over(m * k)).map(|n| n / k).collect()
+    }
+
+    #[test]
+    fn a_capture_backlog_is_said_at_doubling_thresholds() {
+        assert_eq!(reports(&[0, 10, 21, 99, 0]), Vec::<usize>::new());
+        assert_eq!(
+            reports(&[0, 100, 150, 199, 0, 100, 200, 390, 400, 0, 1000, 1500, 1600]),
+            [100, 200, 400, 1000, 1600]
+        );
+        assert_eq!(reports(&[10, 180, 199]), [180]);
+        // one there at the start only once it has drained or grown
+        assert_eq!(reports(&[300, 250, 150, 100, 60, 0, 120]), [120]);
+        assert_eq!(reports(&[300, 250, 150, 99, 100]), [100]);
+        assert_eq!(reports(&[300, 320, 390, 400, 420, 800]), [400, 800]);
+    }
+
+    // R k at 12 kHz: a level of its own (a step the resampler brings up to 48 kHz as it is), to tell them apart
+    fn level(k: usize) -> Vec<i16> {
+        vec![(100 * (k % 300)) as i16; 240]
+    }
+
+    // The GUI's side in a thread of its own: at each 20 ms tick from t0 the R of `plan` (their numbers), none, or
+    // several at once
+    fn feed(gui: Gui, plan: Vec<Vec<usize>>, t0: Instant) -> JoinHandle<Gui> {
+        thread::spawn(move || {
+            for (i, rs) in plan.into_iter().enumerate() {
+                let at = t0 + Duration::from_millis(20 * i as u64);
+                thread::sleep(at.saturating_duration_since(Instant::now()));
+                rs.into_iter().for_each(|k| gui.rx(&level(k)));
+            }
+            gui
+        })
+    }
+
+    // Reads at the block's pace until `ms` after t0: what was read, the capture never waiting beyond a block and an
+    // R or two
+    fn listen(io: &mut X6x00Io, t0: Instant, ms: u64) -> Vec<i16> {
+        let (mut got, mut x) = (Vec::new(), [0i16; BLOCK]);
+        while Instant::now() < t0 + Duration::from_millis(ms) {
+            io.read(&mut x).unwrap();
+            got.extend_from_slice(&x);
+            assert!(io.backlog() <= BLOCK + 3 * R48, "{} waiting", io.backlog());
+        }
+        got
+    }
+
+    impl X6x00Io {
+        // what Late holds: the silence owed and the late audio dropped, in samples
+        fn late(&self) -> (usize, usize) {
+            let rx = lock(&self.link.rx);
+            (rx.late.owed, rx.late.dropped)
+        }
+    }
+
+    fn levels(x: &[i16]) -> std::collections::BTreeSet<usize> {
+        x.iter().filter(|&&s| s != 0 && s % 100 == 0).map(|&s| s as usize / 100).collect()
+    }
+
+    #[test]
+    fn late_audio_after_silence_goes_and_xaras_clock_keeps_the_air() {
+        let (gui, mut io, _ptt) = connected("late");
+        gui.take(WAIT);
+        // R 1-15 from 0 ms, the GUI stalled 600 ms, at 900 ms the 30 R it held at once with the one due then
+        // (16-46), and on from R 47 at 920 ms
+        let mut plan: Vec<Vec<usize>> = (1..=15).map(|k| vec![k]).collect();
+        plan.extend(std::iter::repeat_n(vec![], 30));
+        plan.push((16..=46).collect());
+        plan.extend((47..=80).map(|k| vec![k]));
+        let t0 = Instant::now();
+        let gui = feed(gui, plan, t0);
+        let before = listen(&mut io, t0, 300);
+        let quiet = listen(&mut io, t0, 800);
+        assert!(quiet.iter().rev().take(30 * BLOCK).all(|&s| s == 0), "silence in place of the audio");
+        assert!(io.late().0 >= 300 * 48, "{}", io.late().0);
+        let mut after = listen(&mut io, t0, 960);
+        let dropped = io.late().1;
+        after.extend(listen(&mut io, t0, 1300));
+        drop(gui.join().unwrap());
+        // of the late R, the newest one or two read and a block now and then as they came, at the wall clock's
+        // pace; the rest went, as much as there was silence
+        assert!(dropped >= 25 * 960, "{dropped} dropped");
+        let read = after.iter().filter(|&&s| (1600..=4600).contains(&s)).count();
+        assert!(read <= 2 * 960 + 2 * BLOCK && levels(&before).contains(&14), "{read} of it read");
+        // and XARA's clock the air's: 1.3 s read in 1.3 s, less what waits and the resampler's delay
+        let all = before.len() + quiet.len() + after.len();
+        assert!(all.abs_diff(1300 * 48) <= 60 * 48, "{} ms read", all / 48);
+        assert!((47..=62).all(|k| levels(&after).contains(&k)), "the stream on time: {:?}", levels(&after));
+        assert_eq!(io.late(), (0, 0), "said once the window has passed");
+        assert_eq!(io.behind.report, BEHIND, "and not as falling behind");
+    }
+
+    #[test]
+    fn a_gui_that_comes_back_on_time_loses_nothing() {
+        let (gui, mut io, _ptt) = connected("ontime");
+        gui.take(WAIT);
+        // R 1-15, 500 ms without, then R 16 on at 800 ms, each on time
+        let mut plan: Vec<Vec<usize>> = (1..=15).map(|k| vec![k]).collect();
+        plan.extend(std::iter::repeat_n(vec![], 25));
+        plan.extend((16..=50).map(|k| vec![k]));
+        let t0 = Instant::now();
+        let gui = feed(gui, plan, t0);
+        listen(&mut io, t0, 750);
+        let after = listen(&mut io, t0, 1300);
+        drop(gui.join().unwrap());
+        assert!((16..=38).all(|k| levels(&after).contains(&k)), "every R after the pause: {:?}", levels(&after));
+        assert_eq!(io.late(), (0, 0));
+    }
+
+    #[test]
+    fn our_own_key_is_not_late_audio() {
+        let (gui, mut io, mut ptt) = connected("ownkey");
+        gui.take(WAIT);
+        // R 1-10, none while keyed (200-600 ms) and for the GUI's turn back, then R 11 on from 760 ms
+        let mut plan: Vec<Vec<usize>> = (1..=10).map(|k| vec![k]).collect();
+        plan.extend(std::iter::repeat_n(vec![], 28));
+        plan.extend((11..=40).map(|k| vec![k]));
+        let t0 = Instant::now();
+        let gui = feed(gui, plan, t0);
+        listen(&mut io, t0, 200);
+        ptt.set(true).unwrap();
+        listen(&mut io, t0, 600);
+        ptt.set(false).unwrap();
+        let mut after = listen(&mut io, t0, 740);
+        assert_eq!(io.late().0, 0, "the silence after our key is not owed");
+        after.extend(listen(&mut io, t0, 1100));
+        drop(gui.join().unwrap());
+        assert!((11..=25).all(|k| levels(&after).contains(&k)), "{:?}", levels(&after));
+        assert_eq!(io.late(), (0, 0));
+    }
+
+    #[test]
+    fn a_reader_that_falls_behind_is_said() {
+        let (gui, mut io, _ptt) = connected("behind");
+        gui.take(WAIT);
+        let mut x = [0i16; BLOCK];
+        gui.rx(&tone(240, 1000.0, 12000.0, 0));
+        thread::sleep(SOON);
+        io.read(&mut x).unwrap();
+        assert_eq!(io.behind.report, BEHIND, "a 20 ms block waiting: nothing said");
+        for k in 1..9 {
+            gui.rx(&tone(240, 1000.0, 12000.0, 240 * k));
+        }
+        thread::sleep(SOON);
+        io.read(&mut x).unwrap();
+        assert!(io.backlog() > BEHIND && io.backlog() < 2 * BEHIND, "{}", io.backlog());
+        assert_eq!(io.behind.report, 2 * BEHIND, "past 100 ms waiting to be read: said, next at 200 ms");
+    }
+}
