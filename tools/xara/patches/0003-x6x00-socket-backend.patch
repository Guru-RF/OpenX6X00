+/// Silence XARA heard in place of the GUI's receiver audio while listening (the GUI sent some on this connection,
+/// none came): when that audio comes after all, in a rush, as much of it as there was silence goes
+#[derive(Default)]
+struct Late {
+    owed: usize,
+    back: Option<Instant>,
+    dropped: usize,
+}
+
+impl Late {
+    /// The audio waiting, as an R comes and at each check of a read: the late part of it goes, for LATE_WINDOW
+    /// from when the audio came back
+    fn drop(&mut self, pcm: &mut VecDeque<i16>, block: usize, now: Instant) {
+        if self.owed == 0 || (pcm.is_empty() && self.back.is_none()) {
+            return;
+        }
+        if now < *self.back.get_or_insert(now) + LATE_WINDOW {
+            // More than a block and one R waiting is more than the wall clock brought: the late audio, the oldest
+            let n = pcm.len().saturating_sub(block + R48).min(self.owed);
+            pcm.drain(..n);
+            (self.owed, self.dropped) = (self.owed - n, self.dropped + n);
+        }
+    }
+
+    /// Once LATE_WINDOW has passed since the audio came back, what there was: the silence and what of it was
+    /// dropped, in samples
+    fn done(&mut self, now: Instant) -> Option<(usize, usize)> {
+        self.back.filter(|&b| now >= b + LATE_WINDOW)?;
+        let said = (self.owed + self.dropped, self.dropped);
+        *self = Self::default();
+        Some(said)
+    }
+}
+
+pub struct X6x00Io {
+    link: Arc<Link>,
+    playback: bool,
+    radio: bool,
+    reader: Option<JoinHandle<()>>,
+    down: Resampler,
+    last: Option<Instant>,
+    x: Vec<f64>,
+    behind: Behind,
+}
+
+impl X6x00Io {
+    pub fn open(capture: &str, playback: &str, radio: bool) -> io::Result<Self> {
+        if capture != playback {
+            return Err(io::Error::other("--audio x6x00: --capture and --playback must be the same socket"));
+        }
+        Self::start(capture, true, radio)
+    }
+
+    pub fn open_capture(capture: &str) -> io::Result<Self> {
+        Self::start(capture, false, false)
+    }
+
+    fn start(path: &str, playback: bool, radio: bool) -> io::Result<Self> {
+        check_path(path)?;
+        let link = Arc::new(Link::new(path));
+        let l = link.clone();
+        let reader = Some(thread::Builder::new().name("x6x00".into()).spawn(move || l.run())?);
+        let down = Resampler::new(f64::from(RATE), f64::from(GUI_RATE)).expect("the GUI's rate");
+        Ok(Self { link, playback, radio, reader, down, last: None, x: Vec::new(), behind: Behind::new() })
+    }
+
+    /// The capture waiting to be read, at 48 kHz
+    pub fn backlog(&self) -> usize {
+        lock(&self.link.rx).pcm.len()
+    }
+}
+
+impl Audio for X6x00Io {
+    fn read(&mut self, x: &mut [i16]) -> io::Result<()> {
+        let block = Duration::from_secs_f64(x.len() as f64 / f64::from(RATE));
+        let due = self.last.map_or_else(Instant::now, |t| t + block);
+        let idle = !self.link.keyed.load(Ordering::SeqCst);
+        let mut rx = lock(&self.link.rx);
+        if !idle {
+            // Our own key: no R comes by design, and its silence, nor the GUI's turn back to the receiver, is
+            // late audio. Listening again from its first R
+            (rx.late, rx.heard) = (Late::default(), None);
+        }
+        rx.block = x.len();
+        let mut late = None;
+        loop {
+            let now = Instant::now();
+            let r = &mut *rx;
+            r.late.drop(&mut r.pcm, r.block, now);
+            late = late.or_else(|| r.late.done(now));
+            // While the late audio comes and goes, the reads keep the wall clock, not its rush
+            let (enough, rush) = (r.pcm.len() >= x.len(), r.late.back.is_some());
+            if enough && (!rush || now >= due) {
+                break;
+            }
+            let streaming = idle && rx.heard.is_some_and(|t| now.duration_since(t) < STREAMING);
+            let until = if streaming && !enough { due + JITTER } else { due };
+            let Some(left) = until.checked_duration_since(now).filter(|d| !d.is_zero()) else { break };
+            rx = self.link.ready.wait_timeout(rx, left).unwrap_or_else(PoisonError::into_inner).0;
+        }
+        let n = rx.pcm.len().min(x.len());
+        for (o, s) in x.iter_mut().zip(rx.pcm.drain(..n).chain(std::iter::repeat(0))) {
+            *o = s;
+        }
+        if n < x.len() && idle && rx.heard.is_some() {
+            rx.late.owed += x.len() - n;
+        }
+        let left = rx.pcm.len();
+        drop(rx);
+        let now = Instant::now();
+        self.last = Some(if n == x.len() || now > due + STREAMING { now } else { due });
+        if let Some((silence, dropped)) = late {
+            say!(
+                "audio: no receiver audio from the GUI for {} ms (XARA heard silence in its place){}",
+                silence * 1000 / RATE as usize,
+                match dropped {
+                    0 => String::new(),
+                    d => format!("; {} ms of it came late, all at once, and was dropped", d * 1000 / RATE as usize),
+                }
+            );
+        }
+        if let Some(n) = self.behind.over(left) {
+            say!(
+                "audio: {} ms of capture waiting to be read (xara is falling behind real time: CPU overload?)",
+                n * 1000 / RATE as usize
+            );
+        }
+        Ok(())
+    }
+
+    fn write(&mut self, x: &[i16]) -> io::Result<()> {
+        if !self.playback {
+            return Err(capture_only());
+        }
+        if !self.radio {
+            return Ok(());
+        }
+        self.x.clear();
+        self.x.extend(x.iter().map(|&v| sample(v)));
+        let s: Vec<i16> = self.down.process(&self.x).into_iter().map(quantize).collect();
+        let l = &self.link;
+        let t = &mut *lock(&l.tx);
+        if t.on {
+            l.audio(t, &s);
+        } else if !t.closed && (!t.held.is_empty() || s.iter().any(|&v| v != 0)) {
+            t.held.extend_from_slice(&s);
+            let over = t.held.len().saturating_sub(HELD_MAX);
+            t.held.drain(..over);
+        }
+        Ok(())
+    }
+
+    fn latency(&self) -> usize {
+        let [capture, keying, out] = *lock(&PATH);
+        ms(capture) + if self.radio { ms(keying) + ms(out) } else { 0 }
+    }
+
+    fn capture_latency(&self) -> usize {
+        ms(lock(&PATH)[0])
+    }
+
+    fn ptt(&self) -> Option<Box<dyn Ptt>> {
+        self.radio.then(|| Box::new(X6x00Ptt(self.link.clone())) as Box<dyn Ptt>)
+    }
+}
+
+impl Drop for X6x00Io {
+    fn drop(&mut self) {
+        self.link.key(false);
+        {
+            let t = &mut *lock(&self.link.tx);
+            t.closed = true;
+            if let Some(fd) = t.fd.take() {
+                // SAFETY: fd is open; the GUI sees XARA go now, not when the PTT's copy of the link goes
+                unsafe { libc::shutdown(fd.as_raw_fd(), libc::SHUT_RDWR) };
+            }
+        }
+        self.link.stop.store(true, Ordering::SeqCst);
+        if let Some(r) = self.reader.take() {
+            let _ = r.join();
+        }
+    }
+}
