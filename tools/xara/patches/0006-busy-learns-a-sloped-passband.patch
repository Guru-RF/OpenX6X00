+
+fn plus(a: &[f64], b: &[f64]) -> Vec<f64> {
+    a.iter().zip(b).map(|(x, y)| x + y).collect()
+}
+
+#[test]
+fn a_passband_that_trips_the_unwhitened_detector_reads_clear_after_the_warm_up() {
+    // A receiver whose noise climbs 15-23 dB across the 2300 Hz tone band (a radio's passband, a
+    // dummy load on the antenna) trips the unwhitened detector block after block, so BUSY came on at
+    // once and, the shape being learned only while BUSY is off, never went off. The first blocks give
+    // the shape now: clear within the warm-up (2.7 s) and the hang (1.45 s), and it stays clear
+    for (bw, slope) in [(Bandwidth::Hz2300, 1.0), (Bandwidth::Hz2300, 1.5), (Bandwidth::Hz2750, 1.5)] {
+        let mut r = Rng::new(41);
+        let mut b = Busy::new(bw);
+        let x = sloped_noise(&mut r, 1 << 20, db(-35.0), slope);
+        let edges = run(&mut b, &x);
+        assert_eq!(edges.iter().map(|e| e.1).collect::<Vec<_>>(), [true, false], "{slope}: {edges:?}");
+        let off = edges[1].0 as f64 / 48000.0;
+        assert!(off < 5.0, "{slope}: clear after {off:.2} s");
+        assert_eq!(b.shape(), (true, true), "{slope}: the shape from the warm-up");
+        let hits = b.hits;
+        run(&mut b, &sloped_noise(&mut r, 1 << 20, db(-35.0), slope));
+        assert_eq!(b.hits, hits, "{slope}: the noise alone trips it again");
+        // and a carrier on that noise still trips it, at once
+        let n = 1 << 16;
+        let edges = run(&mut b, &plus(&sloped_noise(&mut r, n, db(-35.0), slope), &tone(n, 1400.0, db(-25.0))));
+        assert!(edges.first().is_some_and(|e| e.1 && e.0 < 3 * BLOCK48), "{slope}: {edges:?}");
+        assert!(matches!(b.why(), Why::Tone { hz, learned: true } if (hz - 1400.0).abs() < 24.0), "{:?}", b.why());
+    }
+}
+
+#[test]
+fn a_carrier_there_from_the_start_is_not_taken_for_the_passband() {
+    // The warm-up keeps no block with a carrier in it (the plain FFT's skirts would carry it past the
+    // whitening's median over 7 bins): BUSY stays on while it is there, and clears once it has gone
+    let mut r = Rng::new(43);
+    let mut b = Busy::new(Bandwidth::Hz2300);
+    let n = 1 << 19;
+    let edges = run(&mut b, &plus(&sloped_noise(&mut r, n, db(-35.0), 1.5), &tone(n, 1400.0, db(-25.0))));
+    assert!(edges.len() == 1 && edges[0].1 && edges[0].0 <= BLOCK48 + 960, "on at the first block, not off: {edges:?}");
+    assert!(b.shape() == (false, false) && b.hits[0] > 200, "{:?} {:?}", b.shape(), b.hits);
+    let edges = run(&mut b, &sloped_noise(&mut r, n, db(-35.0), 1.5));
+    assert!(edges == [(edges[0].0, false)] && edges[0].0 < 5 * 48000, "clear within 5 s of its end: {edges:?}");
+}
+
+#[test]
+fn a_signal_there_half_the_time_at_the_start_is_not_taken_for_the_passband() {
+    // A wide signal with no carrier in it (a hump of noise 20 dB over the floor, 300 Hz across) on for
+    // 1 s, off for 1 s from the start, then gone: each bin's lower quartile is the receiver's, so after
+    // the warm-up the signal still trips the detector each time it comes, and once it has gone BUSY
+    // clears
+    let mut r = Rng::new(47);
+    let n = 1 << 19;
+    let floor = sloped_noise(&mut r, n, db(-35.0), 1.0);
+    let hump = {
+        use num_complex::Complex64;
+        let mut spec: Vec<Complex64> = (0..n)
+            .map(|k| {
+                let hz = 48000.0 * k.min(n - k) as f64 / n as f64;
+                Complex64::new(r.gauss(), r.gauss()) * (-((hz - 1350.0) / 130.0).powi(2) / 2.0).exp()
+            })
+            .collect();
+        rustfft::FftPlanner::new().plan_fft_inverse(n).process(&mut spec);
+        let x: Vec<f64> = spec.iter().map(|c| c.re).collect();
+        let rms = (x.iter().map(|v| v * v).sum::<f64>() / n as f64).sqrt();
+        // 20 dB over the floor's power in its 300 Hz, about (the floor's share of its own there)
+        let at = db(-35.0) * db(20.0) * (300.0 / 2900.0f64).sqrt();
+        let on = |i: usize| i < 8 * 48000 && (i / 48000) % 2 == 0;
+        x.iter().enumerate().map(|(i, v)| if on(i) { v * at / rms } else { 0.0 }).collect::<Vec<_>>()
+    };
+    let x = plus(&floor, &hump);
+    let mut b = Busy::new(Bandwidth::Hz2300);
+    run(&mut b, &x[..4 * 48000]);
+    assert_eq!(b.shape(), (true, true));
+    let hits = b.hits[0];
+    // 4-6 s: on 4-5 s, off 5-6 s
+    run(&mut b, &x[4 * 48000..6 * 48000]);
+    assert!(b.hits[0] > hits + 10 && b.is_on(), "the signal went unseen after the warm-up: {:?}", b.hits);
+    let edges = run(&mut b, &x[6 * 48000..]);
+    let off = edges.last().filter(|e| !e.1).map(|e| e.0 as f64 / 48000.0 + 6.0);
+    assert!(off.is_some_and(|t| (8.0..9.6).contains(&t)), "clear once it has gone: {edges:?}");
+}
+
+#[test]
+fn a_vara_link_there_from_the_start_is_not_taken_for_the_passband() {
+    // Frames of a link on the sloped passband for its first 6 s: BUSY on with them, and once they have
+    // gone clear within a few seconds, and clear after: the shape is the receiver's, not the link's
+    let mut rng = Rng::new(2);
+    let mut rand = |n: u32| rng.below(n);
+    for record in [3, 5, 8].map(|r| Record::new(r).unwrap()) {
+        let bw = Bandwidth::Hz2300;
+        let m = Modulator::new(bw);
+        let len = bw.level(record).frame_bytes() as usize;
+        let frame: Vec<u8> = (0..len).map(|i| (i * 37 + 11) as u8).collect();
+        let mut link = Vec::new();
+        while link.len() < 6 * 48000 {
+            let x = m.transmission(record, &[&frame], &mut rand);
+            let rms = (x.iter().map(|v| v * v).sum::<f64>() / x.len() as f64).sqrt();
+            link.extend(x.iter().map(|v| v / rms * db(-30.0)));
+            link.extend(std::iter::repeat_n(0.0, 4800));
+        }
+        link.truncate(6 * 48000);
+        let mut r = Rng::new(9);
+        let floor = sloped_noise(&mut r, 1 << 19, db(-35.0), 1.0);
+        let mut b = Busy::new(bw);
+        let edges = run(&mut b, &plus(&floor[..link.len()], &link));
+        assert!(b.is_on() && b.hits[1] > 0, "L{record} {edges:?} {:?}", b.hits);
+        let edges = run(&mut b, &floor[link.len()..]);
+        let off = edges.first().filter(|e| !e.1).map(|e| e.0 as f64 / 48000.0);
+        assert!(edges.len() == 1 && off.is_some_and(|t| t < 5.0), "L{record}: {edges:?} {:?}", b.shape());
+    }
+}
