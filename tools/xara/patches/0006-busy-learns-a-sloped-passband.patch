     }
 
+    /// Whether the block has a carrier in the tone band (NARROW_RATIO)
+    fn narrow_peak(&self) -> bool {
+        let n = self.block.len();
+        let mut b: Vec<Complex64> = self
+            .block
+            .iter()
+            .enumerate()
+            .map(|(i, z)| z * (0.5 - 0.5 * (std::f64::consts::TAU * i as f64 / n as f64).cos()))
+            .collect();
+        self.fft128.process(&mut b);
+        let p = |k: usize| b[k].norm_sqr();
+        let (lo, hi, _) = tone_band(self.bw);
+        let k = (lo..=hi).max_by(|&a, &c| p(a).total_cmp(&p(c))).unwrap_or(lo);
+        let mut ring: Vec<f64> = (NARROW_NEAR..=NARROW_FAR)
+            .flat_map(|d| [k.checked_sub(d), Some(k + d).filter(|&j| j < n)])
+            .flatten()
+            .map(p)
+            .collect();
+        ring.sort_by(f64::total_cmp);
+        p(k) > NARROW_RATIO * ring[NARROW_RANK]
+    }
+
+    /// Where the strongest bin of the tone band is, in Hz of the audio
+    fn peak_hz(&self, q: &[f64; 128]) -> f64 {
+        let (lo, hi, _) = tone_band(self.bw);
+        let k = (lo..=hi).max_by(|&a, &b| q[a].total_cmp(&q[b])).unwrap_or(lo);
+        k as f64 * TONE_BIN_HZ
+    }
+
+    /// The first blocks, kept whatever the detector said, give the shape if the clear ones did not
+    /// (WARM_QUANTILE)
+    fn warm_up(&mut self, p: &[f64; 128], keep: bool) {
+        if self.shape_blocks >= SHAPE_WARMUP {
+            self.warm = Vec::new();
+            return;
+        }
+        if keep {
+            self.warm.push(std::array::from_fn(|k| p[k].max(1e-30).ln()));
+        }
+        if self.warm.len() < SHAPE_WARMUP as usize {
+            return;
+        }
+        let mut col = vec![0.0; self.warm.len()];
+        for k in 0..128 {
+            col.iter_mut().zip(&self.warm).for_each(|(c, w)| *c = w[k]);
+            col.select_nth_unstable_by(WARM_QUANTILE, f64::total_cmp);
+            self.shape[k] = col[WARM_QUANTILE] + WARM_BIAS;
+        }
+        self.shape_blocks = SHAPE_WARMUP;
+        self.warm = Vec::new();
+        self.warmed = true;
+    }
+
     fn signature_hit(&mut self) -> bool {
         let mut buf: [Complex64; 64] = std::array::from_fn(|i| self.last64[i]);
         self.fft64.process(&mut buf);
@@ -286,6 +397,13 @@ impl Busy {
             }
         }
         let threshold = signature_threshold(self.bw);
-        self.sigs.iter().any(|g| detect_signature(&s, g, threshold))
+        match self.sigs.iter().find(|g| detect_signature(&s, g, threshold)) {
+            Some(g) => {
+                self.signature_seen = true;
+                self.why = Why::Signature(g.record);
+                true
+            }
+            None => false,
+        }
     }
 }
