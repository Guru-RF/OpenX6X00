             let a = if self.shape_blocks == 0 { 1.0 } else { SHAPE_ALPHA.max(1.0 / f64::from(self.shape_blocks + 1)) };
@@ -263,9 +318,65 @@ impl Busy {
             }
             self.shape_blocks = self.shape_blocks.saturating_add(1);
         }
+        // Not a block only the VU's hang lets through (a dropout), nor one with a signal of its own
+        // (a signature, a carrier, our own key or link)
+        self.warm_up(&p, peak_db > VU_GATE_DBFS && !signal);
