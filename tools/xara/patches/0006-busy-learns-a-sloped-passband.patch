+
+/// What tripped the BUSY detector, for the log
+fn busy_why(w: Why) -> String {
+    match w {
+        Why::Tone { hz, learned: true } => format!("busy: a tone at {hz:.0} Hz"),
+        Why::Tone { hz, learned: false } => format!("busy: a tone at {hz:.0} Hz (the noise shape not learned yet)"),
+        Why::Signature(r) => format!("busy: a VARA signal (level {})", r.get()),
+        Why::None => "busy".into(),
+    }
+}
