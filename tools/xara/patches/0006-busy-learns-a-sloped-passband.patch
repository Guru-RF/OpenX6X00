+    /// ln(power) of the first blocks, for the shape when the clear ones do not teach it (WARM_QUANTILE)
+    warm: Vec<[f64; 128]>,
+    /// A signature hit since the last tone block: that block is a signal's, not the receiver's
+    signature_seen: bool,
+    /// The shape was taken from the first blocks (WARM_QUANTILE), not learned from clear ones
+    warmed: bool,
+    why: Why,
     pub hits: [u32; 2],
 }
 
+/// What tripped the detector last
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Why {
+    None,
+    /// The strongest bin, and whether the receiver's noise shape was divided out
+    Tone { hz: f64, learned: bool },
+    Signature(Record),
+}
