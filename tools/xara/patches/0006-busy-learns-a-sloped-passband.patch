@@ -16,8 +16,29 @@ const SHAPE_ALPHA: f64 = 1.0 / 64.0;
 /// Each bin's noise is taken as the median of this many bins around it, so a slope or hump
 /// in the radio's passband is learned but a carrier, a bin or two wide, is not.
 const SHAPE_SPAN: usize = 7;
+/// Until the shape is learned, "clear" is the unwhitened detector's word, and a passband that
+/// slopes or rolls off inside the tone band trips it block after block: BUSY comes on at once and
+/// stays on, as nothing is learned while it is on. So the first SHAPE_WARMUP blocks over the VU gate
+/// are kept whatever that detector says, but not one with a signal of its own: a signature hit (VARA)
+/// or a carrier (NARROW_RATIO). If the clear ones have not taught the shape by then, it is taken from
+/// those: each bin's lower quartile, which a signal there less than three quarters of the time does
+/// not reach.
+const WARM_QUANTILE: usize = SHAPE_WARMUP as usize / 4;
+/// A carrier, for the warm-up: the strongest bin 20 dB over the third quietest of the bins
+/// NARROW_NEAR to NARROW_FAR from it on either side, in a Hann window's spectrum (the plain FFT's
+/// skirts make a strong carrier many bins wide, and the quietest bins are the noise between an FSK
+/// burst's sidelobes). A slope or roll-off of the passband is not that steep.
+const NARROW_RATIO: f64 = 100.0;
+const NARROW_NEAR: usize = 3;
+const NARROW_FAR: usize = 8;
+const NARROW_RANK: usize = 2;
+/// A bin of noise has exponential power: the lower quartile of its ln lies this far under the
+/// mean of its ln, which is what the shape holds (-ln(-ln 0.75) - Euler's gamma).
+const WARM_BIAS: f64 = 0.668_686_8;
 const ROWS: usize = 20;
 const FULL_SCALE: f64 = 32767.0;
+/// A bin of the tone FFT: 128 over the front end's 3 kHz, bin k at k of these Hz of the audio
+const TONE_BIN_HZ: f64 = crate::ofdm::FS / 16.0 / 128.0;
 
 pub fn tone_band(bw: Bandwidth) -> (usize, usize, usize) {
