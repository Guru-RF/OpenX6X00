@@ -0,0 +1,68 @@
+mod common;
+
+use common::air::{BLOCK, FS, Rng};
+use xara::station::hf::Station;
+use xara::station::{Modem, Options, Report};
+use xara_arq::hf::session::Config;
+use xara_phy::hf::level::Bandwidth;
+
+/// Noise through a receiver whose passband rolls off: two one-pole low-passes at 300 Hz, some 25 dB down from
+/// 500 Hz to 2500 Hz, which the BUSY detector's tone test takes for a tone before it knows the passband
+fn rolled_off(r: &mut Rng, n: usize, rms: f64) -> Vec<f64> {
+    let a = (-2.0 * std::f64::consts::PI * 300.0 / FS).exp();
+    let (mut y1, mut y2) = (0.0, 0.0);
+    let x: Vec<f64> = (0..n)
+        .map(|_| {
+            y1 = a * y1 + (1.0 - a) * r.gauss();
+            y2 = a * y2 + (1.0 - a) * y1;
+            y2
+        })
+        .collect();
+    let now = (x.iter().map(|v| v * v).sum::<f64>() / n as f64).sqrt();
+    x.iter().map(|v| v * rms / now).collect()
+}
+
+// The station fed x block by block from sample t: its reports, each with the time it came at
+fn feed(st: &mut Station, x: &[f64], t: &mut usize) -> Vec<(f64, Report)> {
+    let mut out = vec![0.0; BLOCK];
+    let mut got = Vec::new();
+    for b in x.chunks(BLOCK) {
+        st.process(b, &mut out[..b.len()]);
+        *t += b.len();
+        got.extend(std::iter::from_fn(|| st.pop()).map(|r| (*t as f64 / FS, r)));
+    }
+    got
+}
+
+fn trace(r: &Report) -> Option<&str> {
+    match r {
+        Report::Trace(t) => Some(t),
+        _ => None,
+    }
+}
+
+#[test]
+fn busy_says_why_and_a_rolled_off_passband_reads_clear_in_seconds() {
+    let mut st = Station::new(Config::new(Bandwidth::Hz2300, "N0CALL"), Options::default());
+    let (mut r, mut t) = (Rng(0x5eed), 0);
+    let quiet = feed(&mut st, &rolled_off(&mut r, 6 * FS as usize, 0.03), &mut t);
+    let busy: Vec<_> = quiet.iter().filter(|(_, r)| matches!(r, Report::Busy(_))).collect();
+    // on from the start, for a tone the detector sees in the passband, then clear once the shape is taken
+    assert!(matches!(busy[..], [(_, Report::Busy(true)), (off, Report::Busy(false))] if *off < 5.0), "{quiet:?}");
+    let on = quiet.iter().position(|(_, r)| *r == Report::Busy(true)).unwrap();
+    let why = trace(&quiet[on - 1].1).unwrap();
+    assert!(why.starts_with("busy: a tone at ") && why.ends_with("Hz (the noise shape not learned yet)"), "{why}");
+    let took = quiet.iter().position(|(_, r)| trace(r).is_some_and(|t| t.contains("noise shape taken"))).unwrap();
+    assert!(took < quiet.len() - 1 && quiet[took..].iter().any(|(_, r)| *r == Report::Busy(false)), "{quiet:?}");
+    // a carrier at 1400 Hz: busy, and the log says where
+    let mut x = rolled_off(&mut r, FS as usize, 0.03);
+    for (i, v) in x.iter_mut().enumerate() {
+        *v += 0.01 * (2.0 * std::f64::consts::PI * 1400.0 * i as f64 / FS).sin();
+    }
+    let carrier = feed(&mut st, &x, &mut t);
+    let on = carrier.iter().position(|(_, r)| *r == Report::Busy(true)).expect("busy on the carrier");
+    assert!(carrier[on].0 < 6.2, "{:?}", carrier[on]);
+    let why = trace(&carrier[on - 1].1).unwrap();
+    let hz: f64 = why.strip_prefix("busy: a tone at ").and_then(|w| w.strip_suffix(" Hz")).unwrap().parse().unwrap();
+    assert!((hz - 1400.0).abs() < 30.0, "{why}");
+}
