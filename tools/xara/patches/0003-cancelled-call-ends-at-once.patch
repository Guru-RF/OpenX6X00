+#[test]
+fn a_cancelled_call_ends_at_once() {
+    let cancelled = |cwid: &str, on_air: bool| {
+        let mut lab = Lab::new(1);
+        let mut c = lab.attach(0);
+        lab.settle();
+        for l in ["MYCALL XX0A", "BW2300", "RETRIES 5", cwid] {
+            assert_eq!(ask(&mut lab, &mut c, format!("{l}\r").as_bytes(), 1), ["OK"], "{l}");
+        }
+        let start = c.len();
+        c.send("CONNECT XX0A N1CALL");
+        let cl = c.lines.clone();
+        let first = if on_air { "PTT ON" } else { "PTT OFF" };
+        assert!(lab.run_until(5.0, |_| cl.lock().unwrap()[start..].iter().any(|l| l == first)));
+        let (t0, n) = (lab.now(), c.len());
+        c.send("DISCONNECT");
+        let mut after: Vec<(String, f64)> = Vec::new();
+        while !after.iter().any(|(l, _)| l == "DISCONNECTED") {
+            let seen = n + after.len();
+            assert!(lab.run_until(10.0, |_| cl.lock().unwrap().len() > seen), "{:?}", c.since(start));
+            let t = lab.now() - t0;
+            after.extend(c.since(seen).into_iter().map(|l| (l, t)));
+        }
+        let at = |w: &str| after.iter().find(|(l, _)| l == w).map_or(f64::NAN, |(_, t)| *t);
+        let keys = c.since(start).iter().filter(|l| *l == "PTT ON").count();
+        (at("PTT ON"), at("PTT OFF"), at("DISCONNECTED"), keys)
+    };
+    let (on, off, gone, keys) = cancelled("CWID ON", false);
+    assert!(on < 0.2 && off > 2.0 && gone >= off && keys == 2, "{on} {off} {gone} {keys}");
+    let (on, off, gone, keys) = cancelled("CWID ON", true);
+    assert!(on.is_nan() && off > 3.0 && gone >= off && keys == 1, "{on} {off} {gone} {keys}");
+    let (on, off, gone, keys) = cancelled("CWID OFF", false);
+    assert!(on.is_nan() && off.is_nan() && gone < 0.2 && keys == 1, "{on} {off} {gone} {keys}");
+    let (on, off, gone, keys) = cancelled("CWID OFF", true);
+    assert!(on.is_nan() && off < 2.5 && gone >= off && keys == 1, "{on} {off} {gone} {keys}");
+}
