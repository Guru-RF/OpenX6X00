# OpenX6X00 - XARA's own tests with our patches (patches/), on this PC: build.sh --test unpacks the pinned source,
# applies them and runs cargo test with the pinned Rust, from $HOME/.cache/openx6x00 (downloaded there the first
# time, as for build.sh --host; offline from then on)
test:
	bash build.sh --test

.PHONY: test
