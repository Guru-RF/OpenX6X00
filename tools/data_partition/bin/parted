#!/bin/bash
# The real parted on the card file, its name in the output the device's
. "$(dirname "$0")/../lib.sh"
callog "parted $*"
args=()
for a in "$@"; do
    [ "$a" = "$DEVP" ] && a=$CARD
    args+=("$a")
done
out=$(/usr/bin/parted "${args[@]}" 2>&1)
rc=$?
[ -n "$out" ] && printf '%s\n' "$out" | sed "s|$CARD|$DEVP|g"
exit $rc
